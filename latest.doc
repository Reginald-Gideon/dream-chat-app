  position: relative;
  flex: 1;
  min-width: 0;
}

.tabbar-badge {
  position: absolute;
  top: 0;
  right: calc(50% - 21px);
  min-width: 17px;
  height: 17px;
  padding: 0 4px;
  border: 2px solid #18181b;
}
