app.get('/api/unread-counts', authMiddleware, async (req, res) => \{\line
  try \{\line
    const [messages, notifications] = await Promise.all([\line
      pool.query(\line
        `SELECT COUNT(*)::int AS count\line
         FROM messages m\line
         JOIN conversations c ON c.id = m.conversation_id\line
         WHERE m.read_at IS NULL\line
           AND m.user_id != $1\line
           AND (c.user_one_id = $1 OR c.user_two_id = $1)`,\line
        [req.userId]\line
      ),\line
      pool.query(\line
        `SELECT COUNT(*)::int AS count\line
         FROM notifications\line
         WHERE user_id = $1 AND read = FALSE`,\line
        [req.userId]\line
      ),\line
    ]);\line
\line
    res.json(\{\line
      messages: messages.rows[0].count,\line
      notifications: notifications.rows[0].count,\line
    \});\line
  \} catch (err) \{\line
    console.error('Get unread counts error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
//notifications\line
app.get('/api/notifications', authMiddleware, async (req, res) => \{\line
  try \{\line
    const result = await pool.query(\line
      `SELECT n.id, n.type, n.read, n.created_at, n.post_id,\line
              u.id AS actor_id, u.username AS actor_username, u.avatar AS actor_avatar\line
       FROM notifications n\line
       JOIN users u ON n.actor_id = u.id\line
       WHERE n.user_id = $1\line
       ORDER BY n.created_at DESC\line
       LIMIT 50`,\line
      [req.userId]\line
    );\line
    res.json(result.rows);\line
  \} catch (err) \{\line
    console.error('Get notifications error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
app.patch('/api/notifications/read', authMiddleware, async (req, res) => \{\line
  try \{\line
    await pool.query(`UPDATE notifications SET read = TRUE WHERE user_id = $1 AND read = FALSE`, [req.userId]);\line
    io.to(`user:$\{req.userId\}`).emit('notificationsChanged');\line
    res.status(200).json(\{ message: 'Marked all as read.' \});\line
  \} catch (err) \{\line
    console.error('Mark notifications read error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
app.patch('/api/notifications/:notificationId/read', authMiddleware, async (req, res) => \{\line
  try \{\line
    const result = await pool.query(\line
      `UPDATE notifications\line
       SET read = TRUE\line
       WHERE id = $1 AND user_id = $2\line
       RETURNING id`,\line
      [req.params.notificationId, req.userId]\line
    );\line
    if (result.rows.length === 0) \{\line
      return res.status(404).json(\{ message: 'Notification not found.' \});\line
    \}\line
    io.to(`user:$\{req.userId\}`).emit('notificationsChanged');\line
    res.status(200).json(\{ message: 'Notification marked as read.' \});\line
  \} catch (err) \{\line
    console.error('Mark notification read error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
// --- SOCKET.IO SETUP ---\line
\line
const server = http.createServer(app);\line
const io = new Server(server, \{\line
  cors: \{ origin: '*' \},\line
\});\line
\line
const onlineUsers = new Map();\line
\line
// --- VIDEO CALL BOOKKEEPING ---\line
// userId -> \{ peerId, callerId, socketId \} while a call is ringing or connected.\line
// Both people in a call get an entry, so we can tell "busy" and block fake events.\line
const callState = new Map();\line
\line
// Remove both sides of a call. Returns the other person's id (or null).\line
function clearCall(userId) \{\line
  const st = callState.get(userId);\line
  if (!st) return null;\line
  callState.delete(userId);\line
  callState.delete(st.peerId);\line
  return st.peerId;\line
\}\line
\line
// Seconds -> "02:35" (or "1:02:35" for long calls)\line
function formatDuration(totalSeconds) \{\line
  const s = Math.max(0, Math.floor(totalSeconds));\line
  const hours = Math.floor(s / 3600);\line
  const minutes = Math.floor((s % 3600) / 60);\line
  const seconds = s % 60;\line
  const mm = String(minutes).padStart(2, '0');\line
  const ss = String(seconds).padStart(2, '0');\line
  return hours ? `$\{hours\}:$\{mm\}:$\{ss\}` : `$\{mm\}:$\{ss\}`;\line
\}\line
\line
// Save a "call log" message in the chat so both people see what happened.\line
// outcome: 'completed' (with seconds), 'declined', or 'missed'\line
async function logCall(callerId, calleeId, outcome, seconds = 0) \{\line
  try \{\line
    const [userOneId, userTwoId] = orderUserIds(Number(callerId), Number(calleeId));\line
    const convo = await pool.query(\line
      'SELECT id FROM conversations WHERE user_one_id = $1 AND user_two_id = $2',\line
      [userOneId, userTwoId]\line
    );\line
    if (convo.rows.length === 0) return;\line
    const conversationId = convo.rows[0].id;\line
\line
    let content = 'Missed video call';\line
    if (outcome === 'completed') content = `Video call \u183? $\{formatDuration(seconds)\}`;\line
    if (outcome === 'declined') content = 'Video call declined';\line
\line
    // A missed call stays "unread" for the person who missed it.\line
    // Calls that were answered or declined were already seen by both people.\line
    const alreadySeen = outcome !== 'missed';\line
    const inserted = await pool.query(\line
      `INSERT INTO messages (content, user_id, conversation_id, read_at)\line
       VALUES ($1, $2, $3, CASE WHEN $4::boolean THEN NOW() ELSE NULL END)\line
       RETURNING id, content, created_at, read_at, reply_to_id`,\line
      [content, callerId, conversationId, alreadySeen]\line
    );\line
    const caller = await pool.query('SELECT username, avatar FROM users WHERE id = $1', [callerId]);\line
\line
    io.to(`conversation:$\{conversationId\}`).emit('newMessage', \{\line
      ...inserted.rows[0],\line
      username: caller.rows[0].username,\line
      avatar: caller.rows[0].avatar,\line
      user_id: callerId,\line
      conversationId: Number(conversationId),\line
    \});\line
    // refresh both people's chat lists and unread badges\line
    io.to(`user:$\{callerId\}`).emit('unreadMessagesChanged');\line
    io.to(`user:$\{calleeId\}`).emit('unreadMessagesChanged');\line
  \} catch (err) \{\line
    console.error('logCall error:', err);\line
  \}\line
\}\line
\line
io.use((socket, next) => \{\line
  const token = socket.handshake.auth.token;\line
  if (!token) \{\line
    return next(new Error('No token provided'));\line
  \}\line
  try \{\line
    const decoded = jwt.verify(token, process.env.JWT_SECRET);\line
    socket.userId = decoded.userId;\line
    next();\line
  \} catch (err) \{\line
    next(new Error('Invalid token'));\line
  \}\line
\});\line
\line
io.on('connection', (socket) => \{\line
  const userId = socket.userId;\line
  console.log('New connection, userId:', userId);\line
\line
  const count = onlineUsers.get(userId) || 0;\line
  onlineUsers.set(userId, count + 1);\line
\line
  if (count === 0) \{\line
    io.emit('userOnline', userId);\line
  \}\line
\line
  socket.emit('onlineUsers', Array.from(onlineUsers.keys()));\line
\line
  socket.on('joinConversation', (conversationId) => \{\line
    socket.join(`conversation:$\{conversationId\}`);\line
  \});\line
socket.join(`user:$\{userId\}`);\line
  socket.on('disconnect', () => \{\line
    // If the tab that was IN a call closes, tell the other person.\line
    const st = callState.get(userId);\line
    if (st && st.socketId === socket.id) \{\line
      const callerId = st.callerId;\line
      const calleeId = callerId === userId ? st.peerId : userId;\line
      const peerId = clearCall(userId);\line
      io.to(`user:$\{peerId\}`).emit('call:ended', \{ fromUserId: userId \});\line
      if (st.acceptedAt) logCall(callerId, calleeId, 'completed', (Date.now() - st.acceptedAt) / 1000);\line
      else logCall(callerId, calleeId, 'missed');\line
    \}\line
    const current = onlineUsers.get(userId) || 1;\line
    if (current <= 1) \{\line
      onlineUsers.delete(userId);\line
      io.emit('userOffline', userId);\line
    \} else \{\line
      onlineUsers.set(userId, current - 1);\line
    \}\line
  \});\line
  socket.on('joinGroup', (groupId) => \{\line
  socket.join(`group:$\{groupId\}`);\line
\});\line
socket.on('typing', (\{ conversationId, groupId \}) => \{\line
  const room = conversationId ? `conversation:$\{conversationId\}` : `group:$\{groupId\}`;\line
  socket.to(room).emit('userTyping', \{ userId: socket.userId, conversationId, groupId \});\line
\});\line
\line
socket.on('stopTyping', (\{ conversationId, groupId \}) => \{\line
  const room = conversationId ? `conversation:$\{conversationId\}` : `group:$\{groupId\}`;\line
  socket.to(room).emit('userStoppedTyping', \{ userId: socket.userId, conversationId, groupId \});\line
\});\line
\line
  // ===== VIDEO CALL SIGNALLING =====\line
  // The server never touches video. It only passes small "introduction" messages\line
  // between two browsers so they can connect directly to each other.\line
\line
  // Caller rings someone\line
  socket.on('call:invite', async (\{ toUserId \}) => \{\line
    toUserId = Number(toUserId);\line
    console.log('[call] invite received from', userId, 'to', toUserId);\line
    if (!toUserId || toUserId === userId) return;\line
    try \{\line
      const friendship = await pool.query(\line
        `SELECT 1 FROM friendships\line
         WHERE ((requester_id = $1 AND addressee_id = $2) OR (requester_id = $2 AND addressee_id = $1))\line
           AND status = 'accepted'`,\line
        [userId, toUserId]\line
      );\line
      if (friendship.rows.length === 0) \{\line
        console.log('[call] blocked: not friends');\line
        return socket.emit('call:unavailable', \{ reason: 'not-friends' \});\line
      \}\line
      if (!onlineUsers.has(toUserId)) \{\line
        console.log('[call] blocked: callee has no open socket');\line
        return socket.emit('call:unavailable', \{ reason: 'offline' \});\line
      \}\line
      if (callState.has(userId) || callState.has(toUserId)) \{\line
        console.log('[call] blocked: someone is busy');\line
        return socket.emit('call:busy');\line
      \}\line
      // (no await between the check above and these two lines, so two people\line
      //  calling each other at the same instant can't both get through)\line
      callState.set(userId, \{ peerId: toUserId, callerId: userId, socketId: socket.id \});\line
      callState.set(toUserId, \{ peerId: userId, callerId: userId, socketId: null \});\line
\line
      const me = await pool.query('SELECT username, avatar FROM users WHERE id = $1', [userId]);\line
      console.log('[call] ringing user', toUserId);\line
      io.to(`user:$\{toUserId\}`).emit('call:incoming', \{\line
        fromUserId: userId,\line
        fromUsername: me.rows[0].username,\line
        fromAvatar: me.rows[0].avatar,\line
      \});\line
    \} catch (err) \{\line
      console.error('call:invite error:', err);\line
    \}\line
  \});\line
\line
  // Callee picks up\line
  socket.on('call:accept', (\{ toUserId \}) => \{\line
    toUserId = Number(toUserId);\line
    const st = callState.get(userId);\line
    if (!st || st.callerId !== toUserId) return; // only the person being called can accept\line
    st.socketId = socket.id;\line
    st.acceptedAt = Date.now(); // the call clock starts now (both people's entries)\line
    const callerEntry = callState.get(toUserId);\line
    if (callerEntry) callerEntry.acceptedAt = st.acceptedAt;\line
    socket.to(`user:$\{userId\}`).emit('call:handledElsewhere'); // stop ringing in my other tabs\line
    io.to(`user:$\{toUserId\}`).emit('call:accepted', \{ fromUserId: userId \});\line
  \});\line
\line
  // Callee declines\line
  socket.on('call:reject', (\{ toUserId \}) => \{\line
    toUserId = Number(toUserId);\line
    const st = callState.get(userId);\line
    if (!st || st.callerId !== toUserId) return;\line
    clearCall(userId);\line
    socket.to(`user:$\{userId\}`).emit('call:handledElsewhere');\line
    io.to(`user:$\{toUserId\}`).emit('call:rejected', \{ fromUserId: userId \});\line
    logCall(st.callerId, userId, 'declined');\line
  \});\line
\line
  // Pass WebRTC "introduction" data (offer / answer / ICE candidates) to the other person\line
  socket.on('call:signal', (\{ toUserId, data \}) => \{\line
    toUserId = Number(toUserId);\line
    const st = callState.get(userId);\line
    if (!st || st.peerId !== toUserId) return;\line
    io.to(`user:$\{toUserId\}`).emit('call:signal', \{ fromUserId: userId, data \});\line
  \});\line
\line
  // Either person hangs up (or the caller gives up ringing)\line
  socket.on('call:end', (\{ toUserId \}) => \{\line
    toUserId = Number(toUserId);\line
    const st = callState.get(userId);\line
    if (!st || st.peerId !== toUserId) return;\line
    const callerId = st.callerId;\line
    const calleeId = callerId === userId ? st.peerId : userId;\line
    clearCall(userId);\line
    io.to(`user:$\{toUserId\}`).emit('call:ended', \{ fromUserId: userId \});\line
    if (st.acceptedAt) logCall(callerId, calleeId, 'completed', (Date.now() - st.acceptedAt) / 1000);\line
    else logCall(callerId, calleeId, 'missed'); // caller gave up before anyone answered\line
  \});\line
\});\line
\line
async function startServer() \{\line
  try \{\line
    await pool.query(\line
      `CREATE TABLE IF NOT EXISTS message_attachments (\line
         message_id BIGINT PRIMARY KEY REFERENCES messages(id) ON DELETE CASCADE,\line
         file_name TEXT NOT NULL,\line
         mime_type TEXT NOT NULL,\line
         file_size INTEGER NOT NULL,\line
         data BYTEA NOT NULL\line
       )`\line
    );\line
    server.listen(3001, () => \{\line
      console.log('Server is running on port 3001');\line
    \});\line
  \} catch (err) \{\line
    console.error('Failed to initialize message attachments:', err);\line
    process.exitCode = 1;\line
  \}\line
\}\line
\line
startServer();}\par\par
\b src/App.js\b0\par
{\f1\fs15\cf2 \line
import './App.css';\line
import LoginPage from './pages/LoginPage';\line
import SignupPage from './pages/SignupPage';\line
import ChatPage from './pages/ChatPage';\line
import UserListPage from './pages/NewChat';\line
import \{ Route, Routes, BrowserRouter \} from 'react-router-dom';\line
import ProtectedRoute from './pages/ProtectedRoute';\line
import Layout from './pages/Layout';\line
import InboxPage from './pages/InboxPage';\line
import RequestsPage from './pages/RequestsPage.jsx'\line
import CreateGroup from './pages/CreateGroup';\line
import GroupsPage from './pages/GroupsPage';\line
import GroupChatPage from './pages/GroupChatPage';\line
import ProfilePage from './pages/ProfilePage';\line
import SettingsPage from './pages/SettingsPage';\line
import Feed from './pages/Feed.jsx'\line
import NotificationsPage from './pages/NotificationsPage';\line
function App() \{\line
  return (\line
    <BrowserRouter>\line
     <Routes>\line
  <Route path="/" element=\{<LoginPage />\} />\line
  <Route path="/signup" element=\{<SignupPage />\} />\line
\line
  <Route element=\{<ProtectedRoute><Layout /></ProtectedRoute>\}>\line
  <Route path="/feed" element=\{<Feed/> \}/>\line
  <Route path="/notifications" element=\{<NotificationsPage />\} />\line
\line
<Route path='/settings' element=\{<SettingsPage />\} />\line
<Route path="/profile" element=\{<ProfilePage />\} />\line
<Route path="/profile/:userId" element=\{<ProfilePage />\} />\line
<Route path="/create-group" element=\{<CreateGroup />\} />\line
<Route path="/groups" element=\{<GroupsPage />\} />\line
<Route path="/group/:groupId" element=\{<GroupChatPage />\} />\line
  <Route path="/requests" element=\{<RequestsPage />\} />\line
    <Route path="/inbox" element=\{<InboxPage />\} />\line
    <Route path="/chat" element=\{<ChatPage />\} />\line
    <Route path="/new" element=\{<UserListPage />\} />\line
    <Route path="/chat/:conversationId" element=\{<ChatPage />\} />\line
  </Route>\line
</Routes>\line
    </BrowserRouter>\line
  );      \line
    \line
  \line
\}\line
\line
export default App;}\par\par
