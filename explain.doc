{\f1\fs15\cf2 import \{ useState, useEffect, useRef, useCallback \} from "react";\line
import \{ Link, useNavigate, useParams \} from "react-router-dom";\line
import \{ io \} from "socket.io-client";\line
import "../css/Chatpage.css";\line
import Avatar from "../components/Avatar";\line
import AttachmentPicker from "../components/AttachmentPicker";\line
import MessageAttachment from "../components/MessageAttachment";\line
import VoiceNoteButton from "../components/VoiceNoteButton";\line
import UserAvatarMenu from "../components/UserAvatarMenu";\line
import \{ MAX_ATTACHMENT_SIZE, readFileAsDataUrl \} from "../attachmentUtils";\line
const API_URL = "https://dream-chat-app-1.onrender.com";\line
\line
// Call log messages are saved by the server as plain text, e.g. "Video call \u183? 02:35".\line
// This turns that text into a title + detail line for the little call card.\line
function parseCallLog(content, isMine) \{\line
  if (typeof content !== "string") return null;\line
  if (content.startsWith("Video call \u183? ")) \{\line
    return \{\line
      detail: `$\{isMine ? "Outgoing" : "Incoming"\} \u183? $\{content.slice("Video call \u183? ".length)\}`,\line
      missed: false,\line
    \};\line
  \}\line
  if (content === "Missed video call") \{\line
    return \{ detail: isMine ? "No answer" : "Missed", missed: !isMine \};\line
  \}\line
  if (content === "Video call declined") \{\line
    return \{ detail: isMine ? "Declined" : "You declined", missed: false \};\line
  \}\line
  return null;\line
\}\line
\line
function formatTime(timestamp) \{\line
  const date = new Date(timestamp);\line
  return date.toLocaleTimeString([], \{ hour: "numeric", minute: "2-digit" \});\line
\}\line
\line
export default function ChatPage() \{\line
  const \{ conversationId \} = useParams();\line
  const navigate = useNavigate();\line
  const [conversations, setConversations] = useState([]);\line
  const [groups, setGroups] = useState([]);\line
  const [conversationSearch, setConversationSearch] = useState("");\line
  const [activeListTab, setActiveListTab] = useState("friends");\line
  const [showAddMenu, setShowAddMenu] = useState(false);\line
  const [sendingAttachment, setSendingAttachment] = useState(false);\line
  const [messages, setMessages] = useState([]);\line
  const [newMessage, setNewMessage] = useState("");\line
  const [error, setError] = useState("");\line
  const [editingId, setEditingId] = useState(null);\line
  const [editContent, setEditContent] = useState("");\line
  const [replyingTo, setReplyingTo] = useState(null); // \{ id, content, username \}\line
  const [otherIsTyping, setOtherIsTyping] = useState(false);\line
const typingTimeoutRef = useRef(null);\line
const socketRef = useRef(null);\line
  const bottomRef = useRef(null);\line
  const inputRef = useRef(null);\line
  const addMenuRef = useRef(null);\line
  const user = JSON.parse(localStorage.getItem("user"));\line
  const token = localStorage.getItem("token");\line
const otherMessage = messages.find((m) => m.username !== user?.username);\line
const activeConversation = conversations.find((conversation) =>\line
  String(conversation.conversation_id) === String(conversationId)\line
);\line
const otherPerson = activeConversation?.other_username || otherMessage?.username;\line
const otherAvatar = activeConversation?.other_user_avatar || otherMessage?.avatar;\line
const otherUserId = activeConversation?.other_user_id || otherMessage?.user_id;\line
\line
  useEffect(() => \{\line
    async function fetchConversations() \{\line
      try \{\line
        const response = await fetch("https://dream-chat-app-1.onrender.com/api/conversations", \{\line
          headers: \{ Authorization: `Bearer $\{token\}` \},\line
        \});\line
        if (!response.ok) return;\line
        const data = await response.json();\line
        setConversations(data);\line
      \} catch \{\line
        // Keep the chat open if the conversation list is temporarily unavailable.\line
      \}\line
    \}\line
\line
    async function fetchGroups() \{\line
      try \{\line
        const response = await fetch("https://dream-chat-app-1.onrender.com/api/groups", \{\line
          headers: \{ Authorization: "Bearer " + token \},\line
        \});\line
        if (!response.ok) return;\line
        const data = await response.json();\line
        setGroups(data);\line
        data.forEach((group) => socket.emit("joinGroup", group.id));\line
      \} catch \{\line
        // Keep the groups already loaded if the API is temporarily unavailable.\line
      \}\line
    \}\line
\line
    fetchConversations();\line
    const socket = io("https://dream-chat-app-1.onrender.com", \{ auth: \{ token \} \});\line
    socket.on("conversationCreated", fetchConversations);\line
    socket.on("unreadMessagesChanged", fetchConversations);\line
    socket.on("newGroupMessage", fetchGroups);\line
    fetchGroups();\line
    const intervalId = window.setInterval(() => \{\line
      fetchConversations();\line
      fetchGroups();\line
    \}, 15000);\line
    return () => \{\line
      window.clearInterval(intervalId);\line
      socket.disconnect();\line
    \};\line
  \}, [token]);\line
\line
  useEffect(() => \{\line
    if (!showAddMenu) return undefined;\line
\line
    function closeMenu(event) \{\line
      if (!addMenuRef.current?.contains(event.target)) \{\line
        setShowAddMenu(false);\line
      \}\line
    \}\line
    function handleMenuKey(event) \{\line
      if (event.key === "Escape") setShowAddMenu(false);\line
    \}\line
\line
    document.addEventListener("mousedown", closeMenu);\line
    document.addEventListener("keydown", handleMenuKey);\line
    return () => \{\line
      document.removeEventListener("mousedown", closeMenu);\line
      document.removeEventListener("keydown", handleMenuKey);\line
    \};\line
  \}, [showAddMenu]);\line
\line
  const markConversationRead = useCallback(async () => \{\line
    try \{\line
      const response = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/conversations/$\{conversationId\}/read`,\line
        \{\line
          method: "PATCH",\line
          headers: \{\line
            "Content-Type": "application/json",\line
            Authorization: `Bearer $\{token\}`,\line
          \},\line
        \}\line
      );\line
      if (!response.ok) return;\line
\line
      const readAt = new Date().toISOString();\line
      setMessages((current) => current.map((message) =>\line
        String(message.user_id) !== String(user.id) && !message.read_at\line
          ? \{ ...message, read_at: readAt \}\line
          : message\line
      ));\line
      const conversationsResponse = await fetch(\line
        "https://dream-chat-app-1.onrender.com/api/conversations",\line
        \{ headers: \{ Authorization: "Bearer " + token \} \}\line
      );\line
      if (conversationsResponse.ok) \{\line
        setConversations(await conversationsResponse.json());\line
      \}\line
    \} catch (err) \{\line
      console.error("Failed to mark as read:", err);\line
    \}\line
  \}, [conversationId, token, user.id]);\line
\line
  // fetch existing messages\line
  useEffect(() => \{\line
    if (!conversationId) return;\line
\line
    async function fetchMessages() \{\line
      try \{\line
        const response = await fetch(\line
          `https://dream-chat-app-1.onrender.com/api/conversations/$\{conversationId\}/messages`,\line
          \{ headers: \{ Authorization: `Bearer $\{token\}` \} \}\line
        );\line
        if (!response.ok) throw new Error("Failed to load messages.");\line
        const data = await response.json();\line
        setMessages(data);\line
        markConversationRead();\line
      \} catch (err) \{\line
        setError(err.message);\line
      \}\line
    \}\line
    fetchMessages();\line
  \}, [token, conversationId, user.id, markConversationRead]);\line
\line
  // socket connection\line
  useEffect(() => \{\line
    if (!conversationId) return;\line
\line
    const socket = io("https://dream-chat-app-1.onrender.com", \{ auth: \{ token \} \});\line
    socket.emit("joinConversation", conversationId);\line
\line
    socket.on("newMessage", (message) => \{\line
      if (message.conversationId !== Number(conversationId)) return;\line
      if (String(message.user_id) !== String(user.id)) \{\line
        markConversationRead();\line
      \}\line
      setMessages((prev) => \{\line
        const alreadyExists = prev.some((m) => m.id === message.id);\line
        if (alreadyExists) return prev;\line
        return [...prev, message];\line
      \});\line
    \});\line
\line
    socket.on("messagesRead", (\{ conversationId: readConvId, readerId \}) => \{\line
      if (readConvId !== Number(conversationId)) return;\line
      if (readerId === user.id) return;\line
\line
      setMessages((prev) =>\line
        prev.map((m) =>\line
          m.user_id === user.id && !m.read_at\line
            ? \{ ...m, read_at: new Date().toISOString() \}\line
            : m\line
        )\line
      );\line
    \});\line
\line
    socket.on("messageEdited", (updated) => \{\line
      setMessages((prev) =>\line
        prev.map((m) =>\line
          m.id === updated.id\line
            ? \{ ...m, content: updated.content, edited_at: updated.edited_at \}\line
            : m\line
        )\line
      );\line
    \});\line
\line
    socket.on("messageDeleted", (\{ id, conversationId: delConvId \}) => \{\line
      if (delConvId !== Number(conversationId)) return;\line
      setMessages((prev) => prev.filter((m) => m.id !== id));\line
    \});\line
\line
    return () => socket.disconnect();\line
  \}, [token, conversationId, user.id, markConversationRead]);\line
\line
  useEffect(() => \{\line
    bottomRef.current?.scrollIntoView(\{ behavior: "smooth" \});\line
  \}, [messages]);\line
\line
  const filteredConversations = conversations.filter((conversation) =>\line
    conversation.other_username.toLowerCase().includes(conversationSearch.toLowerCase())\line
  );\line
  const filteredGroups = groups.filter((group) =>\line
    group.name.toLowerCase().includes(conversationSearch.toLowerCase())\line
  );\line
  const filteredItems = activeListTab === "groups" ? filteredGroups : filteredConversations;\line
  const unreadMessageCount = conversations.reduce(\line
    (total, conversation) => total + (Number(conversation.unread_count) || 0),\line
    0\line
  );\line
  const unreadGroupMessageCount = groups.reduce(\line
    (total, group) => total + (Number(group.unread_count) || 0),\line
    0\line
  );\line
\line
  async function handleSend(e) \{\line
    e.preventDefault();\line
    if (!conversationId || !newMessage.trim()) return;\line
\line
    try \{\line
      const response = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/conversations/$\{conversationId\}/messages`,\line
        \{\line
          method: "POST",\line
          headers: \{\line
            "Content-Type": "application/json",\line
            Authorization: `Bearer $\{token\}`,\line
          \},\line
          body: JSON.stringify(\{\line
            content: newMessage,\line
            replyToId: replyingTo ? replyingTo.id : null,\line
          \}),\line
        \}\line
      );\line
      if (!response.ok) throw new Error("Failed to send message.");\line
      setNewMessage("");\line
      setReplyingTo(null);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
    clearTimeout(typingTimeoutRef.current);\line
socketRef.current?.emit("stopTyping", \{ conversationId: Number(conversationId) \});\line
  \}\line
\line
  async function handleAttachmentSelected(file, attachmentLabel) \{\line
    if (!conversationId || !file) return;\line
    if (file.size > MAX_ATTACHMENT_SIZE) \{\line
      setError("Attachments must be 10 MB or smaller.");\line
      return;\line
    \}\line
\line
    setError("");\line
    setSendingAttachment(true);\line
    try \{\line
      const data = await readFileAsDataUrl(file);\line
      const response = await fetch(`$\{API_URL\}/api/conversations/$\{conversationId\}/messages`, \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{\line
          content: newMessage.trim() || attachmentLabel || `\u-10179? $\{file.name\}`,\line
          replyToId: replyingTo ? replyingTo.id : null,\line
          attachment: \{ file_name: file.name, mime_type: file.type || "application/octet-stream", data \},\line
        \}),\line
      \});\line
      const result = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(result.message || "Failed to send attachment.");\line
      setNewMessage("");\line
      setReplyingTo(null);\line
    \} catch (uploadError) \{\line
      setError(uploadError.message || "Failed to send attachment.");\line
    \} finally \{\line
      setSendingAttachment(false);\line
    \}\line
  \}\line
\line
  async function handleEdit(messageId) \{\line
    if (!editContent.trim()) return;\line
    try \{\line
      const response = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/messages/$\{messageId\}`,\line
        \{\line
          method: "PATCH",\line
          headers: \{\line
            "Content-Type": "application/json",\line
            Authorization: `Bearer $\{token\}`,\line
          \},\line
          body: JSON.stringify(\{ content: editContent \}),\line
        \}\line
      );\line
      if (!response.ok) throw new Error("Failed to edit message.");\line
      setEditingId(null);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
\line
  async function handleDelete(messageId) \{\line
    if (!window.confirm("Delete this message?")) return;\line
    try \{\line
      const response = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/messages/$\{messageId\}`,\line
        \{\line
          method: "DELETE",\line
          headers: \{ Authorization: `Bearer $\{token\}` \},\line
        \}\line
      );\line
      if (!response.ok) throw new Error("Failed to delete message.");\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
useEffect(() => \{\line
  if (!conversationId) return;\line
\line
  const socket = io("https://dream-chat-app-1.onrender.com", \{ auth: \{ token \} \});\line
  socketRef.current = socket;\line
  socket.emit("joinConversation", conversationId);\line
\line
  // ...all your existing listeners (newMessage, messagesRead, messageEdited, messageDeleted) stay here...\line
\line
  socket.on("userTyping", (\{ conversationId: typingConvId \}) => \{\line
    if (typingConvId !== Number(conversationId)) return;\line
    setOtherIsTyping(true);\line
  \});\line
\line
  socket.on("userStoppedTyping", (\{ conversationId: typingConvId \}) => \{\line
    if (typingConvId !== Number(conversationId)) return;\line
    setOtherIsTyping(false);\line
  \});\line
\line
  return () => socket.disconnect();\line
  // eslint-disable-next-line react-hooks/exhaustive-deps\line
\}, [token, conversationId]);\line
  function startReply(msg) \{\line
    setReplyingTo(\{ id: msg.id, content: msg.content, username: msg.username \});\line
    inputRef.current?.focus();\line
  \}\line
  function handleTyping(e) \{\line
  setNewMessage(e.target.value);\line
\line
  if (!socketRef.current) return;\line
\line
  socketRef.current.emit("typing", \{ conversationId: Number(conversationId) \});\line
\line
  clearTimeout(typingTimeoutRef.current);\line
  typingTimeoutRef.current = setTimeout(() => \{\line
    socketRef.current.emit("stopTyping", \{ conversationId: Number(conversationId) \});\line
  \}, 2000);\line
\}\line
\line
  return (\line
    <div className=\{`chat-workspace$\{conversationId ? " has-conversation" : ""\}`\}>\line
      <aside className="chat-list-panel" aria-label="Your conversations">\line
        <header className="chat-list-panel-header">\line
          <div className="chat-list-heading">\line
            <h1>Chats</h1>\line
            <span>Stay close to your people</span>\line
          </div>\line
          <div className="chat-add-menu" ref=\{addMenuRef\}>\line
            <button\line
              type="button"\line
              onClick=\{() => setShowAddMenu((isOpen) => !isOpen)\}\line
              aria-label="Create a chat or group"\line
              aria-haspopup="menu"\line
              aria-expanded=\{showAddMenu\}\line
            >\line
              +\line
            </button>\line
            \{showAddMenu && (\line
              <div className="chat-add-menu-options" role="menu">\line
                <Link to="/new" role="menuitem" onClick=\{() => setShowAddMenu(false)\}>\line
                  New chat\line
                </Link>\line
                <Link to="/create-group" role="menuitem" onClick=\{() => setShowAddMenu(false)\}>\line
                  Create group\line
                </Link>\line
              </div>\line
            )\}\line
          </div>\line
        </header>\line
        <div className="chat-list-tabs" role="tablist" aria-label="Chat lists">\line
          <button\line
            type="button"\line
            role="tab"\line
            aria-selected=\{activeListTab === "friends"\}\line
            className=\{activeListTab === "friends" ? "active" : ""\}\line
            onClick=\{() => setActiveListTab("friends")\}\line
          >\line
            Friends \{unreadMessageCount > 0 && <span>\{unreadMessageCount > 99 ? "99+" : unreadMessageCount\}</span>\}\line
          </button>\line
          <button\line
            type="button"\line
            role="tab"\line
            aria-selected=\{activeListTab === "groups"\}\line
            className=\{activeListTab === "groups" ? "active" : ""\}\line
            onClick=\{() => setActiveListTab("groups")\}\line
          >\line
            Groups \{unreadGroupMessageCount > 0 && (\line
              <span>\{unreadGroupMessageCount > 99 ? "99+" : unreadGroupMessageCount\}</span>\line
            )\}\line
          </button>\line
        </div>\line
        <label className="chat-search">\line
          <span aria-hidden="true">\u8981?</span>\line
          <input\line
            type="search"\line
            value=\{conversationSearch\}\line
            onChange=\{(event) => setConversationSearch(event.target.value)\}\line
            placeholder=\{activeListTab === "groups" ? "Search groups" : "Search friends"\}\line
            aria-label=\{activeListTab === "groups" ? "Search groups" : "Search friends"\}\line
          />\line
        </label>\line
        <div className="chat-conversation-list">\line
          \{activeListTab === "friends" && filteredConversations.map((conversation) => \{\line
            const unreadCount = Number(conversation.unread_count) || 0;\line
            const isActive = String(conversation.conversation_id) === String(conversationId);\line
\line
            return (\line
              <div\line
                key=\{conversation.conversation_id\}\line
                className=\{`chat-conversation-row$\{isActive ? " active" : ""\}$\{unreadCount ? " unread" : ""\}`\}\line
              >\line
                <UserAvatarMenu\line
                  userId=\{conversation.other_user_id\}\line
                  src=\{conversation.other_user_avatar\}\line
                  name=\{conversation.other_username\}\line
                >\line
                  <Avatar\line
                    src=\{conversation.other_user_avatar\}\line
                    name=\{conversation.other_username\}\line
                    className="chat-list-avatar"\line
                  />\line
                </UserAvatarMenu>\line
                <button\line
                  type="button"\line
                  className="chat-conversation-main"\line
                  onClick=\{() => navigate(`/chat/$\{conversation.conversation_id\}`)\}\line
                >\line
                  <span className="chat-conversation-copy">\line
                    <span className="chat-conversation-topline">\line
                      <strong>\{conversation.other_username\}</strong>\line
                      \{conversation.last_message_at && (\line
                        <time>\{formatTime(conversation.last_message_at)\}</time>\line
                      )\}\line
                    </span>\line
                    <span className=\{`chat-conversation-preview$\{conversation.last_message_unread ? " unread" : ""\}`\}>\line
                      \{conversation.last_message || "Start a conversation"\}\line
                    </span>\line
                  </span>\line
                  \{unreadCount > 0 && (\line
                    <span className="chat-conversation-badge">\line
                      \{unreadCount > 99 ? "99+" : unreadCount\}\line
                    </span>\line
                  )\}\line
                </button>\line
              </div>\line
            );\line
          \})\}\line
          \{activeListTab === "groups" && filteredGroups.map((group) => \{\line
            const messageCount = Number(group.message_count) || 0;\line
            return (\line
              <button\line
                type="button"\line
                key=\{group.id\}\line
                className="chat-conversation-row chat-group-row"\line
                onClick=\{() => navigate(`/group/$\{group.id\}`)\}\line
              >\line
                <span className="chat-list-avatar chat-group-avatar" aria-hidden="true">\line
                  \{group.name.slice(0, 2).toUpperCase()\}\line
                </span>\line
                <span className="chat-conversation-copy">\line
                  <span className="chat-conversation-topline">\line
                    <strong>\{group.name\}</strong>\line
                    \{Number(group.unread_count) > 0 && (\line
                      <span className="chat-conversation-badge">\line
                        \{Number(group.unread_count) > 99 ? "99+" : group.unread_count\}\line
                      </span>\line
                    )\}\line
                  </span>\line
                  <span className="chat-conversation-preview">\line
                    \{messageCount === 0 ? "No messages yet" : `$\{messageCount\} message$\{messageCount === 1 ? "" : "s"\}`\}\line
                  </span>\line
                </span>\line
              </button>\line
            );\line
          \})\}\line
          \{filteredItems.length === 0 && (\line
            <p className="chat-list-empty">\line
              \{conversationSearch\line
                ? `No matching $\{activeListTab === "groups" ? "groups" : "friends"\}.`\line
                : activeListTab === "groups" ? "Your groups will appear here." : "Your conversations will appear here."\}\line
            </p>\line
          )\}\line
        </div>\line
      </aside>\line
\line
      <section className="chat-page" aria-label=\{conversationId ? `Chat with $\{otherPerson || "your contact"\}` : "Morphues Web welcome"\}>\line
        <header className="chat-header">\line
          <button className="chat-back-button" type="button" onClick=\{() => navigate("/chat")\} aria-label="Back to chats">\line
            \u8592?\line
          </button>\line
          \{conversationId && otherUserId ? (\line
            <UserAvatarMenu userId=\{otherUserId\} src=\{otherAvatar\} name=\{otherPerson\}>\line
              <Avatar src=\{otherAvatar\} name=\{otherPerson\} className="chat-header-avatar" />\line
            </UserAvatarMenu>\line
          ) : conversationId ? (\line
            <Avatar src=\{otherAvatar\} name=\{otherPerson\} className="chat-header-avatar" />\line
          ) : (\line
            <span className="chat-header-brand-mark" aria-hidden="true">M</span>\line
          )\}\line
          <div className="chat-header-details">\line
            <div className="chat-header-name">\{otherPerson || "Morphues Web"\}</div>\line
            <span>\{otherPerson ? "Direct message" : "Your conversations, all in one place"\}</span>\line
          </div>\line
          \{conversationId && otherUserId && (\line
            <button\line
              type="button"\line
              className="chat-call-button"\line
              title="Video call"\line
              aria-label=\{`Video call $\{otherPerson || "contact"\}`\}\line
              onClick=\{() =>\line
                // CallOverlay (mounted in Layout) listens for this browser event.\line
                window.dispatchEvent(\line
                  new CustomEvent("start-call", \{\line
                    detail: \{ id: otherUserId, username: otherPerson, avatar: otherAvatar \},\line
                  \})\line
                )\line
              \}\line
            >\line
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">\line
                <rect x="2" y="6" width="13" height="12" rx="2" />\line
                <path d="m22 8-5 3.5v1L22 16z" />\line
              </svg>\line
            </button>\line
          )\}\line
        </header>\line
\line
      <div className="message-list">\line
        \{!conversationId ? (\line
          <div className="chat-empty-state">\line
            <div className="chat-empty-icon" aria-hidden="true">\line
              <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">\line
                <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z" />\line
              </svg>\line
            </div>\line
            <h2>Morphues Web</h2>\line
            <p>Send messages, share moments, and stay close to the people who matter.</p>\line
            <span>Select a conversation to get started</span>\line
            <button type="button" onClick=\{() => navigate("/new")\}>Start a new chat</button>\line
          </div>\line
        ) : messages.map((msg) => \{\line
          const isMine = msg.user_id === user.id;\line
          const isEditing = editingId === msg.id;\line
          const statusReplyLines = msg.content.startsWith("Status reply \u183? ")\line
            ? msg.content.split("\\n")\line
            : null;\line
          const statusReplySeparator = statusReplyLines?.findIndex((line, index) => index > 0 && line === "") ?? -1;\line
          const statusReplyName = statusReplyLines?.[0].slice("Status reply \u183? ".length);\line
          const statusReplyQuote = statusReplyLines && statusReplySeparator > 1\line
            ? statusReplyLines.slice(1, statusReplySeparator).join("\\n")\line
            : "";\line
          const statusReplyText = statusReplyLines && statusReplySeparator >= 0\line
            ? statusReplyLines.slice(statusReplySeparator + 1).join("\\n")\line
            : "";\line
\line
          const callLog = parseCallLog(msg.content, isMine);\line
          if (callLog) \{\line
            return (\line
              <div key=\{msg.id\} className="call-log-row">\line
                <div className=\{`call-log-card$\{callLog.missed ? " call-log-missed" : ""\}`\}>\line
                  <span className="call-log-icon" aria-hidden="true">\line
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">\line
                      <rect x="2" y="6" width="13" height="12" rx="2" />\line
                      <path d="m22 8-5 3.5v1L22 16z" />\line
                    </svg>\line
                  </span>\line
                  <span className="call-log-text">\line
                    <strong>Video call</strong>\line
                    <span>\{callLog.detail\}</span>\line
                  </span>\line
                  <span className="call-log-time">\{formatTime(msg.created_at)\}</span>\line
                  \{otherUserId && (\line
                    <button\line
                      type="button"\line
                      className="call-log-callback"\line
                      onClick=\{() =>\line
                        window.dispatchEvent(\line
                          new CustomEvent("start-call", \{\line
                            detail: \{ id: otherUserId, username: otherPerson, avatar: otherAvatar \},\line
                          \})\line
                        )\line
                      \}\line
                    >\line
                      Call back\line
                    </button>\line
                  )\}\line
                </div>\line
              </div>\line
            );\line
          \}\line
\line
          return (\line
            <div key=\{msg.id\} className=\{`message $\{isMine ? "message-mine" : "message-theirs"\}`\}>\line
              <span className="message-author">\{msg.username\}</span>\line
\line
              \{isEditing ? (\line
                <div className="message-edit-box">\line
                  <input\line
                    type="text"\line
                    value=\{editContent\}\line
                    onChange=\{(e) => setEditContent(e.target.value)\}\line
                    className="message-edit-input"\line
                    autoFocus\line
                  />\line
                  <div className="message-edit-buttons">\line
                    <button onClick=\{() => handleEdit(msg.id)\} className="message-edit-save">\line
                      Save\line
                    </button>\line
                    <button onClick=\{() => setEditingId(null)\} className="message-edit-cancel">\line
                      Cancel\line
                    </button>\line
                  </div>\line
                </div>\line
              ) : (\line
                <>\line
                  \{msg.reply_to_id && (\line
                    <div className="message-reply-quote">\line
                      <span className="message-reply-author">\{msg.reply_username || "Deleted"\}</span>\line
                      <span className="message-reply-text">\line
                        \{msg.reply_content || "Original message deleted"\}\line
                      </span>\line
                    </div>\line
                  )\}\line
\line
                  <span className="message-content">\line
                    \{statusReplyLines ? (\line
                      <>\line
                        <span className="message-status-context">\line
                          <strong>\{isMine ? `Your reply to $\{statusReplyName\}'s status` : "Replied to your status"\}</strong>\line
                          \{statusReplyQuote && <span>\{statusReplyQuote\}</span>\}\line
                        </span>\line
                        <span className="message-status-reply-text">\{statusReplyText\}</span>\line
                      </>\line
                    ) : msg.content\}\line
                    \{msg.edited_at && <span className="message-edited-tag"> (edited)</span>\}\line
                  </span>\line
                  <MessageAttachment attachment=\{msg.attachment\} messageId=\{msg.id\} token=\{token\} />\line
                  <span className="message-time">\line
                    \{formatTime(msg.created_at)\}\line
                    \{isMine && (\line
                      <span className=\{`read-receipt $\{msg.read_at ? "read" : "sent"\}`\}>\line
                        \{msg.read_at ? " \u10003?\u10003?" : " \u10003?"\}\line
                      </span>\line
                    )\}\line
                  </span>\line
                  <div className="message-actions">\line
                    <button onClick=\{() => startReply(msg)\}>Reply</button>\line
                    \{isMine && (\line
                      <>\line
                        \{!msg.attachment && (\line
                          <button\line
                            onClick=\{() => \{\line
                              setEditingId(msg.id);\line
                              setEditContent(msg.content);\line
                            \}\}\line
                          >\line
                            Edit\line
                          </button>\line
                        )\}\line
                        <button onClick=\{() => handleDelete(msg.id)\}>Delete</button>\line
                      </>\line
                    )\}\line
                  </div>\line
                </>\line
              )\}\line
            </div>\line
          );\line
        \})\}\line
        <div ref=\{bottomRef\} />\line
      </div>\line
\line
      \{error && <p className="chat-error">\{error\}</p>\}\line
\line
      \{replyingTo && (\line
        <div className="reply-preview">\line
          <div className="reply-preview-text">\line
            <span className="reply-preview-label">Replying to \{replyingTo.username\}</span>\line
            <span className="reply-preview-content">\{replyingTo.content\}</span>\line
          </div>\line
          <button className="reply-preview-cancel" onClick=\{() => setReplyingTo(null)\}>\line
            \u10005?\line
          </button>\line
        </div>\line
      )\}\line
\{otherIsTyping && (\line
  <div className="typing-indicator">\{otherPerson\} is typing...</div>\line
)\}\line
      \{conversationId && <form onSubmit=\{handleSend\} className="message-form">\line
        <AttachmentPicker disabled=\{sendingAttachment\} onSelect=\{handleAttachmentSelected\} />\line
        <input\line
          ref=\{inputRef\}\line
          type="text"\line
          value=\{newMessage\}\line
          onChange=\{handleTyping\}\line
          placeholder="Type a message..."\line
          className="message-input"\line
        />\line
        <VoiceNoteButton\line
          disabled=\{sendingAttachment\}\line
          onSend=\{(file) => handleAttachmentSelected(file, "Voice note")\}\line
          onError=\{setError\}\line
        />\line
        <button type="submit" className="send-button" disabled=\{sendingAttachment\}>\line
          <span className="send-button-text">\{sendingAttachment ? "Sending\u8230?" : "Send"\}</span>\line
          <svg className="send-button-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">\line
            <path d="m22 2-7 20-4-9-9-4Z" />\line
            <path d="M22 2 11 13" />\line
          </svg>\line
        </button>\line
      </form>\}\line
      </section>\line
    </div>\line
  );\line
