\b src/pages/GroupChatPage.jsx\b0\par
{\f1\fs15\cf2 import \{ useState, useEffect, useRef \} from "react";\line
import \{ useNavigate, useParams \} from "react-router-dom";\line
import \{ io \} from "socket.io-client";\line
import "../css/Chatpage.css";\line
import AttachmentPicker from "../components/AttachmentPicker";\line
import MessageAttachment from "../components/MessageAttachment";\line
import VoiceNoteButton from "../components/VoiceNoteButton";\line
import \{ MAX_ATTACHMENT_SIZE, readFileAsDataUrl \} from "../attachmentUtils";\line
\line
const API_URL = "https://dream-chat-app-1.onrender.com";\line
\line
function formatTime(timestamp) \{\line
  const date = new Date(timestamp);\line
  return date.toLocaleTimeString([], \{ hour: "numeric", minute: "2-digit" \});\line
\}\line
\line
function getInitials(name) \{\line
  return name ? name.slice(0, 2).toUpperCase() : "?";\line
\}\line
\line
export default function GroupChatPage() \{\line
  const \{ groupId \} = useParams();\line
  const navigate = useNavigate();\line
  const [messages, setMessages] = useState([]);\line
  const [newMessage, setNewMessage] = useState("");\line
  const [error, setError] = useState("");\line
  const [groupName, setGroupName] = useState("Group");\line
  const [editingId, setEditingId] = useState(null);\line
  const [editContent, setEditContent] = useState("");\line
  const [replyingTo, setReplyingTo] = useState(null);\line
  const [sendingAttachment, setSendingAttachment] = useState(false);\line
\line
  const bottomRef = useRef(null);\line
  const inputRef = useRef(null);\line
  const user = JSON.parse(localStorage.getItem("user"));\line
  const token = localStorage.getItem("token");\line
\line
  useEffect(() => \{\line
    async function fetchGroupName() \{\line
      try \{\line
        const response = await fetch("https://dream-chat-app-1.onrender.com/api/groups", \{\line
          headers: \{ Authorization: `Bearer $\{token\}` \},\line
        \});\line
        if (!response.ok) return;\line
        const groups = await response.json();\line
        const match = groups.find((g) => g.id === Number(groupId));\line
        if (match) setGroupName(match.name);\line
      \} catch \{\line
        // non-critical\line
      \}\line
    \}\line
    fetchGroupName();\line
  \}, [token, groupId]);\line
\line
  useEffect(() => \{\line
    async function fetchMessages() \{\line
      try \{\line
        const response = await fetch(\line
          `https://dream-chat-app-1.onrender.com/api/groups/$\{groupId\}/messages`,\line
          \{ headers: \{ Authorization: `Bearer $\{token\}` \} \}\line
        );\line
        if (!response.ok) throw new Error("Failed to load messages.");\line
        const data = await response.json();\line
        setMessages(data);\line
      \} catch (err) \{\line
        setError(err.message);\line
      \}\line
    \}\line
    fetchMessages();\line
  \}, [token, groupId]);\line
\line
  useEffect(() => \{\line
    const socket = io("https://dream-chat-app-1.onrender.com", \{ auth: \{ token \} \});\line
    socket.emit("joinGroup", groupId);\line
\line
    socket.on("newGroupMessage", (message) => \{\line
      if (message.groupId !== Number(groupId)) return;\line
      setMessages((prev) => \{\line
        const alreadyExists = prev.some((m) => m.id === message.id);\line
        if (alreadyExists) return prev;\line
        return [...prev, message];\line
      \});\line
    \});\line
\line
    socket.on("groupMessageEdited", (updated) => \{\line
      setMessages((prev) =>\line
        prev.map((m) =>\line
          m.id === updated.id\line
            ? \{ ...m, content: updated.content, edited_at: updated.edited_at \}\line
            : m\line
        )\line
      );\line
    \});\line
\line
    socket.on("groupMessageDeleted", (\{ id, groupId: delGroupId \}) => \{\line
      if (delGroupId !== Number(groupId)) return;\line
      setMessages((prev) => prev.filter((m) => m.id !== id));\line
    \});\line
\line
    return () => socket.disconnect();\line
    // eslint-disable-next-line react-hooks/exhaustive-deps\line
  \}, [token, groupId]);\line
\line
  useEffect(() => \{\line
    bottomRef.current?.scrollIntoView(\{ behavior: "smooth" \});\line
  \}, [messages]);\line
\line
  async function handleSend(e) \{\line
    e.preventDefault();\line
    if (!newMessage.trim()) return;\line
\line
    try \{\line
      const response = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/groups/$\{groupId\}/messages`,\line
        \{\line
          method: "POST",\line
          headers: \{\line
            "Content-Type": "application/json",\line
            Authorization: `Bearer $\{token\}`,\line
          \},\line
          body: JSON.stringify(\{\line
            content: newMessage,\line
            replyToId: replyingTo ? replyingTo.id : null,\line
          \}),\line
        \}\line
      );\line
      if (!response.ok) throw new Error("Failed to send message.");\line
      setNewMessage("");\line
      setReplyingTo(null);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
\line
  async function handleAttachmentSelected(file, attachmentLabel) \{\line
    if (!file) return;\line
    if (file.size > MAX_ATTACHMENT_SIZE) \{\line
      setError("Attachments must be 10 MB or smaller.");\line
      return;\line
    \}\line
\line
    setError("");\line
    setSendingAttachment(true);\line
    try \{\line
      const data = await readFileAsDataUrl(file);\line
      const response = await fetch(`$\{API_URL\}/api/groups/$\{groupId\}/messages`, \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{\line
          content: newMessage.trim() || attachmentLabel || `\u-10179? $\{file.name\}`,\line
          replyToId: replyingTo ? replyingTo.id : null,\line
          attachment: \{ file_name: file.name, mime_type: file.type || "application/octet-stream", data \},\line
        \}),\line
      \});\line
      const result = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(result.message || "Failed to send attachment.");\line
      setNewMessage("");\line
      setReplyingTo(null);\line
    \} catch (uploadError) \{\line
      setError(uploadError.message || "Failed to send attachment.");\line
    \} finally \{\line
      setSendingAttachment(false);\line
    \}\line
  \}\line
\line
  async function handleEdit(messageId) \{\line
    if (!editContent.trim()) return;\line
    try \{\line
      const response = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/groups/messages/$\{messageId\}`,\line
        \{\line
          method: "PATCH",\line
          headers: \{\line
            "Content-Type": "application/json",\line
            Authorization: `Bearer $\{token\}`,\line
          \},\line
          body: JSON.stringify(\{ content: editContent \}),\line
        \}\line
      );\line
      if (!response.ok) throw new Error("Failed to edit message.");\line
      setEditingId(null);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
\line
  async function handleDelete(messageId) \{\line
    if (!window.confirm("Delete this message?")) return;\line
    try \{\line
      const response = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/groups/messages/$\{messageId\}`,\line
        \{\line
          method: "DELETE",\line
          headers: \{ Authorization: `Bearer $\{token\}` \},\line
        \}\line
      );\line
      if (!response.ok) throw new Error("Failed to delete message.");\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
\line
  function startReply(msg) \{\line
    setReplyingTo(\{ id: msg.id, content: msg.content, username: msg.username \});\line
    inputRef.current?.focus();\line
  \}\line
\line
  return (\line
    <div className="chat-page group-chat-page">\line
      <div className="chat-header">\line
        <button\line
          className="chat-back-button"\line
          type="button"\line
          onClick=\{() => navigate("/chat")\}\line
          aria-label="Back to chats"\line
        >\line
          \u8592?\line
        </button>\line
        <div className="chat-header-avatar">\{getInitials(groupName)\}</div>\line
        <div className="chat-header-details">\line
          <div className="chat-header-name">\{groupName\}</div>\line
          <span>Group conversation</span>\line
        </div>\line
      </div>\line
\line
      <div className="message-list">\line
        \{messages.map((msg) => \{\line
          const isMine = msg.user_id === user.id;\line
          const isEditing = editingId === msg.id;\line
\line
          return (\line
            <div key=\{msg.id\} className=\{`message $\{isMine ? "message-mine" : "message-theirs"\}`\}>\line
              <span className="message-author">\{msg.username\}</span>\line
\line
              \{isEditing ? (\line
                <div className="message-edit-box">\line
                  <input\line
                    type="text"\line
                    value=\{editContent\}\line
                    onChange=\{(e) => setEditContent(e.target.value)\}\line
                    className="message-edit-input"\line
                    autoFocus\line
                  />\line
                  <div className="message-edit-buttons">\line
                    <button onClick=\{() => handleEdit(msg.id)\} className="message-edit-save">\line
                      Save\line
                    </button>\line
                    <button onClick=\{() => setEditingId(null)\} className="message-edit-cancel">\line
                      Cancel\line
                    </button>\line
                  </div>\line
                </div>\line
              ) : (\line
                <>\line
                  \{msg.reply_to_id && (\line
                    <div className="message-reply-quote">\line
                      <span className="message-reply-author">\{msg.reply_username || "Deleted"\}</span>\line
                      <span className="message-reply-text">\line
                        \{msg.reply_content || "Original message deleted"\}\line
                      </span>\line
                    </div>\line
                  )\}\line
\line
                  <span className="message-content">\line
                    \{msg.content\}\line
                    \{msg.edited_at && <span className="message-edited-tag"> (edited)</span>\}\line
                  </span>\line
                  <MessageAttachment attachment=\{msg.attachment\} messageId=\{msg.id\} token=\{token\} />\line
                  <span className="message-time">\{formatTime(msg.created_at)\}</span>\line
\line
                  <div className="message-actions">\line
                    <button onClick=\{() => startReply(msg)\}>Reply</button>\line
                    \{isMine && (\line
                      <>\line
                        \{!msg.attachment && (\line
                          <button\line
                            onClick=\{() => \{\line
                              setEditingId(msg.id);\line
                              setEditContent(msg.content);\line
                            \}\}\line
                          >\line
                            Edit\line
                          </button>\line
                        )\}\line
                        <button onClick=\{() => handleDelete(msg.id)\}>Delete</button>\line
                      </>\line
                    )\}\line
                  </div>\line
                </>\line
              )\}\line
            </div>\line
          );\line
        \})\}\line
        <div ref=\{bottomRef\} />\line
      </div>\line
\line
      \{error && <p className="chat-error">\{error\}</p>\}\line
\line
      \{replyingTo && (\line
        <div className="reply-preview">\line
          <div className="reply-preview-text">\line
            <span className="reply-preview-label">Replying to \{replyingTo.username\}</span>\line
            <span className="reply-preview-content">\{replyingTo.content\}</span>\line
          </div>\line
          <button className="reply-preview-cancel" onClick=\{() => setReplyingTo(null)\}>\line
            \u10005?\line
          </button>\line
        </div>\line
      )\}\line
\line
      <form onSubmit=\{handleSend\} className="message-form">\line
        <AttachmentPicker disabled=\{sendingAttachment\} onSelect=\{handleAttachmentSelected\} />\line
        <input\line
          ref=\{inputRef\}\line
          type="text"\line
          value=\{newMessage\}\line
          onChange=\{(e) => setNewMessage(e.target.value)\}\line
          placeholder="Message the group..."\line
          className="message-input"\line
        />\line
        <VoiceNoteButton\line
          disabled=\{sendingAttachment\}\line
          onSend=\{(file) => handleAttachmentSelected(file, "Voice note")\}\line
          onError=\{setError\}\line
        />\line
        <button type="submit" className="send-button" disabled=\{sendingAttachment\}>\line
          <span className="send-button-text">\{sendingAttachment ? "Sending\u8230?" : "Send"\}</span>\line
          <svg className="send-button-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">\line
            <path d="m22 2-7 20-4-9-9-4Z" />\line
            <path d="M22 2 11 13" />\line
          </svg>\line
        </button>\line
      </form>\line
    </div>\line
  );\line
\}}\par\par
\b src/pages/ProfilePage.jsx\b0\par
{\f1\fs15\cf2 import \{ useCallback, useEffect, useRef, useState \} from "react";\line
import \{ Link, useNavigate, useOutletContext, useParams \} from "react-router-dom";\line
import \{ resizeImage \} from "../resizeImage";\line
import Avatar from "../components/Avatar";\line
import "../css/Profile.css";\line
\line
const API_URL = "https://dream-chat-app-1.onrender.com";\line
\line
function formatDate(timestamp) \{\line
  return new Date(timestamp).toLocaleDateString([], \{ month: "short", day: "numeric" \});\line
\}\line
\line
export default function ProfilePage() \{\line
  const \{ handleLogout \} = useOutletContext();\line
  const navigate = useNavigate();\line
  const \{ userId \} = useParams();\line
  const [currentUser, setCurrentUser] = useState(() => JSON.parse(localStorage.getItem("user") || "null"));\line
  const [profileUser, setProfileUser] = useState(null);\line
  const [posts, setPosts] = useState([]);\line
  const [statuses, setStatuses] = useState([]);\line
  const [friendCount, setFriendCount] = useState(0);\line
  const [friends, setFriends] = useState([]);\line
  const [friendsAvailable, setFriendsAvailable] = useState(true);\line
  const [isFriend, setIsFriend] = useState(false);\line
  const [friendsOpen, setFriendsOpen] = useState(false);\line
  const [removingFriendId, setRemovingFriendId] = useState(null);\line
  const [activeTab, setActiveTab] = useState("posts");\line
  const [error, setError] = useState("");\line
  const [loading, setLoading] = useState(true);\line
  const [uploading, setUploading] = useState(false);\line
  const fileInputRef = useRef(null);\line
  const token = localStorage.getItem("token");\line
  const viewedUserId = userId || currentUser?.id;\line
  const isOwnProfile = Number(viewedUserId) === Number(currentUser?.id);\line
\line
  const fetchProfileContent = useCallback(async () => \{\line
    setLoading(true);\line
    setError("");\line
    setProfileUser(isOwnProfile ? currentUser : null);\line
    setPosts([]);\line
    setStatuses([]);\line
    setFriendCount(0);\line
    setFriends([]);\line
    setFriendsAvailable(true);\line
    setIsFriend(false);\line
    try \{\line
      const headers = \{ Authorization: `Bearer $\{token\}` \};\line
      if (!isOwnProfile) \{\line
        const response = await fetch(`$\{API_URL\}/api/users/$\{viewedUserId\}/profile`, \{ headers \});\line
        if (response.status === 404) \{\line
          // Support deployments where the profile endpoint has not been deployed yet.\line
          const [usersResponse, postsResponse, statusesResponse] = await Promise.all([\line
            fetch(`$\{API_URL\}/api/users`, \{ headers \}),\line
            fetch(`$\{API_URL\}/api/posts`, \{ headers \}),\line
            fetch(`$\{API_URL\}/api/statuses`, \{ headers \}),\line
          ]);\line
          if (!usersResponse.ok || !postsResponse.ok || !statusesResponse.ok) \{\line
            throw new Error("Could not load this profile.");\line
          \}\line
          const [users, allPosts, allStatuses] = await Promise.all([\line
            usersResponse.json(),\line
            postsResponse.json(),\line
            statusesResponse.json(),\line
          ]);\line
          const selectedUser = users.find((item) => Number(item.id) === Number(viewedUserId));\line
          if (!selectedUser) throw new Error("This profile is unavailable.");\line
          const [selectedFriendsResponse, ownFriendsResponse] = await Promise.all([\line
            fetch(`$\{API_URL\}/api/users/$\{viewedUserId\}/friends`, \{ headers \}),\line
            fetch(`$\{API_URL\}/api/friends`, \{ headers \}),\line
          ]);\line
          if (selectedFriendsResponse.ok) \{\line
            const selectedFriends = await selectedFriendsResponse.json();\line
            setFriends(selectedFriends);\line
            setFriendCount(selectedFriends.length);\line
          \} else \{\line
            setFriendsAvailable(false);\line
          \}\line
          if (ownFriendsResponse.ok) \{\line
            const ownFriends = await ownFriendsResponse.json();\line
            setIsFriend(ownFriends.some((friend) => Number(friend.id) === Number(viewedUserId)));\line
          \}\line
          setProfileUser(selectedUser);\line
          setPosts(allPosts.filter((post) => Number(post.user_id) === Number(viewedUserId)));\line
          setStatuses(allStatuses.filter((status) => Number(status.user_id) === Number(viewedUserId)));\line
          return;\line
        \}\line
        const data = await response.json().catch(() => null);\line
        if (!response.ok) throw new Error(data?.message || "Could not load this profile.");\line
        if (!data?.user || !Array.isArray(data.posts) || !Array.isArray(data.statuses)) \{\line
          throw new Error("The selected user's profile could not be loaded.");\line
        \}\line
        setProfileUser(data.user);\line
        setPosts(data.posts);\line
        setStatuses(data.statuses);\line
        setFriends(Array.isArray(data.friends) ? data.friends : []);\line
        setFriendsAvailable(Array.isArray(data.friends));\line
        setFriendCount(Array.isArray(data.friends) ? data.friends.length : Number(data.friendCount) || 0);\line
        setIsFriend(true);\line
        return;\line
      \}\line
\line
      setProfileUser(currentUser);\line
      const [postsResponse, statusesResponse, friendsResponse] = await Promise.all([\line
        fetch(`$\{API_URL\}/api/posts`, \{ headers \}),\line
        fetch(`$\{API_URL\}/api/statuses`, \{ headers \}),\line
        fetch(`$\{API_URL\}/api/friends`, \{ headers \}),\line
      ]);\line
      if (!postsResponse.ok || !statusesResponse.ok || !friendsResponse.ok) \{\line
        throw new Error("Could not load your profile. Please try again.");\line
      \}\line
      const [allPosts, allStatuses, friends] = await Promise.all([\line
        postsResponse.json(),\line
        statusesResponse.json(),\line
        friendsResponse.json(),\line
      ]);\line
      setPosts(allPosts.filter((post) => Number(post.user_id) === Number(currentUser?.id)));\line
      setStatuses(allStatuses.filter((status) => Number(status.user_id) === Number(currentUser?.id)));\line
      setFriendCount(friends.length);\line
      setFriends(friends);\line
      setIsFriend(false);\line
    \} catch (loadError) \{\line
      setError(loadError.message || "Could not load your profile.");\line
    \} finally \{\line
      setLoading(false);\line
    \}\line
  \}, [currentUser, isOwnProfile, token, viewedUserId]);\line
\line
  useEffect(() => \{\line
    fetchProfileContent();\line
  \}, [fetchProfileContent]);\line
\line
  async function handleFileChange(event) \{\line
    const file = event.target.files?.[0];\line
    if (!file) return;\line
\line
    setError("");\line
    setUploading(true);\line
    try \{\line
      const resized = await resizeImage(file, 256);\line
      const response = await fetch(`$\{API_URL\}/api/users/avatar`, \{\line
        method: "PATCH",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ avatar: resized \}),\line
      \});\line
      const data = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(data.message || "Failed to update profile photo.");\line
\line
      const updatedUser = \{ ...currentUser, avatar: resized \};\line
      localStorage.setItem("user", JSON.stringify(updatedUser));\line
      setCurrentUser(updatedUser);\line
      setProfileUser(updatedUser);\line
    \} catch (uploadError) \{\line
      setError(uploadError.message || "Failed to update profile photo.");\line
    \} finally \{\line
      setUploading(false);\line
      event.target.value = "";\line
    \}\line
  \}\line
\line
  async function deletePost(postId) \{\line
    if (!isOwnProfile) return;\line
    if (!window.confirm("Delete this post? This action cannot be undone.")) return;\line
    setError("");\line
    try \{\line
      const response = await fetch(`$\{API_URL\}/api/posts/$\{postId\}`, \{\line
        method: "DELETE",\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      const data = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(data.message || "Failed to delete post.");\line
      setPosts((current) => current.filter((post) => post.id !== postId));\line
    \} catch (deleteError) \{\line
      setError(deleteError.message || "Failed to delete post.");\line
    \}\line
  \}\line
\line
  async function deleteStatus(statusId) \{\line
    if (!isOwnProfile) return;\line
    if (!window.confirm("Delete this status? This action cannot be undone.")) return;\line
    setError("");\line
    try \{\line
      const response = await fetch(`$\{API_URL\}/api/statuses/$\{statusId\}`, \{\line
        method: "DELETE",\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      const data = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(data.message || "Failed to delete status.");\line
      setStatuses((current) => current.filter((status) => status.id !== statusId));\line
    \} catch (deleteError) \{\line
      setError(deleteError.message || "Failed to delete status.");\line
    \}\line
  \}\line
\line
  async function messageFriend(friend) \{\line
    setError("");\line
    try \{\line
      const response = await fetch(`$\{API_URL\}/api/conversations`, \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ otherUserId: friend.id \}),\line
      \});\line
      const data = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(data.message || "Could not open this conversation.");\line
      navigate(`/chat/$\{data.id\}`);\line
    \} catch (messageError) \{\line
      setError(messageError.message || "Could not open this conversation.");\line
    \}\line
  \}\line
\line
  async function removeFriend(friend) \{\line
    if (!window.confirm(`Remove $\{friend.username\} from your friends?`)) return;\line
    setError("");\line
    setRemovingFriendId(friend.id);\line
    try \{\line
      const response = await fetch(`$\{API_URL\}/api/friends/$\{friend.id\}`, \{\line
        method: "DELETE",\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      const data = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(data.message || "Could not remove this friend.");\line
      setFriends((current) => current.filter((item) => Number(item.id) !== Number(friend.id)));\line
      setFriendCount((count) => Math.max(0, count - 1));\line
    \} catch (removeError) \{\line
      setError(removeError.message || "Could not remove this friend.");\line
    \} finally \{\line
      setRemovingFriendId(null);\line
    \}\line
  \}\line
\line
  async function removeProfileFriend() \{\line
    if (!profileUser || isOwnProfile) return;\line
    if (!window.confirm(`Remove $\{profileUser.username\} from your friends?`)) return;\line
    setError("");\line
    setRemovingFriendId(profileUser.id);\line
    try \{\line
      const response = await fetch(`$\{API_URL\}/api/friends/$\{profileUser.id\}`, \{\line
        method: "DELETE",\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      const data = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(data.message || "Could not remove this friend.");\line
      setIsFriend(false);\line
      setFriends((current) => current.filter((friend) => Number(friend.id) !== Number(currentUser?.id)));\line
      setFriendCount((count) => Math.max(0, Number(count) - 1));\line
    \} catch (removeError) \{\line
      setError(removeError.message || "Could not remove this friend.");\line
    \} finally \{\line
      setRemovingFriendId(null);\line
    \}\line
  \}\line
\line
  return (\line
    <main className="profile-page">\line
      <div className="profile-shell">\line
        <section className="profile-card" aria-label=\{isOwnProfile ? "Your profile" : `$\{profileUser?.username || "User"\}'s profile`\}>\line
          <div className="profile-identity">\line
            <div className=\{`profile-avatar-wrap$\{statuses.length ? " has-active-status" : ""\}`\}>\line
              <Avatar src=\{profileUser?.avatar\} name=\{profileUser?.username\} className="profile-avatar" />\line
              \{isOwnProfile && (\line
                <button\line
                  type="button"\line
                  className="profile-avatar-edit"\line
                  onClick=\{() => fileInputRef.current?.click()\}\line
                  disabled=\{uploading\}\line
                  aria-label=\{uploading ? "Uploading profile photo" : "Change profile photo"\}\line
                  title=\{uploading ? "Uploading..." : "Change profile photo"\}\line
                >\line
                  \{uploading ? "\u8230?" : (\line
                    <svg\line
                      aria-hidden="true"\line
                      viewBox="0 0 24 24"\line
                      fill="none"\line
                      stroke="currentColor"\line
                      strokeWidth="2"\line
                      strokeLinecap="round"\line
                      strokeLinejoin="round"\line
                    >\line
                      <path d="M14 4h-4L8 7H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z" />\line
                      <circle cx="12" cy="13" r="3" />\line
                    </svg>\line
                  )\}\line
                </button>\line
              )\}\line
              <input\line
                ref=\{fileInputRef\}\line
                className="profile-photo-input"\line
                type="file"\line
                accept="image/*"\line
                onChange=\{handleFileChange\}\line
                disabled=\{!isOwnProfile || uploading\}\line
                tabIndex=\{-1\}\line
              />\line
            </div>\line
            <div className="profile-identity-copy">\line
              <h1>\{profileUser?.username || (loading ? "Loading profile\u8230?" : "Profile")\}</h1>\line
              <p>\{isOwnProfile ? profileUser?.email : `@$\{profileUser?.username || ""\}`\}</p>\line
              <span>\{isOwnProfile ? "Welcome to your Morphues profile." : "Profile and recent posts"\}</span>\line
            </div>\line
            \{isOwnProfile ? <button\line
              type="button"\line
              className="profile-edit-button"\line
              onClick=\{() => fileInputRef.current?.click()\}\line
              disabled=\{uploading\}\line
            >\line
              \{uploading ? "Updating..." : "Edit photo"\}\line
            </button> : isFriend && (\line
              <div className="profile-visitor-actions">\line
                <button\line
                  type="button"\line
                  className="profile-message-friend-button"\line
                  onClick=\{() => messageFriend(profileUser)\}\line
                >\line
                  Message\line
                </button>\line
                <button\line
                  type="button"\line
                  className="profile-remove-friend-button"\line
                  onClick=\{removeProfileFriend\}\line
                  disabled=\{removingFriendId === profileUser?.id\}\line
                >\line
                  \{removingFriendId === profileUser?.id ? "Removing\u8230?" : "Remove friend"\}\line
                </button>\line
              </div>\line
            )\}\line
          </div>\line
\line
          <div className="profile-stats" aria-label="Profile statistics">\line
            <div><strong>\{posts.length\}</strong><span>Posts</span></div>\line
            <button\line
              type="button"\line
              className="profile-friends-stat"\line
              onClick=\{() => friendsAvailable && setFriendsOpen(true)\}\line
              disabled=\{!friendsAvailable\}\line
              aria-label=\{`$\{friendCount ?? "Unknown"\} friends$\{friendsAvailable ? ", open friends list" : ""\}`\}\line
            >\line
              <strong>\{friendCount ?? "\u8212?"\}</strong><span>Friends</span>\line
            </button>\line
            <div><strong>\{statuses.length\}</strong><span>Active status</span></div>\line
          </div>\line
\line
          <div className="profile-highlights">\line
            <div className="profile-highlights-heading">\line
              <h2>Recent status</h2>\line
              <span>Expires after 24 hours</span>\line
            </div>\line
            <div className="profile-highlight-list">\line
              \{statuses.length === 0 ? (\line
                <div className="profile-highlight-empty">\line
                  <span className="profile-highlight-add" aria-hidden="true">+</span>\line
                  <span>No active status</span>\line
                </div>\line
              ) : statuses.slice(0, 6).map((status) => (\line
                <div className="profile-highlight" key=\{status.id\}>\line
                  <div className="profile-highlight-ring">\line
                    <div\line
                      className="profile-highlight-content"\line
                      style=\{\{ background: status.image_url ? `center / cover url("$\{status.image_url\}")` : status.background_color \}\}\line
                    >\line
                      \{!status.image_url && (status.content || "Status")\}\line
                    </div>\line
                  </div>\line
                  <span>\{formatDate(status.created_at)\}</span>\line
                </div>\line
              ))\}\line
            </div>\line
          </div>\line
        </section>\line
\line
        \{isOwnProfile && <section className="profile-mobile-actions" aria-label="Profile and account options">\line
          <Link to="/settings">\line
            <span className="profile-mobile-action-icon" aria-hidden="true">\u9881?</span>\line
            <span><strong>Settings</strong><small>Appearance and account preferences</small></span>\line
            <span className="profile-mobile-action-arrow" aria-hidden="true">\u8250?</span>\line
          </Link>\line
          <button type="button" onClick=\{handleLogout\}>\line
            <span className="profile-mobile-action-icon logout" aria-hidden="true">\u8618?</span>\line
            <span><strong>Log out</strong><small>Sign out of your account</small></span>\line
            <span className="profile-mobile-action-arrow" aria-hidden="true">\u8250?</span>\line
          </button>\line
        </section>\}\line
\line
        \{error && <p className="profile-error" role="alert">\{error\}</p>\}\line
\line
        \{friendsOpen && (\line
          <div className="profile-friends-backdrop" onMouseDown=\{(event) => \{\line
            if (event.target === event.currentTarget) setFriendsOpen(false);\line
          \}\}>\line
            <section\line
              className="profile-friends-dialog"\line
              role="dialog"\line
              aria-modal="true"\line
              aria-labelledby="profile-friends-title"\line
            >\line
              <header>\line
                <div>\line
                  <h2 id="profile-friends-title">\{isOwnProfile ? "Your friends" : `$\{profileUser?.username || "Their"\}'s friends`\}</h2>\line
                  <span>\{friends.length\} \{friends.length === 1 ? "friend" : "friends"\}</span>\line
                </div>\line
                <button type="button" onClick=\{() => setFriendsOpen(false)\} aria-label="Close friends list">\u215?</button>\line
              </header>\line
              \{friends.length === 0 ? (\line
                <p className="profile-friends-empty">You haven't added any friends yet.</p>\line
              ) : (\line
                <ul className="profile-friends-list">\line
                  \{friends.map((friend) => (\line
                    <li key=\{friend.id\}>\line
                      <Avatar src=\{friend.avatar\} name=\{friend.username\} className="profile-friend-avatar" />\line
                      <strong>\{friend.username\}</strong>\line
                      <div className="profile-friend-actions">\line
                        \{isOwnProfile && (\line
                          <>\line
                            <button type="button" onClick=\{() => messageFriend(friend)\}>Message</button>\line
                            <button\line
                              type="button"\line
                              className="remove"\line
                              disabled=\{removingFriendId === friend.id\}\line
                              onClick=\{() => removeFriend(friend)\}\line
                            >\line
                              \{removingFriendId === friend.id ? "Removing\u8230?" : "Remove"\}\line
                            </button>\line
                          </>\line
                        )\}\line
                      </div>\line
                    </li>\line
                  ))\}\line
                </ul>\line
              )\}\line
            </section>\line
          </div>\line
        )\}\line
\line
        <section className="profile-content">\line
          <div className="profile-tabs" role="tablist" aria-label="Profile content">\line
            <button\line
              type="button"\line
              role="tab"\line
              aria-selected=\{activeTab === "posts"\}\line
              className=\{activeTab === "posts" ? "active" : ""\}\line
              onClick=\{() => setActiveTab("posts")\}\line
            >\line
              <span aria-hidden="true">\u9638?</span> Posts <span className="profile-tab-count">\{posts.length\}</span>\line
            </button>\line
            <button\line
              type="button"\line
              role="tab"\line
              aria-selected=\{activeTab === "statuses"\}\line
              className=\{activeTab === "statuses" ? "active" : ""\}\line
              onClick=\{() => setActiveTab("statuses")\}\line
            >\line
              <span aria-hidden="true">\u9673?</span> Status <span className="profile-tab-count">\{statuses.length\}</span>\line
            </button>\line
          </div>\line
\line
          \{loading ? (\line
            <p className="profile-empty">Loading your profile\u8230?</p>\line
          ) : activeTab === "posts" ? (\line
            posts.length > 0 ? (\line
              <div className="profile-post-grid">\line
                \{posts.map((post) => (\line
                  <article className="profile-post-tile" key=\{post.id\}>\line
                    \{post.image_url ? (\line
                      <img src=\{post.image_url\} alt=\{post.caption || "Your post"\} />\line
                    ) : (\line
                      <div className="profile-post-text-tile">\{post.caption || "Post"\}</div>\line
                    )\}\line
                    <div className="profile-post-overlay">\line
                      <span>\{post.caption || "Your post"\}</span>\line
                      \{isOwnProfile && (\line
                        <button type="button" onClick=\{() => deletePost(post.id)\} aria-label="Delete post">\line
                          Delete\line
                        </button>\line
                      )\}\line
                    </div>\line
                  </article>\line
                ))\}\line
              </div>\line
            ) : (\line
            <p className="profile-empty">\line
              \{isOwnProfile ? "Your posts will appear here." : `$\{profileUser?.username || "This user"\} has no posts yet.`\}\line
            </p>\line
            )\line
          ) : (\line
            statuses.length > 0 ? (\line
              <div className="profile-status-grid">\line
                \{statuses.map((status) => (\line
                  <article\line
                    className="profile-status-tile"\line
                    key=\{status.id\}\line
                    style=\{\{ background: status.image_url ? `center / cover url("$\{status.image_url\}")` : status.background_color \}\}\line
                  >\line
                    <p>\{status.content || "Photo status"\}</p>\line
                    <time>\{formatDate(status.created_at)\}</time>\line
                    \{isOwnProfile && (\line
                      <button type="button" onClick=\{() => deleteStatus(status.id)\} aria-label="Delete status">\line
                        Delete\line
                      </button>\line
                    )\}\line
                  </article>\line
                ))\}\line
              </div>\line
            ) : (\line
              <p className="profile-empty">\line
                \{isOwnProfile ? "Your active statuses will appear here." : `$\{profileUser?.username || "This user"\} has no active statuses.`\}\line
              </p>\line
            )\line
          )\}\line
        </section>\line
      </div>\line
    </main>\line
  );\line
\}}\par\par
