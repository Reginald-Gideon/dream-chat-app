{\f1\fs15\cf2 import \{ useEffect, useRef, useState \} from "react";\line
\line
const API_URL = "https://dream-chat-app-1.onrender.com";\line
\line
async function fetchAttachment(messageId, token) \{\line
  const response = await fetch(`$\{API_URL\}/api/messages/$\{messageId\}/attachment`, \{\line
    headers: \{ Authorization: `Bearer $\{token\}` \},\line
  \});\line
  if (!response.ok) \{\line
    const result = await response.json().catch(() => (\{\}));\line
    throw new Error(result.message || "Could not load this attachment.");\line
  \}\line
  return response.blob();\line
\}\line
\line
function formatAudioTime(value) \{\line
  const seconds = Number.isFinite(value) ? Math.floor(value) : 0;\line
  return `$\{Math.floor(seconds / 60)\}:$\{String(seconds % 60).padStart(2, "0")\}`;\line
\}\line
\line
function formatFileSize(value) \{\line
  const size = Number(value);\line
  return size >= 1024 * 1024\line
    ? `$\{(size / (1024 * 1024)).toFixed(1)\} MB`\line
    : `$\{Math.max(1, Math.round(size / 1024))\} KB`;\line
\}\line
\line
export default function MessageAttachment(\{ attachment, messageId, token \}) \{\line
  const [previewUrl, setPreviewUrl] = useState("");\line
  const [loading, setLoading] = useState(Boolean(attachment));\line
  const [downloading, setDownloading] = useState(false);\line
  const [error, setError] = useState("");\line
  const [isPlaying, setIsPlaying] = useState(false);\line
  const [currentTime, setCurrentTime] = useState(0);\line
  const [duration, setDuration] = useState(0);\line
  const audioRef = useRef(null);\line
  const isAudio = attachment?.mime_type?.startsWith("audio/");\line
  const isImage = attachment?.mime_type?.startsWith("image/");\line
  const isVideo = attachment?.mime_type?.startsWith("video/");\line
  const isPdf = attachment?.mime_type === "application/pdf";\line
\line
  useEffect(() => \{\line
    if (!attachment) return undefined;\line
    const controller = new AbortController();\line
    const audioElement = audioRef.current;\line
    let active = true;\line
    let objectUrl = "";\line
\line
    setLoading(true);\line
    setError("");\line
    setPreviewUrl("");\line
    setCurrentTime(0);\line
    setDuration(0);\line
    setIsPlaying(false);\line
\line
    fetch(`$\{API_URL\}/api/messages/$\{messageId\}/attachment`, \{\line
      headers: \{ Authorization: `Bearer $\{token\}` \},\line
      signal: controller.signal,\line
    \})\line
      .then(async (response) => \{\line
        if (!response.ok) \{\line
          const result = await response.json().catch(() => (\{\}));\line
          throw new Error(result.message || "Could not load this attachment.");\line
        \}\line
        return response.blob();\line
      \})\line
      .then((blob) => \{\line
        if (!active) return;\line
        objectUrl = URL.createObjectURL(blob);\line
        setPreviewUrl(objectUrl);\line
      \})\line
      .catch((loadError) => \{\line
        if (loadError.name !== "AbortError" && active) \{\line
          setError(loadError.message || "Could not load this attachment.");\line
        \}\line
      \})\line
      .finally(() => \{\line
        if (active) setLoading(false);\line
      \});\line
\line
    return () => \{\line
      active = false;\line
      controller.abort();\line
      audioElement?.pause();\line
      if (objectUrl) URL.revokeObjectURL(objectUrl);\line
    \};\line
  \}, [attachment, messageId, token]);\line
\line
  if (!attachment) return null;\line
\line
  async function downloadAttachment() \{\line
    setDownloading(true);\line
    setError("");\line
    let temporaryUrl = "";\line
    try \{\line
      let url = previewUrl;\line
      if (!url) \{\line
        const blob = await fetchAttachment(messageId, token);\line
        temporaryUrl = URL.createObjectURL(blob);\line
        url = temporaryUrl;\line
      \}\line
\line
      const link = document.createElement("a");\line
      link.href = url;\line
      link.download = attachment.file_name;\line
      document.body.appendChild(link);\line
      link.click();\line
      link.remove();\line
    \} catch (downloadError) \{\line
      setError(downloadError.message || "Could not download this attachment.");\line
    \} finally \{\line
      if (temporaryUrl) window.setTimeout(() => URL.revokeObjectURL(temporaryUrl), 1000);\line
      setDownloading(false);\line
    \}\line
  \}\line
\line
  async function toggleAudioPlayback() \{\line
    if (!audioRef.current) return;\line
    if (audioRef.current.paused) \{\line
      try \{\line
        await audioRef.current.play();\line
        setError("");\line
      \} catch \{\line
        setError("Could not play this audio file in your browser.");\line
      \}\line
    \} else \{\line
      audioRef.current.pause();\line
    \}\line
  \}\line
\line
  return (\line
    <div className="message-attachment">\line
      \{loading && <span className="message-attachment-status">Loading attachment\u8230?</span>\}\line
      \{error && <small className="message-attachment-error" role="alert">\{error\}</small>\}\line
\line
      \{previewUrl && isImage && (\line
        <img className="message-attachment-preview" src=\{previewUrl\} alt=\{attachment.file_name\} />\line
      )\}\line
      \{previewUrl && isVideo && (\line
        <video className="message-attachment-preview" src=\{previewUrl\} controls preload="metadata">\line
          Your browser does not support video playback.\line
        </video>\line
      )\}\line
      \{previewUrl && isPdf && (\line
        <iframe\line
          className="message-document-preview"\line
          src=\{previewUrl\}\line
          title=\{`Preview of $\{attachment.file_name\}`\}\line
        />\line
      )\}\line
      \{previewUrl && isAudio && (\line
        <div className="message-audio-player">\line
          <audio\line
            ref=\{audioRef\}\line
            src=\{previewUrl\}\line
            preload="metadata"\line
            onLoadedMetadata=\{(event) => setDuration(event.currentTarget.duration || 0)\}\line
            onTimeUpdate=\{(event) => setCurrentTime(event.currentTarget.currentTime)\}\line
            onPlay=\{() => setIsPlaying(true)\}\line
            onPause=\{() => setIsPlaying(false)\}\line
            onEnded=\{() => setIsPlaying(false)\}\line
          >\line
            Your browser does not support audio playback.\line
          </audio>\line
          <button\line
            type="button"\line
            className="message-audio-toggle"\line
            aria-label=\{isPlaying ? "Pause audio" : "Play audio"\}\line
            title=\{isPlaying ? "Pause audio" : "Play audio"\}\line
            onClick=\{toggleAudioPlayback\}\line
          >\line
            \{isPlaying ? (\line
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM15 5h3v14h-3z" /></svg>\line
            ) : (\line
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 12 7-12 7z" /></svg>\line
            )\}\line
          </button>\line
          <input\line
            className="message-audio-progress"\line
            type="range"\line
            min="0"\line
            max=\{duration || 0\}\line
            step="0.1"\line
            value=\{Math.min(currentTime, duration || 0)\}\line
            aria-label="Audio position"\line
            onChange=\{(event) => \{\line
              if (audioRef.current) \{\line
                audioRef.current.currentTime = Number(event.target.value);\line
                setCurrentTime(audioRef.current.currentTime);\line
              \}\line
            \}\}\line
          />\line
          <span className="message-audio-time">\line
            \{formatAudioTime(currentTime)\} / \{formatAudioTime(duration)\}\line
          </span>\line
        </div>\line
      )\}\line
\line
      <div className="message-attachment-file">\line
        <span className="message-attachment-icon" aria-hidden="true">\line
          \{isAudio ? "\u9835?" : isImage || isVideo ? "\u9639?" : "\u9636?"\}\line
        </span>\line
        <span className="message-attachment-details">\line
          <strong>\{attachment.file_name\}</strong>\line
          <small>\{formatFileSize(attachment.file_size)\}\{loading ? " \u183? Loading" : ""\}</small>\line
        </span>\line
        <button\line
          type="button"\line
          className="message-attachment-download-button"\line
          onClick=\{downloadAttachment\}\line
          disabled=\{downloading\}\line
          aria-label=\{`Download $\{attachment.file_name\}`\}\line
        >\line
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">\line
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />\line
            <path d="m7 10 5 5 5-5M12 15V3" />\line
          </svg>\line
        </button>\line
      </div>\line
    </div>\line
  );\line
\}}\par\par
\b src/components/VoiceNoteButton.jsx\b0\par
{\f1\fs15\cf2 import \{ useEffect, useRef, useState \} from "react";\line
\line
function formatDuration(seconds) \{\line
  const minutes = Math.floor(seconds / 60);\line
  return `$\{minutes\}:$\{String(seconds % 60).padStart(2, "0")\}`;\line
\}\line
\line
function getRecordingType() \{\line
  if (typeof MediaRecorder === "undefined" || !MediaRecorder.isTypeSupported) return "";\line
  return [\line
    "audio/webm;codecs=opus",\line
    "audio/mp4",\line
    "audio/ogg;codecs=opus",\line
    "audio/webm",\line
  ].find((type) => MediaRecorder.isTypeSupported(type)) || "";\line
\}\line
\line
export default function VoiceNoteButton(\{ disabled, onSend, onError \}) \{\line
  const [recording, setRecording] = useState(false);\line
  const [seconds, setSeconds] = useState(0);\line
  const recorderRef = useRef(null);\line
  const streamRef = useRef(null);\line
  const chunksRef = useRef([]);\line
  const timerRef = useRef(null);\line
\line
  useEffect(() => () => \{\line
    window.clearInterval(timerRef.current);\line
    if (recorderRef.current) \{\line
      recorderRef.current.onstop = null;\line
      if (recorderRef.current.state !== "inactive") recorderRef.current.stop();\line
    \}\line
    streamRef.current?.getTracks().forEach((track) => track.stop());\line
  \}, []);\line
\line
  async function startRecording() \{\line
    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === "undefined") \{\line
      onError("Voice recording is not supported in this browser.");\line
      return;\line
    \}\line
\line
    try \{\line
      const stream = await navigator.mediaDevices.getUserMedia(\{ audio: true \});\line
      streamRef.current = stream;\line
      const mimeType = getRecordingType();\line
      const recorder = mimeType ? new MediaRecorder(stream, \{ mimeType \}) : new MediaRecorder(stream);\line
      chunksRef.current = [];\line
      recorder.ondataavailable = (event) => \{\line
        if (event.data.size > 0) chunksRef.current.push(event.data);\line
      \};\line
      recorder.onstop = () => \{\line
        const type = recorder.mimeType || chunksRef.current[0]?.type || "audio/webm";\line
        const extension = type.includes("mp4") ? "m4a" : type.includes("ogg") ? "ogg" : "webm";\line
        const file = new File(chunksRef.current, `voice-note.$\{extension\}`, \{ type \});\line
        stream.getTracks().forEach((track) => track.stop());\line
        streamRef.current = null;\line
        recorderRef.current = null;\line
        window.clearInterval(timerRef.current);\line
        setRecording(false);\line
        setSeconds(0);\line
        if (file.size > 0) onSend(file);\line
        else onError("The voice note was empty. Please try recording again.");\line
      \};\line
      recorder.onerror = () => \{\line
        recorder.onstop = null;\line
        stream.getTracks().forEach((track) => track.stop());\line
        streamRef.current = null;\line
        recorderRef.current = null;\line
        window.clearInterval(timerRef.current);\line
        setRecording(false);\line
        setSeconds(0);\line
        onError("Could not record this voice note. Please try again.");\line
      \};\line
      recorder.start();\line
      recorderRef.current = recorder;\line
      setRecording(true);\line
      setSeconds(0);\line
      timerRef.current = window.setInterval(() => setSeconds((value) => value + 1), 1000);\line
    \} catch (recordError) \{\line
      streamRef.current?.getTracks().forEach((track) => track.stop());\line
      streamRef.current = null;\line
      onError(recordError.message || "Microphone access was denied.");\line
    \}\line
  \}\line
\line
  function stopRecording() \{\line
    if (recorderRef.current?.state === "recording") recorderRef.current.stop();\line
  \}\line
\line
  return (\line
    <div className=\{`voice-note-control$\{recording ? " is-recording" : ""\}`\}>\line
      \{recording && <span className="voice-note-timer" aria-live="off">\{formatDuration(seconds)\}</span>\}\line
      <button\line
        type="button"\line
        className="voice-note-button"\line
        aria-label=\{recording ? "Stop and send voice note" : "Record a voice note"\}\line
        title=\{recording ? "Stop and send voice note" : "Record a voice note"\}\line
        disabled=\{disabled\}\line
        onClick=\{recording ? stopRecording : startRecording\}\line
      >\line
        \{recording ? (\line
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">\line
            <rect x="6" y="6" width="12" height="12" rx="2" />\line
          </svg>\line
        ) : (\line
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">\line
            <rect x="9" y="2" width="6" height="12" rx="3" />\line
            <path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3m-4 0h8" />\line
          </svg>\line
        )\}\line
      </button>\line
    </div>\line
  );\line
\}}\par\par
