// Update username\line
app.patch('/api/users/username', authMiddleware, async (req, res) => \{\line
  const \{ username \} = req.body;\line
  if (!username || !username.trim()) \{\line
    return res.status(400).json(\{ message: 'Username is required.' \});\line
  \}\line
  try \{\line
    const existing = await pool.query('SELECT id FROM users WHERE username = $1 AND id != $2', [username, req.userId]);\line
    if (existing.rows.length > 0) \{\line
      return res.status(409).json(\{ message: 'That username is already taken.' \});\line
    \}\line
    await pool.query('UPDATE users SET username = $1 WHERE id = $2', [username, req.userId]);\line
    res.json(\{ username \});\line
  \} catch (err) \{\line
    console.error('Update username error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
// Update email\line
app.patch('/api/users/email', authMiddleware, async (req, res) => \{\line
  const \{ email \} = req.body;\line
  if (!email || !email.trim()) \{\line
    return res.status(400).json(\{ message: 'Email is required.' \});\line
  \}\line
  try \{\line
    const existing = await pool.query('SELECT id FROM users WHERE email = $1 AND id != $2', [email, req.userId]);\line
    if (existing.rows.length > 0) \{\line
      return res.status(409).json(\{ message: 'That email is already in use.' \});\line
    \}\line
    await pool.query('UPDATE users SET email = $1 WHERE id = $2', [email, req.userId]);\line
    res.json(\{ email \});\line
  \} catch (err) \{\line
    console.error('Update email error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
