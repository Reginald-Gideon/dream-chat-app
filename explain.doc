{\f1\fs15\cf2 import \{ useState, useEffect \} from "react";\line
import \{ useNavigate, Link \} from "react-router-dom";\line
import Avatar from "../components/Avatar";\line
import "../css/NewChat.css";\line
\line
export default function UserListPage() \{\line
  const [users, setUsers] = useState([]);\line
  const [friends, setFriends] = useState([]);\line
  const [sentRequests, setSentRequests] = useState([]);\line
  const [activeTab, setActiveTab] = useState("all");\line
  const [busyUserId, setBusyUserId] = useState(null);\line
  const [error, setError] = useState("");\line
  const [search, setSearch] = useState("");\line
  const [loading, setLoading] = useState(true);\line
  const token = localStorage.getItem("token");\line
  const navigate = useNavigate();\line
\line
  async function loadAll() \{\line
    setLoading(true);\line
    setError("");\line
    try \{\line
      const [usersRes, friendsRes] = await Promise.all([\line
        fetch("https://dream-chat-app-1.onrender.com/api/users", \{\line
          headers: \{ Authorization: `Bearer $\{token\}` \},\line
        \}),\line
        fetch("https://dream-chat-app-1.onrender.com/api/friends", \{\line
          headers: \{ Authorization: `Bearer $\{token\}` \},\line
        \}),\line
      ]);\line
      if (!usersRes.ok || !friendsRes.ok) throw new Error("Failed to load users.");\line
      const usersData = await usersRes.json();\line
      const friendsData = await friendsRes.json();\line
      setUsers(usersData);\line
      setFriends(friendsData);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \} finally \{\line
      setLoading(false);\line
    \}\line
  \}\line
\line
  useEffect(() => \{\line
    loadAll();\line
    // eslint-disable-next-line react-hooks/exhaustive-deps\line
  \}, [token]);\line
\line
  async function sendRequest(addresseeId) \{\line
    setBusyUserId(addresseeId);\line
    setError("");\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/friends/request", \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ addresseeId \}),\line
      \});\line
      if (!response.ok) \{\line
        const data = await response.json().catch(() => (\{\}));\line
        throw new Error(data.message || "Failed to send request.");\line
      \}\line
      setSentRequests((prev) => [...new Set([...prev, String(addresseeId)])]);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \} finally \{\line
      setBusyUserId(null);\line
    \}\line
  \}\line
\line
  async function openConversation(otherUserId) \{\line
    setBusyUserId(otherUserId);\line
    setError("");\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/conversations", \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ otherUserId \}),\line
      \});\line
      if (!response.ok) \{\line
        const data = await response.json().catch(() => (\{\}));\line
        throw new Error(data.message || "Failed to start conversation.");\line
      \}\line
      const conversation = await response.json();\line
      navigate(`/chat/$\{conversation.id\}`);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \} finally \{\line
      setBusyUserId(null);\line
    \}\line
  \}\line
\line
  const friendIds = new Set(friends.map((friend) => String(friend.id)));\line
  const normalizedSearch = search.trim().toLowerCase();\line
  const filtered = users.filter((user) => \{\line
    const matchesSearch = (user.username || "").toLowerCase().includes(normalizedSearch);\line
    const isFriend = friendIds.has(String(user.id));\line
    return matchesSearch && (activeTab === "all" || (activeTab === "friends" ? isFriend : !isFriend));\line
  \});\line
\line
  return (\line
    <div className="newchat-page">\line
      <header className="newchat-heading">\line
        <div className="newchat-heading-copy">\line
          <span className="newchat-eyebrow">MESSAGES</span>\line
          <h1 className="newchat-title">Start a conversation</h1>\line
          <p className="newchat-subtitle">Find a friend to message or bring everyone together in a group.</p>\line
        </div>\line
        <Link to="/chat" className="newchat-back-link">\u8592? Back to chats</Link>\line
      </header>\line
\line
      <section className="newchat-discovery" aria-label="Find people to chat with">\line
      <label className="newchat-search">\line
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.2 4.2" /></svg>\line
        <input\line
          type="search"\line
          placeholder="Search name or username"\line
          value=\{search\}\line
          onChange=\{(e) => setSearch(e.target.value)\}\line
          aria-label="Search people"\line
        />\line
        \{search && <button type="button" onClick=\{() => setSearch("")\} aria-label="Clear search">\u215?</button>\}\line
      </label>\line
\line
      <div className="newchat-tabs" role="tablist" aria-label="People">\line
        <button type="button" role="tab" aria-selected=\{activeTab === "all"\} className=\{activeTab === "all" ? "active" : ""\} onClick=\{() => setActiveTab("all")\}>\line
          Everyone <span>\{users.length\}</span>\line
        </button>\line
        <button type="button" role="tab" aria-selected=\{activeTab === "friends"\} className=\{activeTab === "friends" ? "active" : ""\} onClick=\{() => setActiveTab("friends")\}>\line
          Friends <span>\{friends.length\}</span>\line
        </button>\line
        <button type="button" role="tab" aria-selected=\{activeTab === "discover"\} className=\{activeTab === "discover" ? "active" : ""\} onClick=\{() => setActiveTab("discover")\}>\line
          Discover <span>\{Math.max(0, users.length - friends.length)\}</span>\line
        </button>\line
      </div>\line
\line
      \{error && <div className="newchat-error" role="alert"><span>\{error\}</span><button type="button" onClick=\{loadAll\}>Try again</button></div>\}\line
\line
      <div className="newchat-results-heading">\line
        <div>\line
          <h2>\{activeTab === "friends" ? "Your friends" : activeTab === "discover" ? "People to meet" : "People"\}</h2>\line
          <p>\{activeTab === "friends" ? "Pick a friend and get back in touch." : "Choose someone to message or send a friend request."\}</p>\line
        </div>\line
        <span>\{loading ? "Loading\u8230?" : `$\{filtered.length\} $\{filtered.length === 1 ? "person" : "people"\}`\}</span>\line
      </div>\line
\line
      \{loading ? (\line
        <div className="newchat-loading" role="status"><span className="newchat-spinner" /> Loading people\u8230?</div>\line
      ) : filtered.length === 0 ? (\line
        <div className="newchat-empty">\line
          <span className="newchat-empty-icon" aria-hidden="true">\{search ? "\u8981?" : activeTab === "friends" ? "\u9825?" : "\u10022?"\}</span>\line
          <strong>\{search ? "No matches found" : activeTab === "friends" ? "No friends yet" : "No one to show yet"\}</strong>\line
          <span>\{search ? "Try a different name or username." : activeTab === "friends" ? "Add people from Discover to start chatting." : "Check back later to find people to chat with."\}</span>\line
          \{search && <button type="button" onClick=\{() => setSearch("")\}>Clear search</button>\}\line
        </div>\line
      ) : (\line
        <ul className="newchat-list">\line
          \{filtered.map((u) => \{\line
            const isFriend = friendIds.has(String(u.id));\line
            const requestSent = sentRequests.includes(String(u.id));\line
            const busy = String(busyUserId) === String(u.id);\line
\line
            return (\line
              <li key=\{u.id\} className="newchat-person">\line
                <Avatar src=\{u.avatar\} name=\{u.username\} className="newchat-avatar" />\line
                <div className="newchat-person-copy">\line
                  <strong>\{u.username\}</strong>\line
                  <span>\{isFriend ? "Friend" : requestSent ? "Friend request sent" : "Not connected yet"\}</span>\line
                </div>\line
                \{isFriend ? (\line
                  <button className="newchat-action message" onClick=\{() => openConversation(u.id)\} disabled=\{busy\}>\line
                    \{busy ? "Opening\u8230?" : "Message"\}\line
                  </button>\line
                ) : requestSent ? (\line
                  <button type="button" className="newchat-action sent" disabled>\line
                    <span aria-hidden="true">\u10003?</span> Request sent\line
                  </button>\line
                ) : (\line
                  <button className="newchat-action add" onClick=\{() => sendRequest(u.id)\} disabled=\{busy\}>\line
                    \{busy ? "Sending\u8230?" : "Add friend"\}\line
                  </button>\line
                )\}\line
              </li>\line
            );\line
          \})\}\line
        </ul>\line
      )\}\line
      </section>\line
\line
      <section className="newchat-group-shortcuts" aria-label="Group chats">\line
        <div className="newchat-group-copy">\line
          <span className="newchat-shortcut-icon group" aria-hidden="true">\u10022?</span>\line
          <span><strong>Want to chat with everyone?</strong><small>Create a group or open one you already belong to.</small></span>\line
        </div>\line
        <div className="newchat-group-actions">\line
          <Link to="/create-group">Create group</Link>\line
          <Link to="/groups">My groups <span aria-hidden="true">\u8594?</span></Link>\line
        </div>\line
      </section>\line
    </div>\line
  );\line
\}}\par\par
\b src/pages/CreateGroup.jsx\b0\par
{\f1\fs15\cf2 import \{ useCallback, useEffect, useMemo, useState \} from "react";\line
import \{ Link, useNavigate \} from "react-router-dom";\line
import Avatar from "../components/Avatar";\line
import "../css/CreateGroup.css";\line
\line
const API_URL = "https://dream-chat-app-1.onrender.com";\line
\line
export default function CreateGroup() \{\line
  const [friends, setFriends] = useState([]);\line
  const [selectedIds, setSelectedIds] = useState([]);\line
  const [groupName, setGroupName] = useState("");\line
  const [search, setSearch] = useState("");\line
  const [error, setError] = useState("");\line
  const [loading, setLoading] = useState(true);\line
  const [creating, setCreating] = useState(false);\line
  const navigate = useNavigate();\line
  const token = localStorage.getItem("token");\line
\line
  const fetchFriends = useCallback(async () => \{\line
    setLoading(true);\line
    setError("");\line
    try \{\line
      const response = await fetch(`$\{API_URL\}/api/friends`, \{\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      const data = await response.json().catch(() => null);\line
      if (!response.ok) throw new Error(data?.message || "Could not load your friends.");\line
      if (!Array.isArray(data)) throw new Error("The friends list response was invalid.");\line
      setFriends(data);\line
    \} catch (fetchError) \{\line
      setError(fetchError.message || "Could not load your friends.");\line
    \} finally \{\line
      setLoading(false);\line
    \}\line
  \}, [token]);\line
\line
  useEffect(() => \{\line
    fetchFriends();\line
  \}, [fetchFriends]);\line
\line
  function toggleFriend(id) \{\line
    const normalizedId = String(id);\line
    setSelectedIds((previous) => (\line
      previous.includes(normalizedId)\line
        ? previous.filter((selectedId) => selectedId !== normalizedId)\line
        : [...previous, normalizedId]\line
    ));\line
  \}\line
\line
  async function handleCreate() \{\line
    const name = groupName.trim();\line
    if (!name) \{\line
      setError("Add a name for your group.");\line
      return;\line
    \}\line
    if (selectedIds.length === 0) \{\line
      setError("Select at least one friend to add to the group.");\line
      return;\line
    \}\line
\line
    setCreating(true);\line
    setError("");\line
    try \{\line
      const response = await fetch(`$\{API_URL\}/api/groups`, \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ name, memberIds: selectedIds \}),\line
      \});\line
      const group = await response.json().catch(() => null);\line
      if (!response.ok) throw new Error(group?.message || "Could not create the group.");\line
      if (!group?.id) throw new Error("The group was created, but its chat could not be opened.");\line
      navigate(`/group/$\{group.id\}`);\line
    \} catch (createError) \{\line
      setError(createError.message || "Could not create the group.");\line
    \} finally \{\line
      setCreating(false);\line
    \}\line
  \}\line
\line
  const selectedFriends = useMemo(\line
    () => friends.filter((friend) => selectedIds.includes(String(friend.id))),\line
    [friends, selectedIds]\line
  );\line
  const filteredFriends = useMemo(() => \{\line
    const query = search.trim().toLowerCase();\line
    return friends.filter((friend) => (friend.username || "").toLowerCase().includes(query));\line
  \}, [friends, search]);\line
\line
  return (\line
    <main className="create-group-page">\line
      <header className="create-group-heading">\line
        <div>\line
          <span className="create-group-eyebrow">GROUP CHAT</span>\line
          <h1>Create a group</h1>\line
          <p>Give your group a name, then choose the friends you want to bring together.</p>\line
        </div>\line
        <Link to="/chat" className="create-group-back">\u8592? Back to chats</Link>\line
      </header>\line
\line
      <div className="create-group-layout">\line
        <section className="create-group-form-card" aria-label="Group details">\line
          <div className="create-group-card-heading">\line
            <span className="create-group-icon" aria-hidden="true">\u10022?</span>\line
            <div>\line
              <h2>Group details</h2>\line
              <p>Make it easy for friends to recognize.</p>\line
            </div>\line
          </div>\line
          <label className="create-group-name-label" htmlFor="group-name">Group name</label>\line
          <input\line
            id="group-name"\line
            className="create-group-name-input"\line
            type="text"\line
            placeholder="e.g. Weekend plans"\line
            value=\{groupName\}\line
            maxLength=\{60\}\line
            onChange=\{(event) => setGroupName(event.target.value)\}\line
            onKeyDown=\{(event) => \{\line
              if (event.key === "Enter" && !creating) handleCreate();\line
            \}\}\line
          />\line
          <span className="create-group-character-count">\{groupName.length\}/60</span>\line
\line
          <div className="create-group-selection-heading">\line
            <div>\line
              <h2>Add friends</h2>\line
              <p>\{friends.length\} \{friends.length === 1 ? "friend" : "friends"\} available</p>\line
            </div>\line
            <span className="create-group-selected-count">\{selectedIds.length\} selected</span>\line
          </div>\line
\line
          \{selectedFriends.length > 0 && (\line
            <div className="create-group-selected-list" aria-label="Selected friends">\line
              \{selectedFriends.map((friend) => (\line
                <button\line
                  type="button"\line
                  key=\{friend.id\}\line
                  className="create-group-selected-chip"\line
                  onClick=\{() => toggleFriend(friend.id)\}\line
                  aria-label=\{`Remove $\{friend.username\} from selection`\}\line
                >\line
                  <Avatar src=\{friend.avatar\} name=\{friend.username\} className="create-group-chip-avatar" />\line
                  <span>\{friend.username\}</span>\line
                  <span aria-hidden="true">\u215?</span>\line
                </button>\line
              ))\}\line
            </div>\line
          )\}\line
\line
          <label className="create-group-search">\line
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.2 4.2" /></svg>\line
            <input\line
              type="search"\line
              placeholder="Search your friends"\line
              value=\{search\}\line
              onChange=\{(event) => setSearch(event.target.value)\}\line
              aria-label="Search friends to add"\line
            />\line
            \{search && <button type="button" onClick=\{() => setSearch("")\} aria-label="Clear search">\u215?</button>\}\line
          </label>\line
\line
          \{error && <p className="create-group-error" role="alert">\{error\}</p>\}\line
\line
          \{loading ? (\line
            <div className="create-group-state" role="status"><span className="create-group-spinner" /> Loading friends\u8230?</div>\line
          ) : friends.length === 0 && !error ? (\line
            <div className="create-group-state">\line
              <strong>No friends to add yet</strong>\line
              <span>Add some friends first, then come back to create a group.</span>\line
              <Link to="/new">Find friends</Link>\line
            </div>\line
          ) : filteredFriends.length === 0 ? (\line
            <div className="create-group-state">\line
              <strong>No matching friends</strong>\line
              <span>Try another name or username.</span>\line
              <button type="button" onClick=\{() => setSearch("")\}>Clear search</button>\line
            </div>\line
          ) : (\line
            <ul className="create-group-friend-list">\line
              \{filteredFriends.map((friend) => \{\line
                const selected = selectedIds.includes(String(friend.id));\line
                return (\line
                  <li key=\{friend.id\}>\line
                    <button\line
                      type="button"\line
                      className=\{`create-group-friend$\{selected ? " selected" : ""\}`\}\line
                      onClick=\{() => toggleFriend(friend.id)\}\line
                      aria-pressed=\{selected\}\line
                    >\line
                      <Avatar src=\{friend.avatar\} name=\{friend.username\} className="create-group-friend-avatar" />\line
                      <span className="create-group-friend-copy">\line
                        <strong>\{friend.username\}</strong>\line
                        <small>\{selected ? "Added to this group" : "Friend"\}</small>\line
                      </span>\line
                      <span className="create-group-check" aria-hidden="true">\{selected ? "\u10003?" : "+"\}</span>\line
                    </button>\line
                  </li>\line
                );\line
              \})\}\line
            </ul>\line
          )\}\line
\line
          <button\line
            type="button"\line
            className="create-group-submit"\line
            onClick=\{handleCreate\}\line
            disabled=\{loading || creating || !groupName.trim() || selectedIds.length === 0\}\line
          >\line
            \{creating ? "Creating group\u8230?" : `Create group$\{selectedIds.length ? ` \u183? $\{selectedIds.length\}` : ""\}`\}\line
          </button>\line
        </section>\line
\line
        <aside className="create-group-preview" aria-label="Group preview">\line
          <div className="create-group-preview-art" aria-hidden="true">\line
            <span>\u10022?</span><span>\u10023?</span><span>\u10022?</span>\line
            <div className="create-group-preview-avatar">\u-10179?</div>\line
          </div>\line
          <span className="create-group-preview-label">YOUR NEW GROUP</span>\line
          <h2>\{groupName.trim() || "Group name"\}</h2>\line
          <p>\{selectedIds.length + 1\} \{selectedIds.length + 1 === 1 ? "member" : "members"\} including you</p>\line
          \{selectedFriends.length > 0 && (\line
            <div className="create-group-preview-members">\line
              \{selectedFriends.slice(0, 5).map((friend) => (\line
                <Avatar\line
                  key=\{friend.id\}\line
                  src=\{friend.avatar\}\line
                  name=\{friend.username\}\line
                  className="create-group-preview-avatar-member"\line
                />\line
              ))\}\line
              \{selectedFriends.length > 5 && <span>+\{selectedFriends.length - 5\}</span>\}\line
            </div>\line
          )\}\line
          <div className="create-group-preview-note">\line
            <span aria-hidden="true">\u-10179?</span>\line
            <span>Only friends you select will be added to this conversation.</span>\line
          </div>\line
        </aside>\line
      </div>\line
    </main>\line
  );\line
\}}\par\par
\b src/pages/Feed.jsx\b0\par
{\f1\fs15\cf2 import \{ useState, useEffect, useRef \} from "react";\line
import \{ useLocation \} from "react-router-dom";\line
import \{ resizeImage \} from "../resizeImage";\line
import UserAvatarMenu from "../components/UserAvatarMenu";\line
import "../css/Feed.css";\line
import StatusBar from "./Statusbar.jsx";\line
function Icon(\{ name, size = 24, filled = false \}) \{\line
  const common = \{\line
    width: size,\line
    height: size,\line
    viewBox: "0 0 24 24",\line
    fill: "none",\line
    stroke: "currentColor",\line
    strokeWidth: 1.9,\line
    strokeLinecap: "round",\line
    strokeLinejoin: "round",\line
    "aria-hidden": true,\line
  \};\line
\line
  if (name === "heart") return <svg \{...common\}><path d="M20.8 8.7c0 4.3-8.8 10-8.8 10s-8.8-5.7-8.8-10A4.7 4.7 0 0 1 12 6.2a4.7 4.7 0 0 1 8.8 2.5Z" fill=\{filled ? "currentColor" : "none"\} /></svg>;\line
  if (name === "comment") return <svg \{...common\}><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z" /></svg>;\line
  if (name === "image") return <svg \{...common\}><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>;\line
  if (name === "smile") return <svg \{...common\}><circle cx="12" cy="12" r="9" /><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" /></svg>;\line
  return null;\line
\}\line
\line
function timeAgo(timestamp) \{\line
  const diffMs = Date.now() - new Date(timestamp).getTime();\line
  const mins = Math.floor(diffMs / 60000);\line
  if (mins < 1) return "just now";\line
  if (mins < 60) return `$\{mins\}m ago`;\line
  const hrs = Math.floor(mins / 60);\line
  if (hrs < 24) return `$\{hrs\}h ago`;\line
  return `$\{Math.floor(hrs / 24)\}d ago`;\line
\}\line
\line
function Avatar(\{ src, name, className \}) \{\line
  if (src) return <img className=\{className\} src=\{src\} alt=\{name\} style=\{\{ objectFit: "cover" \}\} />;\line
  return (\line
    <div className=\{className\} style=\{\{ display: "flex", alignItems: "center", justifyContent: "center", background: "#2563EB", color: "#fff", fontWeight: 700, fontSize: 13 \}\}>\line
      \{name ? name.slice(0, 2).toUpperCase() : "?"\}\line
    </div>\line
  );\line
\}\line
\line
export default function Feed() \{\line
  const location = useLocation();\line
  const [posts, setPosts] = useState([]);\line
  const [highlightedPostId, setHighlightedPostId] = useState(null);\line
  const [error, setError] = useState("");\line
  const [expandedComments, setExpandedComments] = useState(\{\}); // \{ postId: [comments] \}\line
  const [commentDraft, setCommentDraft] = useState(\{\}); // \{ postId: text \}\line
\line
  const [composerOpen, setComposerOpen] = useState(false);\line
  const [caption, setCaption] = useState("");\line
  const [imagePreview, setImagePreview] = useState(null);\line
  const [posting, setPosting] = useState(false);\line
  const fileInputRef = useRef(null);\line
\line
  const [friends, setFriends] = useState([]);\line
\line
  const user = JSON.parse(localStorage.getItem("user"));\line
  const token = localStorage.getItem("token");\line
\line
  async function fetchPosts() \{\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/posts", \{\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      if (!response.ok) throw new Error("Failed to load feed.");\line
      const data = await response.json();\line
      setPosts(data);\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
\line
  async function fetchFriends() \{\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/friends", \{\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      if (response.ok) setFriends(await response.json());\line
    \} catch \{\line
      // non-critical\line
    \}\line
  \}\line
\line
  useEffect(() => \{\line
    fetchPosts();\line
    fetchFriends();\line
    // eslint-disable-next-line react-hooks/exhaustive-deps\line
  \}, []);\line
\line
  useEffect(() => \{\line
    const match = location.hash.match(/^#post-(.+)$/);\line
    if (!match || posts.length === 0) return;\line
\line
    const postId = match[1];\line
    const postElement = document.getElementById(`feed-post-$\{postId\}`);\line
    if (!postElement) return;\line
\line
    setHighlightedPostId(postId);\line
    postElement.scrollIntoView(\{ behavior: "smooth", block: "center" \});\line
    const timeoutId = window.setTimeout(() => setHighlightedPostId(null), 4000);\line
    return () => window.clearTimeout(timeoutId);\line
  \}, [location.hash, posts.length]);\line
\line
  async function toggleLike(postId) \{\line
    // optimistic update\line
    setPosts((prev) =>\line
      prev.map((p) =>\line
        p.id === postId\line
          ? \{\line
              ...p,\line
              liked_by_me: !p.liked_by_me,\line
              like_count: Number(p.like_count) + (p.liked_by_me ? -1 : 1),\line
            \}\line
          : p\line
      )\line
    );\line
    try \{\line
      await fetch(`https://dream-chat-app-1.onrender.com/api/posts/$\{postId\}/like`, \{\line
        method: "POST",\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
    \} catch \{\line
      fetchPosts(); // revert by re-syncing if the request failed\line
    \}\line
  \}\line
\line
  async function loadComments(postId) \{\line
    if (expandedComments[postId]) \{\line
      // already loaded \u8212? just toggle closed\line
      setExpandedComments((prev) => \{\line
        const next = \{ ...prev \};\line
        delete next[postId];\line
        return next;\line
      \});\line
      return;\line
    \}\line
    try \{\line
      const response = await fetch(`https://dream-chat-app-1.onrender.com/api/posts/$\{postId\}/comments`, \{\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      const data = await response.json();\line
      setExpandedComments((prev) => (\{ ...prev, [postId]: data \}));\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
\line
  async function submitComment(e, postId) \{\line
    e.preventDefault();\line
    const text = (commentDraft[postId] || "").trim();\line
    if (!text) return;\line
\line
    try \{\line
      const response = await fetch(`https://dream-chat-app-1.onrender.com/api/posts/$\{postId\}/comments`, \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ content: text \}),\line
      \});\line
      if (!response.ok) throw new Error("Failed to post comment.");\line
      const newComment = await response.json();\line
\line
      setExpandedComments((prev) => (\{\line
        ...prev,\line
        [postId]: [...(prev[postId] || []), newComment],\line
      \}));\line
      setCommentDraft((prev) => (\{ ...prev, [postId]: "" \}));\line
      setPosts((prev) =>\line
        prev.map((p) => (p.id === postId ? \{ ...p, comment_count: Number(p.comment_count) + 1 \} : p))\line
      );\line
    \} catch (err) \{\line
      setError(err.message);\line
    \}\line
  \}\line
\line
  async function handleImagePick(e) \{\line
    const file = e.target.files[0];\line
    if (!file) return;\line
    const resized = await resizeImage(file, 600);\line
    setImagePreview(resized);\line
  \}\line
\line
  async function handleCreatePost(e) \{\line
    e.preventDefault();\line
    if (!caption.trim() && !imagePreview) return;\line
\line
    setPosting(true);\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/posts", \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ caption, imageUrl: imagePreview \}),\line
      \});\line
      if (!response.ok) throw new Error("Failed to create post.");\line
      setCaption("");\line
      setImagePreview(null);\line
      setComposerOpen(false);\line
      fetchPosts();\line
    \} catch (err) \{\line
      setError(err.message);\line
    \} finally \{\line
      setPosting(false);\line
    \}\line
  \}\line
\line
  return (\line
    <main className="feed-page">\line
      <div className="feed-layout">\line
        <section className="feed-main" aria-label="Feed">\line
          \{/* --- New post composer --- */\}\line
          <section className="stories-panel">\line
            \{!composerOpen ? (\line
              <button\line
                className="icon-button"\line
                style=\{\{ width: "100%", display: "flex", alignItems: "center", gap: 10, padding: "8px 4px", justifyContent: "flex-start" \}\}\line
                onClick=\{() => setComposerOpen(true)\}\line
              >\line
                <Avatar src=\{user?.avatar\} name=\{user?.username\} className="post-avatar" />\line
                <span style=\{\{ color: "var(--feed-muted)", fontSize: 13 \}\}>Share something...</span>\line
              </button>\line
            ) : (\line
              <form onSubmit=\{handleCreatePost\}>\line
                <textarea\line
                  value=\{caption\}\line
                  onChange=\{(e) => setCaption(e.target.value)\}\line
                  placeholder="What's on your mind?"\line
                  rows=\{3\}\line
                  style=\{\{\line
                    width: "100%",\line
                    background: "transparent",\line
                    border: "1px solid var(--feed-line)",\line
                    borderRadius: 8,\line
                    color: "var(--feed-ink)",\line
                    padding: 10,\line
                    fontFamily: "inherit",\line
                    fontSize: 13,\line
                    resize: "vertical",\line
                  \}\}\line
                />\line
                \{imagePreview && (\line
                  <img src=\{imagePreview\} alt="" style=\{\{ width: "100%", borderRadius: 8, marginTop: 8 \}\} />\line
                )\}\line
                <div style=\{\{ display: "flex", alignItems: "center", justifyContent: "space-between", marginTop: 8 \}\}>\line
                  <div style=\{\{ display: "flex", gap: 6 \}\}>\line
                    <button type="button" className="icon-button" onClick=\{() => fileInputRef.current?.click()\}>\line
                      <Icon name="image" />\line
                    </button>\line
                    <input\line
                      ref=\{fileInputRef\}\line
                      type="file"\line
                      accept="image/*"\line
                      onChange=\{handleImagePick\}\line
                      style=\{\{ display: "none" \}\}\line
                    />\line
                  </div>\line
                  <div style=\{\{ display: "flex", gap: 8 \}\}>\line
                    <button\line
                      type="button"\line
                      className="follow-label"\line
                      onClick=\{() => \{\line
                        setComposerOpen(false);\line
                        setCaption("");\line
                        setImagePreview(null);\line
                      \}\}\line
                    >\line
                      Cancel\line
                    </button>\line
                    <button type="submit" className="follow-label" disabled=\{posting\}>\line
                      \{posting ? "Posting..." : "Post"\}\line
                    </button>\line
                  </div>\line
                </div>\line
              </form>\line
            )\}\line
          </section>\line
\line
          \{error && <p style=\{\{ color: "#ff5b74", fontSize: 13, margin: "12px 0" \}\}>\{error\}</p>\}\line
\line
          \{/* --- Posts --- */\}\line
          <div className="post-list">\line
            \{posts.length === 0 && !error && (\line
              <p style=\{\{ color: "var(--feed-muted)", fontSize: 13, textAlign: "center", padding: "30px 0" \}\}>\line
                No posts yet. Be the first to share something.\line
              </p>\line
            )\}\line
\line
            \{posts.map((post) => \{\line
              const comments = expandedComments[post.id];\line
\line
              return (\line
                <article\line
                  className=\{`feed-post$\{String(highlightedPostId) === String(post.id) ? " feed-post-highlighted" : ""\}`\}\line
                  id=\{`feed-post-$\{post.id\}`\}\line
                  key=\{post.id\}\line
                >\line
                  <header className="post-header">\line
                    <div className="post-author">\line
                      <UserAvatarMenu userId=\{post.user_id\} src=\{post.avatar\} name=\{post.username\}>\line
                        <Avatar src=\{post.avatar\} name=\{post.username\} className="post-avatar" />\line
                      </UserAvatarMenu>\line
                      <div className="post-author-copy">\line
                        <strong>\{post.username\}</strong>\line
                        <span>\{timeAgo(post.created_at)\}</span>\line
                      </div>\line
                    </div>\line
                  </header>\line
\line
                  \{post.image_url && <img className="post-image" src=\{post.image_url\} alt="" />\}\line
\line
                  <div className="post-details">\line
                    <div className="post-actions">\line
                      <div className="post-actions-left">\line
                        <button\line
                          className=\{`icon-button like-button$\{post.liked_by_me ? " liked" : ""\}`\}\line
                          onClick=\{() => toggleLike(post.id)\}\line
                        >\line
                          <Icon name="heart" filled=\{post.liked_by_me\} />\line
                        </button>\line
                        <button className="icon-button" onClick=\{() => loadComments(post.id)\}>\line
                          <Icon name="comment" />\line
                        </button>\line
                      </div>\line
                    </div>\line
\line
                    <strong className="post-likes">\{Number(post.like_count)\} likes</strong>\line
                    \{post.caption && (\line
                      <p className="post-caption">\line
                        <strong>\{post.username\}</strong> \{post.caption\}\line
                      </p>\line
                    )\}\line
\line
                    <button\line
                      className="post-comments"\line
                      style=\{\{ background: "none", border: "none", cursor: "pointer", padding: 0, textAlign: "left" \}\}\line
                      onClick=\{() => loadComments(post.id)\}\line
                    >\line
                      \{comments ? "Hide comments" : `View all $\{Number(post.comment_count)\} comments`\}\line
                    </button>\line
\line
                    \{comments &&\line
                      comments.map((c) => (\line
                        <p className="posted-comment" key=\{c.id\}>\line
                          <strong>\{c.username\}</strong> \{c.content\}\line
                        </p>\line
                      ))\}\line
\line
                    <span className="post-time">\{timeAgo(post.created_at)\}</span>\line
\line
                    <form className="comment-entry" onSubmit=\{(e) => submitComment(e, post.id)\}>\line
                      <Avatar src=\{user?.avatar\} name=\{user?.username\} className="post-avatar" />\line
                      <input\line
                        type="text"\line
                        value=\{commentDraft[post.id] || ""\}\line
                        onChange=\{(e) =>\line
                          setCommentDraft((prev) => (\{ ...prev, [post.id]: e.target.value \}))\line
                        \}\line
                        placeholder="Add a comment..."\line
                      />\line
                      \{(commentDraft[post.id] || "").trim() && (\line
                        <button className="comment-submit" type="submit">Post</button>\line
                      )\}\line
                    </form>\line
                  </div>\line
                </article>\line
              );\line
            \})\}\line
          </div>\line
        </section>\line
\line
        <aside className="feed-rail" aria-label="Your account">\line
              <div className="current-account">\line
            <Avatar src=\{user?.avatar\} name=\{user?.username\} className="post-avatar" style=\{\{ width: 43, height: 43 \}\} />\line
            <div className="account-copy">\line
              <strong>@\{user?.username\}</strong>\line
              <span>\{user?.email\}</span>\line
            </div>\line
          </div>\line
\line
          <section className="stories-panel feed-stories" aria-label="Stories">\line
            <StatusBar />\line
          </section>\line
\line
        \line
          <section className="suggestions-panel">\line
            <div className="suggestions-heading">\line
              <h2>Your friends</h2>\line
            </div>\line
            <div className="suggestion-list">\line
              \{friends.length === 0 && (\line
                <p style=\{\{ color: "var(--feed-muted)", fontSize: 12 \}\}>No friends yet.</p>\line
              )\}\line
              \{friends.map((f) => (\line
                <div className="suggestion-row" key=\{f.id\}>\line
                  <UserAvatarMenu userId=\{f.id\} src=\{f.avatar\} name=\{f.username\}>\line
                    <Avatar src=\{f.avatar\} name=\{f.username\} className="post-avatar" />\line
                  </UserAvatarMenu>\line
                  <div className="suggestion-copy">\line
                    <strong>\{f.username\}</strong>\line
                  </div>\line
                </div>\line
              ))\}\line
            </div>\line
          </section>\line
        </aside>\line
      </div>\line
    </main>\line
  );\line
\}}\par\par
\b src/pages/Statusbar.jsx\b0\par
{\f1\fs15\cf2 import \{ useState, useEffect, useRef, useCallback, useMemo \} from "react";\line
import \{ resizeImage \} from "../resizeImage";\line
import \{ useLocation \} from "react-router-dom";\line
import UserAvatarMenu from "../components/UserAvatarMenu";\line
import "../css/StatusBar.css";\line
\line
const COLORS = ["#4C3BCF", "#0F766E", "#B91C63", "#1D4ED8", "#171717"];\line
\line
function getInitials(name) \{\line
  return name ? name.slice(0, 2).toUpperCase() : "?";\line
\}\line
\line
export default function StatusBar() \{\line
  const location = useLocation();\line
  const [statuses, setStatuses] = useState([]);\line
  const [statusesLoaded, setStatusesLoaded] = useState(false);\line
  const [viewerGroup, setViewerGroup] = useState(null); // array of that user's statuses being viewed\line
  const [viewerIndex, setViewerIndex] = useState(0);\line
\line
  const [composerOpen, setComposerOpen] = useState(false);\line
  const [text, setText] = useState("");\line
  const [color, setColor] = useState(COLORS[0]);\line
  const [imagePreview, setImagePreview] = useState(null);\line
  const [posting, setPosting] = useState(false);\line
  const [replyText, setReplyText] = useState("");\line
  const [replySending, setReplySending] = useState(false);\line
  const [replyMessage, setReplyMessage] = useState("");\line
  const [statusError, setStatusError] = useState("");\line
  const [statusLinkMessage, setStatusLinkMessage] = useState("");\line
  const handledStatusUser = useRef("");\line
  const fileInputRef = useRef(null);\line
\line
  const user = JSON.parse(localStorage.getItem("user"));\line
  const token = localStorage.getItem("token");\line
\line
  const fetchStatuses = useCallback(async () => \{\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/statuses", \{\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      if (response.ok) setStatuses(await response.json());\line
      else setStatusError("Could not load statuses.");\line
    \} catch \{\line
      setStatusError("Could not load statuses.");\line
    \} finally \{\line
      setStatusesLoaded(true);\line
    \}\line
  \}, [token]);\line
\line
  useEffect(() => \{\line
    fetchStatuses();\line
  \}, [fetchStatuses]);\line
\line
  const groups = useMemo(() => \{\line
    const grouped = statuses.reduce((acc, status) => \{\line
      if (!acc[status.user_id]) \{\line
        acc[status.user_id] = \{\line
          user_id: status.user_id,\line
          username: status.username,\line
          avatar: status.avatar,\line
          items: [],\line
        \};\line
      \}\line
      acc[status.user_id].items.push(status);\line
      return acc;\line
    \}, \{\});\line
    return Object.values(grouped);\line
  \}, [statuses]);\line
  const ownStatusGroup = groups.find((group) => Number(group.user_id) === Number(user?.id));\line
\line
  const markViewed = useCallback(async (statusId) => \{\line
    const status = statuses.find((item) => item.id === statusId);\line
    if (Number(status?.user_id) === Number(user?.id)) return;\line
\line
    try \{\line
      await fetch(`https://dream-chat-app-1.onrender.com/api/statuses/$\{statusId\}/view`, \{\line
        method: "POST",\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      setStatuses((prev) => prev.map((item) => (\line
        item.id === statusId ? \{ ...item, viewed_by_me: true \} : item\line
      )));\line
    \} catch \{\line
      // Marking a status as viewed is non-critical.\line
    \}\line
  \}, [statuses, token, user?.id]);\line
\line
  const openGroup = useCallback((group) => \{\line
    setViewerGroup(group.items);\line
    setViewerIndex(0);\line
    setReplyText("");\line
    setReplyMessage("");\line
    setStatusError("");\line
    if (Number(group.user_id) !== Number(user?.id)) markViewed(group.items[0].id);\line
  \}, [markViewed, user?.id]);\line
\line
  useEffect(() => \{\line
    const requestedUserId = new URLSearchParams(location.search).get("statusUser");\line
    if (!requestedUserId || !statusesLoaded || handledStatusUser.current === requestedUserId) return;\line
    handledStatusUser.current = requestedUserId;\line
    const requestedGroup = groups.find((group) => String(group.user_id) === requestedUserId);\line
    if (requestedGroup) \{\line
      setStatusLinkMessage("");\line
      openGroup(requestedGroup);\line
    \} else \{\line
      setStatusLinkMessage("This user has no active status to view.");\line
    \}\line
  \}, [groups, location.search, openGroup, statusesLoaded]);\line
\line
  function nextStory() \{\line
    if (viewerIndex + 1 < viewerGroup.length) \{\line
      const next = viewerIndex + 1;\line
      setViewerIndex(next);\line
      markViewed(viewerGroup[next].id);\line
    \} else \{\line
      setViewerGroup(null);\line
    \}\line
  \}\line
\line
  function prevStory() \{\line
    if (viewerIndex > 0) setViewerIndex(viewerIndex - 1);\line
  \}\line
\line
  async function handleStatusReply(event) \{\line
    event.preventDefault();\line
    const message = replyText.trim();\line
    const status = viewerGroup?.[viewerIndex];\line
    if (!message || !status || Number(status.user_id) === Number(user?.id)) return;\line
\line
    setReplySending(true);\line
    setStatusError("");\line
    setReplyMessage("");\line
    try \{\line
      const conversationResponse = await fetch("https://dream-chat-app-1.onrender.com/api/conversations", \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ otherUserId: status.user_id \}),\line
      \});\line
      const conversationData = await conversationResponse.json().catch(() => (\{\}));\line
      if (!conversationResponse.ok) \{\line
        throw new Error(conversationData.message || "Could not open a conversation for this status.");\line
      \}\line
\line
      const statusQuote = (status.content?.trim() || (status.image_url ? "Photo status" : "Status"))\line
        .replace(/\\s+/g, " ");\line
      const content = `Status reply \u183? $\{status.username\}\\n$\{statusQuote\}\\n\\n$\{message\}`;\line
      const messageResponse = await fetch(\line
        `https://dream-chat-app-1.onrender.com/api/conversations/$\{conversationData.id\}/messages`,\line
        \{\line
          method: "POST",\line
          headers: \{\line
            "Content-Type": "application/json",\line
            Authorization: `Bearer $\{token\}`,\line
          \},\line
          body: JSON.stringify(\{ content \}),\line
        \}\line
      );\line
      const messageData = await messageResponse.json().catch(() => (\{\}));\line
      if (!messageResponse.ok) throw new Error(messageData.message || "Could not send your status reply.");\line
\line
      setReplyText("");\line
      setReplyMessage(`Reply sent to $\{status.username\}.`);\line
    \} catch (replyError) \{\line
      setStatusError(replyError.message || "Could not send your status reply.");\line
    \} finally \{\line
      setReplySending(false);\line
    \}\line
  \}\line
\line
  async function deleteCurrentStatus() \{\line
    const status = viewerGroup?.[viewerIndex];\line
    if (!status || Number(status.user_id) !== Number(user?.id)) return;\line
    if (!window.confirm("Delete this status? This action cannot be undone.")) return;\line
\line
    setStatusError("");\line
    try \{\line
      const response = await fetch(`https://dream-chat-app-1.onrender.com/api/statuses/$\{status.id\}`, \{\line
        method: "DELETE",\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      const data = await response.json().catch(() => (\{\}));\line
      if (!response.ok) throw new Error(data.message || "Failed to delete status.");\line
\line
      const remaining = viewerGroup.filter((item) => item.id !== status.id);\line
      setStatuses((current) => current.filter((item) => item.id !== status.id));\line
      if (remaining.length === 0) \{\line
        setViewerGroup(null);\line
        setViewerIndex(0);\line
      \} else \{\line
        const nextIndex = Math.min(viewerIndex, remaining.length - 1);\line
        setViewerGroup(remaining);\line
        setViewerIndex(nextIndex);\line
      \}\line
    \} catch (deleteError) \{\line
      setStatusError(deleteError.message || "Failed to delete status.");\line
    \}\line
  \}\line
\line
  async function handleImagePick(e) \{\line
    const file = e.target.files[0];\line
    if (!file) return;\line
    const resized = await resizeImage(file, 500);\line
    setImagePreview(resized);\line
  \}\line
\line
  async function handlePost() \{\line
    if (!text.trim() && !imagePreview) return;\line
    setPosting(true);\line
    try \{\line
      await fetch("https://dream-chat-app-1.onrender.com/api/statuses", \{\line
        method: "POST",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ content: text, imageUrl: imagePreview, backgroundColor: color \}),\line
      \});\line
      setText("");\line
      setImagePreview(null);\line
      setComposerOpen(false);\line
      fetchStatuses();\line
    \} catch \{\line
      // non-critical\line
    \} finally \{\line
      setPosting(false);\line
    \}\line
  \}\line
\line
  return (\line
    <>\line
      <div className="status-bar">\line
        <div\line
          className="status-item"\line
          onClick=\{() => \{\line
            const ownStatuses = groups.find((group) => Number(group.user_id) === Number(user?.id));\line
            if (ownStatuses) openGroup(ownStatuses);\line
            else setComposerOpen(true);\line
          \}\}\line
        >\line
          <div className=\{`status-ring status-ring-self$\{ownStatusGroup ? " status-ring-has-status" : ""\}`\}>\line
            \{user?.avatar ? (\line
              <img src=\{user.avatar\} alt="" />\line
            ) : (\line
              <div className="status-avatar-fallback">\{getInitials(user?.username)\}</div>\line
            )\}\line
            <button\line
              type="button"\line
              className="status-add"\line
              aria-label="Create a status"\line
              onClick=\{(event) => \{\line
                event.stopPropagation();\line
                setComposerOpen(true);\line
              \}\}\line
            >\line
              +\line
            </button>\line
          </div>\line
          <span className="status-name">Your status</span>\line
        </div>\line
\line
        \{groups.map((g) => \{\line
          return (\line
            <div className="status-item" key=\{g.user_id\} onClick=\{() => openGroup(g)\}>\line
              <UserAvatarMenu userId=\{g.user_id\} src=\{g.avatar\} name=\{g.username\}>\line
                <div className="status-ring status-ring-has-status">\line
                  \{g.avatar ? (\line
                    <img src=\{g.avatar\} alt="" />\line
                  ) : (\line
                    <div className="status-avatar-fallback">\{getInitials(g.username)\}</div>\line
                  )\}\line
                </div>\line
              </UserAvatarMenu>\line
              <span className="status-name">\{g.username\}</span>\line
            </div>\line
          );\line
        \})\}\line
      </div>\line
      \{statusLinkMessage && <p className="status-feedback" role="status">\{statusLinkMessage\}</p>\}\line
\line
      \{/* --- Full-screen story viewer --- */\}\line
      \{viewerGroup && (\line
        <div className="status-viewer" onClick=\{() => setViewerGroup(null)\}>\line
          <div className="status-viewer-content" onClick=\{(e) => e.stopPropagation()\}>\line
            <div className="status-viewer-bars">\line
              \{viewerGroup.map((_, i) => (\line
                <div key=\{i\} className=\{`status-bar-segment $\{i <= viewerIndex ? "filled" : ""\}`\} />\line
              ))\}\line
            </div>\line
\line
            <div\line
              className="status-viewer-slide"\line
              style=\{\{ background: viewerGroup[viewerIndex].image_url ? "#000" : viewerGroup[viewerIndex].background_color \}\}\line
            >\line
              \{viewerGroup[viewerIndex].image_url && (\line
                <img src=\{viewerGroup[viewerIndex].image_url\} alt="" className="status-viewer-image" />\line
              )\}\line
              \{viewerGroup[viewerIndex].content && (\line
                <p className="status-viewer-text">\{viewerGroup[viewerIndex].content\}</p>\line
              )\}\line
            </div>\line
\line
            <div className="status-viewer-header">\line
              \{viewerGroup[viewerIndex].avatar ? (\line
                <img src=\{viewerGroup[viewerIndex].avatar\} alt="" />\line
              ) : (\line
                <span className="status-viewer-avatar-fallback">\line
                  \{getInitials(viewerGroup[viewerIndex].username)\}\line
                </span>\line
              )\}\line
              <div>\line
                <strong>\{viewerGroup[viewerIndex].username\}</strong>\line
                <span>Status \u183? \{new Date(viewerGroup[viewerIndex].created_at).toLocaleTimeString([], \{ hour: "numeric", minute: "2-digit" \})\}</span>\line
              </div>\line
            </div>\line
\line
            <button className="status-nav left" onClick=\{prevStory\}>\u8249?</button>\line
            <button className="status-nav right" onClick=\{nextStory\}>\u8250?</button>\line
            <button className="status-close" onClick=\{() => setViewerGroup(null)\}>\u10005?</button>\line
            \{statusError && <p className="status-feedback status-feedback-error" role="alert">\{statusError\}</p>\}\line
            \{replyMessage && <p className="status-feedback" role="status">\{replyMessage\}</p>\}\line
            \{Number(viewerGroup[viewerIndex].user_id) === Number(user?.id) ? (\line
              <button type="button" className="status-delete" onClick=\{deleteCurrentStatus\}>\line
                Delete status\line
              </button>\line
            ) : (\line
              <form className="status-reply-form" onSubmit=\{handleStatusReply\}>\line
                <input\line
                  type="text"\line
                  value=\{replyText\}\line
                  onChange=\{(event) => setReplyText(event.target.value)\}\line
                  placeholder=\{`Reply to $\{viewerGroup[viewerIndex].username\}\u8230?`\}\line
                  aria-label=\{`Reply to $\{viewerGroup[viewerIndex].username\}'s status`\}\line
                  maxLength=\{1000\}\line
                />\line
                <button type="submit" disabled=\{!replyText.trim() || replySending\}>\line
                  \{replySending ? "\u8230?" : "Send"\}\line
                </button>\line
              </form>\line
            )\}\line
          </div>\line
        </div>\line
      )\}\line
\line
      \{/* --- Composer --- */\}\line
      \{composerOpen && (\line
        <div className="status-viewer" onClick=\{() => setComposerOpen(false)\}>\line
          <div className="status-viewer-content" onClick=\{(e) => e.stopPropagation()\}>\line
            <div\line
              className="status-viewer-slide"\line
              style=\{\{ background: imagePreview ? "#000" : color \}\}\line
            >\line
              \{imagePreview && <img src=\{imagePreview\} alt="" className="status-viewer-image" />\}\line
              <textarea\line
                className="status-composer-input"\line
                placeholder="Type a status..."\line
                value=\{text\}\line
                onChange=\{(e) => setText(e.target.value)\}\line
              />\line
            </div>\line
\line
            <div className="status-composer-controls">\line
              \{COLORS.map((c) => (\line
                <button\line
                  key=\{c\}\line
                  className=\{`status-color-dot $\{c === color ? "selected" : ""\}`\}\line
                  style=\{\{ background: c \}\}\line
                  onClick=\{() => setColor(c)\}\line
                />\line
              ))\}\line
              <button className="status-color-dot image-pick" onClick=\{() => fileInputRef.current?.click()\}>\line
                \u-10179?\line
              </button>\line
              <input ref=\{fileInputRef\} type="file" accept="image/*" onChange=\{handleImagePick\} style=\{\{ display: "none" \}\} />\line
            </div>\line
\line
            <button className="status-close" onClick=\{() => setComposerOpen(false)\}>\u10005?</button>\line
            <button className="status-send" onClick=\{handlePost\} disabled=\{posting\}>\line
              \{posting ? "..." : "\u10148?"\}\line
            </button>\line
          </div>\line
        </div>\line
      )\}\line
    </>\line
  );\line
\}}\par\par
\b src/pages/InboxPage.jsx\b0\par
{\f1\fs15\cf2 import \{ useState, useEffect \} from "react";\line
import \{ useLocation, useNavigate \} from "react-router-dom";\line
import \{ io \} from "socket.io-client";\line
import "../css/Inboxpage.css";\line
import Avatar from "../components/Avatar";\line
import UserAvatarMenu from "../components/UserAvatarMenu";\line
\line
\line
export default function InboxPage() \{\line
  const [conversations, setConversations] = useState([]);\line
  const [error, setError] = useState("");\line
  const [search, setSearch] = useState("");\line
  const [onlineUserIds, setOnlineUserIds] = useState([]);\line
  const location = useLocation();\line
  const navigate = useNavigate();\line
  const token = localStorage.getItem("token");\line
  const showConversationList = new URLSearchParams(location.search).get("list") === "1";\line
\line
  // Refresh periodically so new messages become visible while the inbox stays open.\line
  useEffect(() => \{\line
    async function fetchConversations(openFirstConversation = false) \{\line
      try \{\line
        const response = await fetch("https://dream-chat-app-1.onrender.com/api/conversations", \{\line
          headers: \{ Authorization: `Bearer $\{token\}` \},\line
        \});\line
        if (!response.ok) throw new Error("Failed to load conversations.");\line
        const data = await response.json();\line
        setConversations(data);\line
        if (openFirstConversation && !showConversationList && data.length > 0) \{\line
          navigate(`/chat/$\{data[0].conversation_id\}`, \{ replace: true \});\line
        \}\line
      \} catch (err) \{\line
        setError(err.message);\line
      \}\line
    \}\line
    fetchConversations(true);\line
    const intervalId = window.setInterval(() => fetchConversations(), 15000);\line
    return () => window.clearInterval(intervalId);\line
  \}, [token, navigate, showConversationList]);\line
\line
  // track who's online via socket.io\line
  useEffect(() => \{\line
    const socket = io("https://dream-chat-app-1.onrender.com", \{\line
      auth: \{ token \},\line
    \});\line
\line
    socket.on("onlineUsers", (userIds) => \{\line
  console.log("Received online users:", userIds);\line
  setOnlineUserIds(userIds);\line
\});\line
\line
    socket.on("userOnline", (userId) => \{\line
      setOnlineUserIds((prev) => (prev.includes(userId) ? prev : [...prev, userId]));\line
    \});\line
\line
    socket.on("userOffline", (userId) => \{\line
      setOnlineUserIds((prev) => prev.filter((id) => id !== userId));\line
    \});\line
\line
    socket.on("connect", () => \{\line
  console.log("Socket connected!", socket.id);\line
\});\line
socket.on("connect_error", (err) => \{\line
  console.log("Socket connection error:", err.message);\line
\});\line
    return () => socket.disconnect();\line
  \}, [token]);\line
\line
  const filtered = conversations.filter((c) =>\line
    c.other_username.toLowerCase().includes(search.toLowerCase())\line
  );\line
\line
  return (\line
    <div className="inbox-page">\line
      <h1 className="inbox-title">Messages</h1>\line
\line
      <div className="inbox-search">\line
        <span>\u-10179?</span>\line
        <input\line
          type="text"\line
          placeholder="Search chats"\line
          value=\{search\}\line
          onChange=\{(e) => setSearch(e.target.value)\}\line
        />\line
      </div>\line
\line
      \{error && <p className="inbox-error">\{error\}</p>\}\line
\line
      \{filtered.length === 0 && !error && (\line
        <p className="inbox-empty">\line
          \{search ? "No matching conversations." : 'No conversations yet \u8212? start one from "New chat".'\}\line
        </p>\line
      )\}\line
\line
      <ul className="inbox-list">\line
        \{filtered.map((c) => \{\line
          const unreadCount = Number(c.unread_count) || 0;\line
\line
          return (\line
          <li key=\{c.conversation_id\}>\line
            <div\line
              className=\{`inbox-row$\{unreadCount ? " inbox-row-unread" : ""\}`\}\line
            >\line
              <UserAvatarMenu userId=\{c.other_user_id\} src=\{c.other_avatar\} name=\{c.other_username\}>\line
                <Avatar src=\{c.other_avatar\} name=\{c.other_username\} className="inbox-avatar" />\line
              </UserAvatarMenu>\line
                \{onlineUserIds.includes(c.other_user_id) && <span className="online-dot" />\}\line
              \line
              <button type="button" className="inbox-row-main" onClick=\{() => navigate(`/chat/$\{c.conversation_id\}`)\}>\line
              <span className="inbox-row-content">\line
                <span className="inbox-row-name">\{c.other_username\}</span>\line
                <span className=\{`inbox-row-preview$\{c.last_message_unread ? " inbox-row-preview-unread" : ""\}`\}>\line
                  \{c.last_message || "No messages yet"\}\line
                </span>\line
              </span>\line
              \{c.last_message_at && (\line
                <span className="inbox-row-time">\line
                  \{new Date(c.last_message_at).toLocaleDateString([], \{ month: "short", day: "numeric" \})\}\line
                </span>\line
              )\}\line
              \{unreadCount > 0 && (\line
                <span className="inbox-unread-count" aria-label=\{`$\{unreadCount\} unread messages`\}>\line
                  \{unreadCount > 99 ? "99+" : unreadCount\}\line
                </span>\line
              )\}\line
              </button>\line
            </div>\line
          </li>\line
          );\line
        \})\}\line
      </ul>\line
    </div>\line
  );\line
\}}\par\par
\b src/pages/Layout.jsx\b0\par
{\f1\fs15\cf2 import \{ NavLink, Outlet, useLocation, useNavigate, Link \} from "react-router-dom";\line
import \{ useCallback, useEffect, useState \} from "react";\line
import "../css/Layout.css";\line
import Avatar from "../components/Avatar";\line
import \{ getSavedTheme \} from "../theme";\line
import \{ io \} from "socket.io-client";\line
import CallOverlay from '../components/CallOverlay.jsx';\line
const ChatIcon = () => (\line
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">\line
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />\line
  </svg>\line
);\line
\line
const AddUserIcon = () => (\line
   <svg className="sidebar-sub-link-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">\line
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />\line
                    <circle cx="10" cy="7" r="4" />\line
                    <path d="M19 8v6M22 11h-6" />\line
                  </svg>\line
);\line
\line
const BellIcon = () => (\line
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">\line
    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />\line
    <path d="M13.73 21a2 2 0 0 1-3.46 0" />\line
  </svg>\line
);\line
\line
const LogoutIcon = () => (\line
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">\line
    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />\line
    <polyline points="16 17 21 12 16 7" />\line
    <line x1="21" y1="12" x2="9" y2="12" />\line
  </svg>\line
);\line
const SettingsIcon = () => (\line
  <svg\line
    width="20"\line
    height="20"\line
    viewBox="0 0 24 24"\line
    fill="none"\line
    stroke="currentColor"\line
    strokeWidth="2"\line
    strokeLinecap="round"\line
    strokeLinejoin="round"\line
  >\line
    <path d="M12.22 2h-.44a2 2 0 0 0-2 1.72l-.18 1.26a8 8 0 0 0-1.73 1l-1.2-.48a2 2 0 0 0-2.45.9l-.22.38a2 2 0 0 0 .45 2.55l1 .84a8 8 0 0 0 0 2l-1 .84a2 2 0 0 0-.45 2.55l.22.38a2 2 0 0 0 2.45.9l1.2-.48a8 8 0 0 0 1.73 1l.18 1.26A2 2 0 0 0 11.78 22h.44a2 2 0 0 0 2-1.72l.18-1.26a8 8 0 0 0 1.73-1l1.2.48a2 2 0 0 0 2.45-.9l.22-.38a2 2 0 0 0-.45-2.55l-1-.84a8 8 0 0 0 0-2l1-.84a2 2 0 0 0 .45-2.55l-.22-.38a2 2 0 0 0-2.45-.9l-1.2.48a8 8 0 0 0-1.73-1l-.18-1.26A2 2 0 0 0 12.22 2z" />\line
    <circle cx="12" cy="12" r="3" />\line
  </svg>\line
);\line
const FeedIcon = () => (\line
  <svg\line
    width="20"\line
    height="20"\line
    viewBox="0 0 24 24"\line
    fill="none"\line
    stroke="currentColor"\line
    strokeWidth="2"\line
    strokeLinecap="round"\line
    strokeLinejoin="round"\line
  >\line
    <path d="m3 10 9-7 9 7" />\line
    <path d="M5 9v12h14V9" />\line
    <path d="M9 21v-7h6v7" />\line
  </svg>\line
);\line
const CameraIcon = () => (\line
<svg\line
  width="20"\line
  height="20"\line
  viewBox="0 0 24 24"\line
  fill="none"\line
  stroke="currentColor"\line
  strokeWidth="2"\line
  strokeLinecap="round"\line
  strokeLinejoin="round"\line
>\line
  <path d="M14 4h-4l-2 3H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z" />\line
  <circle cx="12" cy="13" r="3" />\line
</svg>\line
);\line
export default function Layout() \{\line
  const navigate = useNavigate();\line
  const location = useLocation();\line
  const user = JSON.parse(localStorage.getItem("user"));\line
  const token = localStorage.getItem("token");\line
  const [unreadCounts, setUnreadCounts] = useState(\{ messages: 0, notifications: 0 \});\line
  const mobilePageTitle = (() => \{\line
    const path = location.pathname;\line
    if (path === "/feed") return "Feed";\line
    if (path === "/notifications") return "Notifications";\line
    if (path === "/settings") return "Settings";\line
    if (path === "/profile" || path.startsWith("/profile/")) return "Profile";\line
    if (path === "/create-group") return "Create group";\line
    if (path === "/groups") return "Groups";\line
    if (path === "/requests") return "Friend requests";\line
    if (path === "/inbox") return "Messages";\line
    if (path === "/new") return "New chat";\line
    if (path === "/chat") return "Chats";\line
    if(path ==='/camera') return "Camera";\line
    return "";\line
  \})();\line
  const isChatLayout = location.pathname === "/chat"\line
    || location.pathname.startsWith("/chat/")\line
    || location.pathname.startsWith("/group/");\line
\line
  useEffect(() => \{\line
    function syncTheme() \{\line
      document.documentElement.dataset.theme = getSavedTheme();\line
    \}\line
\line
    syncTheme();\line
    window.addEventListener("app-theme-change", syncTheme);\line
    window.addEventListener("storage", syncTheme);\line
    return () => \{\line
      window.removeEventListener("app-theme-change", syncTheme);\line
      window.removeEventListener("storage", syncTheme);\line
    \};\line
  \}, []);\line
\line
  const refreshUnreadCounts = useCallback(async () => \{\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/unread-counts", \{\line
        headers: \{ Authorization: `Bearer $\{token\}` \},\line
      \});\line
      if (!response.ok) return;\line
      const counts = await response.json();\line
      setUnreadCounts(\{\line
        messages: Number(counts.messages) || 0,\line
        notifications: Number(counts.notifications) || 0,\line
      \});\line
    \} catch \{\line
      // Keep the last known counts when the API is temporarily unavailable.\line
    \}\line
  \}, [token]);\line
\line
  useEffect(() => \{\line
    refreshUnreadCounts();\line
    const intervalId = setInterval(refreshUnreadCounts, 20000);\line
    return () => clearInterval(intervalId);\line
  \}, [location.pathname, refreshUnreadCounts]);\line
\line
  // Live badges: the server rings this "doorbell" whenever counts change,\line
  // so we reload them instantly instead of waiting for the 20s timer.\line
  useEffect(() => \{\line
    if (!token) return undefined;\line
    const socket = io("https://dream-chat-app-1.onrender.com", \{ auth: \{ token \} \});\line
    socket.on("unreadMessagesChanged", refreshUnreadCounts);\line
    socket.on("newNotification", refreshUnreadCounts);\line
    socket.on("notificationsChanged", refreshUnreadCounts);\line
    return () => socket.disconnect();\line
  \}, [token, refreshUnreadCounts]);\line
\line
  function handleLogout() \{\line
    localStorage.removeItem("token");\line
    localStorage.removeItem("user");\line
    navigate("/");\line
  \}\line
\line
  const navItems = [\line
    \{ to: "/feed", label: "Feed", icon: <FeedIcon /> \},\line
    \{ to: "/chat", label: "Messages", icon: <ChatIcon />, unreadKey: "messages", hasSubnav: true \},\line
   \{ to: "/new", label: "New Chat", icon: <AddUserIcon />, unreadKey: "messages", hasSubnav: true \},\line
    \{ to: "/camera", label: "Camera", icon: <CameraIcon />\},\line
    \{ to: "/notifications", label: "Notifications", icon: <BellIcon />, unreadKey: "notifications" \},\line
    \{ to: "/settings", label: "Settings", icon: <SettingsIcon /> \},\line
   \line
  ];\line
\line
  const mobileNavItems = [\line
    navItems[0],\line
    navItems[3],\line
    navItems[1],\line
    // navItems[3],\line
    // navItems[2],\line
    // \{ to: "/profile", label: "Profile", icon: <Avatar src=\{user?.avatar\} name=\{user?.username\} className="tabbar-profile-avatar" /> \},\line
  ];\line
\line
  function renderBadge(count, className) \{\line
    if (!count) return null;\line
    return <span className=\{className\}>\{count > 99 ? "99+" : count\}</span>;\line
  \}\line
\line
  return (\line
    <div className="app-layout">\line
      <CallOverlay />\line
      <aside className="app-sidebar">\line
        <div className="sidebar-brand">\line
          <span className="sidebar-brand-name" title="Morphues" aria-label="Morphues">M</span>\line
        </div>\line
\line
        <nav className="sidebar-nav">\line
          \{navItems.map((item) => (\line
            <div className="sidebar-nav-item" key=\{item.to\}>\line
              <NavLink\line
                to=\{item.to\}\line
                title=\{item.label\}\line
                aria-label=\{item.label\}\line
                className=\{(\{ isActive \}) => (isActive ? "sidebar-link active" : "sidebar-link")\}\line
              >\line
                \{item.icon\}\line
                <span>\{item.label\}</span>\line
                \{item.unreadKey && renderBadge(unreadCounts[item.unreadKey], "nav-badge")\}\line
              </NavLink>\line
              \{/* \{item.hasSubnav && (\line
                <NavLink\line
                  to="/new"\line
                  className=\{(\{ isActive \}) => (isActive ? "sidebar-sub-link active" : "sidebar-sub-link")\}\line
                  aria-label="New chat"\line
                  title="New chat"\line
                >\line
                  <svg className="sidebar-sub-link-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">\line
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />\line
                    <circle cx="10" cy="7" r="4" />\line
                    <path d="M19 8v6M22 11h-6" />\line
                  </svg>\line
                </NavLink>\line
              )\} */\}\line
            </div>\line
          ))\}\line
        </nav>\line
\line
        <div className="sidebar-footer">\line
          <Link to="/profile" className="sidebar-user">\line
            <Avatar src=\{user?.avatar\} name=\{user?.username\} className="sidebar-user-avatar" />\line
            <span>\{user?.username || "Profile"\}</span>\line
          </Link>\line
          <button onClick=\{handleLogout\} className="sidebar-logout" title="Log out" aria-label="Log out">\line
            <LogoutIcon />\line
            <span>Log out</span>\line
          </button>\line
        </div>\line
      </aside>\line
\line
      <div className=\{`app-content$\{isChatLayout ? " chat-layout-content" : ""\}$\{mobilePageTitle ? " has-mobile-page-header" : ""\}`\}>\line
        \{mobilePageTitle && (\line
          <header className="mobile-app-header">\line
            <span className="mobile-app-header-brand" aria-hidden="true">M</span>\line
            <h1>\{mobilePageTitle\}</h1>\line
            <Link to="/notifications" className="mobile-app-header-notifications" aria-label="Notifications">\line
              <BellIcon />\line
              \{renderBadge(unreadCounts.notifications, "mobile-header-badge")\}\line
            </Link>\line
            <Link to="/profile" className="mobile-app-header-profile" aria-label="Open profile">\line
              <Avatar src=\{user?.avatar\} name=\{user?.username\} className="mobile-app-header-avatar" />\line
            </Link>\line
           \line
          </header>\line
        )\}\line
        <Outlet context=\{\{ refreshUnreadCounts, handleLogout \}\} />\line
      </div>\line
\line
      <nav className="mobile-tabbar">\line
        \{mobileNavItems.map((item) => (\line
          <NavLink\line
            key=\{item.to\}\line
            to=\{item.to\}\line
            aria-label=\{item.label\}\line
            className=\{(\{ isActive \}) => (isActive ? "tabbar-link active" : "tabbar-link")\}\line
          >\line
            \{item.icon\}\line
            \{item.unreadKey && renderBadge(unreadCounts[item.unreadKey], "tabbar-badge")\}\line
          </NavLink>\line
        ))\}\line
      </nav>\line
    </div>\line
  );\line
\}}\par\par
\b src/pages/SettingsPage.jsx\b0\par
{\f1\fs15\cf2 import \{ useState \} from "react";\line
import \{ resizeImage \} from "../resizeImage";\line
import Avatar from "../components/Avatar";\line
import "../css/NewChat.css";\line
import \{ applyTheme, getSavedTheme \} from "../theme";\line
\line
export default function SettingsPage() \{\line
  const [user, setUser] = useState(JSON.parse(localStorage.getItem("user")));\line
  const [theme, setTheme] = useState(getSavedTheme);\line
  const token = localStorage.getItem("token");\line
\line
  const [username, setUsername] = useState(user?.username || "");\line
  const [email, setEmail] = useState(user?.email || "");\line
  const [currentPassword, setCurrentPassword] = useState("");\line
  const [newPassword, setNewPassword] = useState("");\line
\line
  const [uploading, setUploading] = useState(false);\line
  const [savingField, setSavingField] = useState(null); // "username" | "email" | "password" | null\line
  const [messages, setMessages] = useState(\{\}); // \{ username: "...", email: "...", password: "..." \}\line
\line
  function updateLocalUser(patch) \{\line
    const updated = \{ ...user, ...patch \};\line
    localStorage.setItem("user", JSON.stringify(updated));\line
    setUser(updated);\line
  \}\line
\line
  function setFieldMessage(field, text, isError) \{\line
    setMessages((prev) => (\{ ...prev, [field]: \{ text, isError \} \}));\line
  \}\line
\line
  function handleThemeChange(nextTheme) \{\line
    setTheme(nextTheme);\line
    applyTheme(nextTheme);\line
  \}\line
\line
  async function handleFileChange(e) \{\line
    const file = e.target.files[0];\line
    if (!file) return;\line
\line
    setUploading(true);\line
    try \{\line
      const resized = await resizeImage(file, 128);\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/users/avatar", \{\line
        method: "PATCH",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ avatar: resized \}),\line
      \});\line
      if (!response.ok) throw new Error("Failed to update avatar.");\line
      updateLocalUser(\{ avatar: resized \});\line
    \} catch (err) \{\line
      setFieldMessage("avatar", err.message, true);\line
    \} finally \{\line
      setUploading(false);\line
    \}\line
  \}\line
\line
  async function handleUsernameSave() \{\line
    setSavingField("username");\line
    setFieldMessage("username", null);\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/users/username", \{\line
        method: "PATCH",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ username \}),\line
      \});\line
      const data = await response.json();\line
      if (!response.ok) throw new Error(data.message || "Failed to update username.");\line
      updateLocalUser(\{ username: data.username \});\line
      setFieldMessage("username", "Username updated.", false);\line
    \} catch (err) \{\line
      setFieldMessage("username", err.message, true);\line
    \} finally \{\line
      setSavingField(null);\line
    \}\line
  \}\line
\line
  async function handleEmailSave() \{\line
    setSavingField("email");\line
    setFieldMessage("email", null);\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/users/email", \{\line
        method: "PATCH",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ email \}),\line
      \});\line
      const data = await response.json();\line
      if (!response.ok) throw new Error(data.message || "Failed to update email.");\line
      updateLocalUser(\{ email: data.email \});\line
      setFieldMessage("email", "Email updated.", false);\line
    \} catch (err) \{\line
      setFieldMessage("email", err.message, true);\line
    \} finally \{\line
      setSavingField(null);\line
    \}\line
  \}\line
\line
  async function handlePasswordSave() \{\line
    setSavingField("password");\line
    setFieldMessage("password", null);\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/users/password", \{\line
        method: "PATCH",\line
        headers: \{\line
          "Content-Type": "application/json",\line
          Authorization: `Bearer $\{token\}`,\line
        \},\line
        body: JSON.stringify(\{ currentPassword, newPassword \}),\line
      \});\line
      const data = await response.json();\line
      if (!response.ok) throw new Error(data.message || "Failed to update password.");\line
      setCurrentPassword("");\line
      setNewPassword("");\line
      setFieldMessage("password", "Password updated.", false);\line
    \} catch (err) \{\line
      setFieldMessage("password", err.message, true);\line
    \} finally \{\line
      setSavingField(null);\line
    \}\line
  \}\line
\line
  return (\line
    <div className="newchat-page">\line
      <h1 className="newchat-title">Settings</h1>\line
      <p className="newchat-subtitle">Manage your profile and account.</p>\line
\line
      <section className="appearance-settings" aria-labelledby="appearance-title">\line
        <div>\line
          <h2 id="appearance-title">Appearance</h2>\line
          <p>Choose the look you prefer for Morphues.</p>\line
        </div>\line
        <div className="appearance-options" role="group" aria-label="Color mode">\line
          <button\line
            type="button"\line
            className=\{`appearance-choice$\{theme === "light" ? " selected" : ""\}`\}\line
            aria-pressed=\{theme === "light"\}\line
            onClick=\{() => handleThemeChange("light")\}\line
          >\line
            <span className="appearance-preview appearance-preview-light" aria-hidden="true">\line
              <i /><i /><i />\line
            </span>\line
            <span className="appearance-choice-label">\line
              <span className="appearance-choice-icon" aria-hidden="true">\u9728?</span>\line
              Light\line
            </span>\line
            <span className="appearance-choice-indicator" aria-hidden="true" />\line
          </button>\line
          <button\line
            type="button"\line
            className=\{`appearance-choice$\{theme === "dark" ? " selected" : ""\}`\}\line
            aria-pressed=\{theme === "dark"\}\line
            onClick=\{() => handleThemeChange("dark")\}\line
          >\line
            <span className="appearance-preview appearance-preview-dark" aria-hidden="true">\line
              <i /><i /><i />\line
            </span>\line
            <span className="appearance-choice-label">\line
              <span className="appearance-choice-icon" aria-hidden="true">\u9790?</span>\line
              Dark\line
            </span>\line
            <span className="appearance-choice-indicator" aria-hidden="true" />\line
          </button>\line
        </div>\line
      </section>\line
\line
      \{/* Avatar */\}\line
      <div style=\{\{ display: "flex", alignItems: "center", gap: 16, margin: "20px 0" \}\}>\line
        <Avatar src=\{user?.avatar\} name=\{user?.username\} className="newchat-avatar" style=\{\{ width: 72, height: 72, fontSize: 22 \}\} />\line
        <label className="newchat-add-button" style=\{\{ cursor: "pointer" \}\}>\line
          \{uploading ? "Uploading..." : "Change photo"\}\line
          <input type="file" accept="image/*" onChange=\{handleFileChange\} style=\{\{ display: "none" \}\} disabled=\{uploading\} />\line
        </label>\line
      </div>\line
      \{messages.avatar && (\line
        <p className=\{messages.avatar.isError ? "newchat-error" : "newchat-subtitle"\}>\{messages.avatar.text\}</p>\line
      )\}\line
\line
      \{/* Username */\}\line
      <div style=\{\{ marginTop: 24 \}\}>\line
        <label className="newchat-subtitle" style=\{\{ display: "block", marginBottom: 6 \}\}>Username</label>\line
        <div className="newchat-search">\line
          <input type="text" value=\{username\} onChange=\{(e) => setUsername(e.target.value)\} />\line
        </div>\line
        <button className="newchat-add-button" style=\{\{ marginTop: 8 \}\} onClick=\{handleUsernameSave\} disabled=\{savingField === "username"\}>\line
          \{savingField === "username" ? "Saving..." : "Save username"\}\line
        </button>\line
        \{messages.username && (\line
          <p className=\{messages.username.isError ? "newchat-error" : "newchat-subtitle"\}>\{messages.username.text\}</p>\line
        )\}\line
      </div>\line
\line
      \{/* Email */\}\line
      <div style=\{\{ marginTop: 24 \}\}>\line
        <label className="newchat-subtitle" style=\{\{ display: "block", marginBottom: 6 \}\}>Email</label>\line
        <div className="newchat-search">\line
          <input type="email" value=\{email\} onChange=\{(e) => setEmail(e.target.value)\} />\line
        </div>\line
        <button className="newchat-add-button" style=\{\{ marginTop: 8 \}\} onClick=\{handleEmailSave\} disabled=\{savingField === "email"\}>\line
          \{savingField === "email" ? "Saving..." : "Save email"\}\line
        </button>\line
        \{messages.email && (\line
          <p className=\{messages.email.isError ? "newchat-error" : "newchat-subtitle"\}>\{messages.email.text\}</p>\line
        )\}\line
      </div>\line
\line
      \{/* Password */\}\line
      <div style=\{\{ marginTop: 24, marginBottom: 24 \}\}>\line
        <label className="newchat-subtitle" style=\{\{ display: "block", marginBottom: 6 \}\}>Change password</label>\line
        <div className="newchat-search" style=\{\{ marginBottom: 8 \}\}>\line
          <input\line
            type="password"\line
            placeholder="Current password"\line
            value=\{currentPassword\}\line
            onChange=\{(e) => setCurrentPassword(e.target.value)\}\line
          />\line
        </div>\line
        <div className="newchat-search">\line
          <input\line
            type="password"\line
            placeholder="New password"\line
            value=\{newPassword\}\line
            onChange=\{(e) => setNewPassword(e.target.value)\}\line
          />\line
        </div>\line
        <button className="newchat-add-button" style=\{\{ marginTop: 8 \}\} onClick=\{handlePasswordSave\} disabled=\{savingField === "password"\}>\line
          \{savingField === "password" ? "Saving..." : "Save password"\}\line
        </button>\line
        \{messages.password && (\line
          <p className=\{messages.password.isError ? "newchat-error" : "newchat-subtitle"\}>\{messages.password.text\}</p>\line
        )\}\line
      </div>\line
    </div>\line
  );\line
\}}\par\par
\b src/pages/LoginPage.jsx\b0\par
{\f1\fs15\cf2 import \{ useState \} from "react";\line
import "../css/LoginPage.css"; // reuse the same styles\line
\line
export default function LoginPage() \{\line
  const [email, setEmail] = useState("");\line
  const [password, setPassword] = useState("");\line
  const [showPassword, setShowPassword] = useState(false);\line
  const [error, setError] = useState("");\line
  const [isLoading, setIsLoading] = useState(false);\line
\line
  async function handleSubmit(e) \{\line
    e.preventDefault();\line
    setError("");\line
\line
    if (!email || !password) \{\line
      setError("Enter your email and password to continue.");\line
      return;\line
    \}\line
\line
    setIsLoading(true);\line
\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/auth/login", \{\line
        method: "POST",\line
        headers: \{ "Content-Type": "application/json" \},\line
        body: JSON.stringify(\{ email, password \}),\line
      \});\line
\line
      if (!response.ok) \{\line
        const data = await response.json().catch(() => (\{\}));\line
        throw new Error(data.message || "Invalid email or password.");\line
      \}\line
\line
      const data = await response.json();\line
      localStorage.setItem("token", data.token);\line
      localStorage.setItem("user", JSON.stringify(data.user));\line
      window.location.href = "/inbox";\line
    \} catch (err) \{\line
      setError(err.message || "Something went wrong. Try again.");\line
    \} finally \{\line
      setIsLoading(false);\line
    \}\line
    \line
  \}\line
\line
  return (\line
    <div className="login-page">\line
      <div className="login-card">\line
        <div className="login-brand">\line
          <span className="login-brand-icon">\u-10179?</span>\line
          <span className="login-brand-name">Morphues</span>\line
        </div>\line
\line
        <h1 className="login-title">Welcome back</h1>\line
        <p className="login-subtitle">Log in to keep the conversation going.</p>\line
\line
        <form onSubmit=\{handleSubmit\} className="login-form" noValidate>\line
          <label className="login-label" htmlFor="email">Email</label>\line
          <input\line
            id="email"\line
            type="email"\line
            className="login-input"\line
            value=\{email\}\line
            onChange=\{(e) => setEmail(e.target.value)\}\line
            placeholder="you@example.com"\line
            autoComplete="email"\line
          />\line
\line
          <label className="login-label" htmlFor="password">Password</label>\line
          <div className="password-input-wrap">\line
            <input\line
              id="password"\line
              type=\{showPassword ? "text" : "password"\}\line
              className="login-input"\line
              value=\{password\}\line
              onChange=\{(e) => setPassword(e.target.value)\}\line
              placeholder="\u8226?\u8226?\u8226?\u8226?\u8226?\u8226?\u8226?\u8226?"\line
              autoComplete="current-password"\line
            />\line
            <button\line
              type="button"\line
              className="password-visibility-toggle"\line
              onClick=\{() => setShowPassword((visible) => !visible)\}\line
              aria-label=\{showPassword ? "Hide password" : "Show password"\}\line
              aria-pressed=\{showPassword\}\line
            >\line
              \{showPassword ? (\line
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">\line
                  <path d="M3 3l18 18" />\line
                  <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />\line
                  <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5.5 0 9 7 9 7a15.7 15.7 0 0 1-3 3.8" />\line
                  <path d="M6.2 6.2C4.1 7.6 3 12 3 12s3.5 7 9 7a9.7 9.7 0 0 0 3-.5" />\line
                </svg>\line
              ) : (\line
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">\line
                  <path d="M3 12s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7Z" />\line
                  <circle cx="12" cy="12" r="2.5" />\line
                </svg>\line
              )\}\line
            </button>\line
          </div>\line
\line
          \{error && <p className="login-error">\{error\}</p>\}\line
\line
          <button type="submit" className="login-button" disabled=\{isLoading\}>\line
            \{isLoading ? "Logging in..." : "Log in"\}\line
          </button>\line
        </form>\line
\line
        <p className="login-footer">\line
          Don't have an account? <a href="/signup">Sign up</a>\line
        </p>\line
      </div>\line
    </div>\line
  );\line
\}}\par\par
\b src/pages/SignupPage.jsx\b0\par
{\f1\fs15\cf2 import \{ useState \} from "react";\line
import "../css/LoginPage.css";\line
\line
export default function SignupPage() \{\line
  const [username, setUsername] = useState("");\line
  const [email, setEmail] = useState("");\line
  const [password, setPassword] = useState("");\line
  const [showPassword, setShowPassword] = useState(false);\line
  const [error, setError] = useState("");\line
  const [isLoading, setIsLoading] = useState(false);\line
\line
  async function handleSubmit(e) \{\line
    e.preventDefault();\line
    setError("");\line
\line
    if (!username || !email || !password) \{\line
      setError("Fill in all fields to continue.");\line
      return;\line
    \}\line
\line
    setIsLoading(true);\line
\line
    try \{\line
      const response = await fetch("https://dream-chat-app-1.onrender.com/api/auth/signup", \{\line
        method: "POST",\line
        headers: \{ "Content-Type": "application/json" \},\line
        body: JSON.stringify(\{ username, email, password \}),\line
      \});\line
\line
      const data = await response.json();\line
\line
      if (!response.ok) \{\line
        throw new Error(data.message || "Something went wrong.");\line
      \}\line
\line
      localStorage.setItem("token", data.token);\line
      localStorage.setItem("user", JSON.stringify(data.user));\line
      window.location.href = "/inbox";\line
    \} catch (err) \{\line
      setError(err.message);\line
    \} finally \{\line
      setIsLoading(false);\line
    \}\line
  \}\line
\line
  return (\line
    <div className="login-page">\line
      <div className="login-card">\line
        <div className="login-brand">\line
          <span className="login-brand-icon">\u-10179?</span>\line
          <span className="login-brand-name">Morphues</span>\line
        </div>\line
\line
        <h1 className="login-title">Create your account</h1>\line
        <p className="login-subtitle">Join the conversation.</p>\line
\line
        <form onSubmit=\{handleSubmit\} className="login-form" noValidate>\line
          <label className="login-label" htmlFor="username">Username</label>\line
          <input\line
            id="username"\line
            type="text"\line
            className="login-input"\line
            value=\{username\}\line
            onChange=\{(e) => setUsername(e.target.value)\}\line
            placeholder="Username"\line
          />\line
\line
          <label className="login-label" htmlFor="email">Email</label>\line
          <input\line
            id="email"\line
            type="email"\line
            className="login-input"\line
            value=\{email\}\line
            onChange=\{(e) => setEmail(e.target.value)\}\line
            placeholder="you@example.com"\line
            autoComplete="email"\line
          />\line
\line
          <label className="login-label" htmlFor="password">Password</label>\line
          <div className="password-input-wrap">\line
            <input\line
              id="password"\line
              type=\{showPassword ? "text" : "password"\}\line
              className="login-input"\line
              value=\{password\}\line
              onChange=\{(e) => setPassword(e.target.value)\}\line
              placeholder="\u8226?\u8226?\u8226?\u8226?\u8226?\u8226?\u8226?\u8226?"\line
              autoComplete="new-password"\line
            />\line
            <button\line
              type="button"\line
              className="password-visibility-toggle"\line
              onClick=\{() => setShowPassword((visible) => !visible)\}\line
              aria-label=\{showPassword ? "Hide password" : "Show password"\}\line
              aria-pressed=\{showPassword\}\line
            >\line
              \{showPassword ? (\line
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">\line
                  <path d="M3 3l18 18" />\line
                  <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />\line
                  <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5.5 0 9 7 9 7a15.7 15.7 0 0 1-3 3.8" />\line
                  <path d="M6.2 6.2C4.1 7.6 3 12 3 12s3.5 7 9 7a9.7 9.7 0 0 0 3-.5" />\line
                </svg>\line
              ) : (\line
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">\line
                  <path d="M3 12s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7Z" />\line
                  <circle cx="12" cy="12" r="2.5" />\line
                </svg>\line
              )\}\line
            </button>\line
          </div>\line
\line
          \{error && <p className="login-error">\{error\}</p>\}\line
\line
          <button type="submit" className="login-button" disabled=\{isLoading\}>\line
            \{isLoading ? "Creating account..." : "Sign up"\}\line
          </button>\line
        </form>\line
\line
        <p className="login-footer">\line
          Already have an account? <a href="/">Log in</a>\line
        </p>\line
      </div>\line
    </div>\line
  );\line
\}}\par\par
\b src/css/Chatpage.css\b0\par
{\f1\fs15\cf2 .chat-page \{\line
  flex: 1;\line
  display: flex;\line
  flex-direction: column;\line
  max-width: 640px;\line
  width: 100%;\line
  margin: 0 auto;\line
  box-sizing: border-box;\line
\}\line
\line
.chat-header \{\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  padding: 16px 20px;\line
  border-bottom: 1px solid var(--border-subtle);\line
  background: #18181B;\line
\}\line
\line
.chat-header-avatar \{\line
  width: 38px;\line
  height: 38px;\line
  border-radius: 50%;\line
  background: var(--blue-light);\line
  color: var(--blue-deep);\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  font-size: 13px;\line
  font-weight: 700;\line
  font-family: "Space Grotesk", sans-serif;\line
\}\line
\line
.chat-header-name \{\line
  font-size: 15px;\line
  font-weight: 600;\line
  color: var(--ink);\line
\}\line
\line
.message-list \{\line
  flex: 1;\line
  overflow-y: auto;\line
  padding: 20px;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 10px;\line
\}\line
\line
.message \{\line
  max-width: 72%;\line
  border-radius: 16px;\line
  padding: 10px 14px;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 3px;\line
\}\line
\line
.message-mine \{\line
  align-self: flex-end;\line
  background: linear-gradient(135deg, var(--blue-primary), var(--blue-deep));\line
  color: #ffffff;\line
  border-bottom-right-radius: 4px;\line
\}\line
\line
.message-mine .message-author \{\line
  display: none;\line
\}\line
\line
.message-mine .message-content \{\line
  color: #ffffff;\line
\}\line
\line
.message-mine .message-time \{\line
  color: rgba(255, 255, 255, 0.75);\line
\}\line
\line
.message-theirs \{\line
  align-self: flex-start;\line
  background: #18181B;\line
  border: 1px solid var(--border-subtle);\line
  border-bottom-left-radius: 4px;\line
\}\line
\line
.message-author \{\line
  font-size: 11px;\line
  font-weight: 600;\line
  color: var(--blue-deep);\line
\}\line
\line
.message-content \{\line
  font-size: 14.5px;\line
  color: var(--ink);\line
  word-break: break-word;\line
\}\line
\line
.message-status-context \{\line
  display: flex;\line
  flex-direction: column;\line
  gap: 3px;\line
  margin: 0 0 7px;\line
  padding: 7px 9px;\line
  border-left: 2px solid rgba(255, 255, 255, 0.62);\line
  border-radius: 2px 7px 7px 2px;\line
  background: rgba(0, 0, 0, 0.12);\line
\}\line
\line
.message-status-context strong \{\line
  font-size: 10px;\line
  font-weight: 700;\line
  opacity: 0.86;\line
\}\line
\line
.message-status-context > span \{\line
  display: -webkit-box;\line
  overflow: hidden;\line
  font-size: 11px;\line
  line-height: 1.4;\line
  opacity: 0.9;\line
  -webkit-box-orient: vertical;\line
  -webkit-line-clamp: 2;\line
\}\line
\line
.message-status-reply-text \{\line
  display: block;\line
  white-space: pre-wrap;\line
\}\line
\line
.message-theirs .message-status-context \{\line
  border-left-color: var(--blue-primary);\line
  background: rgba(37, 99, 235, 0.08);\line
\}\line
\line
.message-time \{\line
  font-size: 10.5px;\line
  color: var(--gray-neutral);\line
  align-self: flex-end;\line
\}\line
\line
.chat-error \{\line
  text-align: center;\line
  color: #E0526B;\line
  font-size: 13px;\line
  margin: 0 0 12px;\line
\}\line
\line
.message-form \{\line
  display: flex;\line
  gap: 10px;\line
  padding: 16px 20px;\line
  border-top: 1px solid var(--border-subtle);\line
  background: #18181B;\line
\}\line
\line
.message-input \{\line
  flex: 1;\line
  background: rgba(37, 99, 235, 0.15);\line
  border: 1.5px solid var(--border-subtle);\line
  border-radius: 999px;\line
  padding: 12px 18px;\line
  font-size: 14.5px;\line
  color: var(--ink);\line
  outline: none;\line
  font-family: "Inter", sans-serif;\line
  transition: border-color 0.15s ease, background 0.15s ease;\line
\}\line
\line
.message-input::placeholder \{\line
  color: #9AA6BD;\line
\}\line
\line
.message-input:focus \{\line
  background: #18181B;\line
  border-color: var(--blue-primary);\line
\}\line
\line
.send-button \{\line
  background: linear-gradient(135deg, var(--blue-primary), var(--blue-deep));\line
  color: #ffffff;\line
  font-weight: 700;\line
  font-size: 14px;\line
  border: none;\line
  border-radius: 999px;\line
  padding: 0 24px;\line
  cursor: pointer;\line
  box-shadow: 0 8px 18px -6px rgba(73, 170, 255, 0.5);\line
\}\line
\line
.send-button:hover \{\line
  box-shadow: 0 10px 22px -4px rgba(73, 170, 255, 0.65);\line
\}\line
\line
.read-receipt \{\line
  font-weight: 700;\line
  margin-left: 2px;\line
\}\line
\line
.read-receipt.sent \{\line
  color: rgba(255, 255, 255, 0.55);\line
\}\line
\line
.read-receipt.read \{\line
  color: #7CD4FF;\line
\}\line
\line
.message-edited-tag \{\line
  font-size: 11px;\line
  font-style: italic;\line
  opacity: 0.7;\line
\}\line
\line
.message-actions \{\line
  display: flex;\line
  gap: 10px;\line
  margin-top: 4px;\line
\}\line
\line
.message-actions button \{\line
  background: none;\line
  border: none;\line
  font-size: 11px;\line
  font-weight: 600;\line
  cursor: pointer;\line
  padding: 0;\line
  opacity: 0.7;\line
  transition: opacity 0.15s ease;\line
\}\line
\line
.message-actions button:hover \{\line
  opacity: 1;\line
  text-decoration: underline;\line
\}\line
\line
.message-mine .message-actions button \{\line
  color: rgba(255, 255, 255, 0.85);\line
\}\line
\line
.message-theirs .message-actions button \{\line
  color: var(--blue-deep);\line
\}\line
\line
.message-edit-box \{\line
  display: flex;\line
  flex-direction: column;\line
  gap: 6px;\line
\}\line
\line
.message-edit-input \{\line
  border: none;\line
  border-radius: 8px;\line
  padding: 6px 10px;\line
  font-size: 14px;\line
  font-family: "Inter", sans-serif;\line
  outline: none;\line
  color: var(--ink);\line
\}\line
\line
.message-edit-buttons \{\line
  display: flex;\line
  gap: 8px;\line
\}\line
\line
.message-edit-buttons button \{\line
  border: none;\line
  border-radius: 999px;\line
  padding: 4px 12px;\line
  font-size: 11px;\line
  font-weight: 600;\line
  cursor: pointer;\line
\}\line
\line
.message-edit-save \{\line
  background: #18181B;\line
  color: var(--blue-deep);\line
\}\line
\line
.message-edit-cancel \{\line
  background: transparent;\line
  color: rgba(255, 255, 255, 0.85);\line
  border: 1px solid rgba(255, 255, 255, 0.4) !important;\line
\}\line
\line
/* --- Responsive --- */\line
@media (max-width: 640px) \{\line
  .chat-header \{\line
    padding: 12px 14px;\line
  \}\line
\line
  .message-list \{\line
    padding: 14px;\line
  \}\line
\line
  .message \{\line
    max-width: 85%;\line
  \}\line
\line
  .message-form \{\line
    padding: 12px 14px;\line
  \}\line
\line
  .send-button \{\line
    padding: 0 16px;\line
    font-size: 13px;\line
  \}\line
\}\line
\line
/* --- Reply quote shown inside a message bubble --- */\line
.message-reply-quote \{\line
  display: flex;\line
  flex-direction: column;\line
  border-left: 3px solid rgba(255, 255, 255, 0.5);\line
  padding-left: 8px;\line
  margin-bottom: 4px;\line
  opacity: 0.85;\line
\}\line
\line
.message-theirs .message-reply-quote \{\line
  border-left-color: var(--blue-primary);\line
\}\line
\line
.message-reply-author \{\line
  font-size: 11px;\line
  font-weight: 700;\line
\}\line
\line
.message-reply-text \{\line
  font-size: 12px;\line
  white-space: nowrap;\line
  overflow: hidden;\line
  text-overflow: ellipsis;\line
  max-width: 220px;\line
\}\line
\line
/* --- Reply preview above the input, while composing --- */\line
.reply-preview \{\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  gap: 10px;\line
  background: rgba(37, 99, 235, 0.15);\line
  border-top: 1px solid var(--border-subtle);\line
  padding: 10px 20px;\line
\}\line
\line
.reply-preview-text \{\line
  display: flex;\line
  flex-direction: column;\line
  min-width: 0;\line
\}\line
\line
.reply-preview-label \{\line
  font-size: 11px;\line
  font-weight: 700;\line
  color: var(--blue-deep);\line
\}\line
\line
.reply-preview-content \{\line
  font-size: 12.5px;\line
  color: var(--gray-neutral);\line
  white-space: nowrap;\line
  overflow: hidden;\line
  text-overflow: ellipsis;\line
\}\line
\line
.reply-preview-cancel \{\line
  background: none;\line
  border: none;\line
  font-size: 14px;\line
  color: var(--gray-neutral);\line
  cursor: pointer;\line
  padding: 4px 8px;\line
\}\line
\line
.reply-preview-cancel:hover \{\line
  color: #DC2626;\line
\}\line
\line
.typing-indicator \{\line
  padding: 4px 20px;\line
  font-size: 12px;\line
  font-style: italic;\line
  color: var(--gray-neutral);\line
\}\line
\line
.chat-workspace \{\line
  display: grid;\line
  grid-template-columns: 320px minmax(0, 1fr);\line
  width: 100%;\line
  height: 100vh;\line
  min-height: 0;\line
  flex: 1 1 auto;\line
  overflow: hidden;\line
  background: #11151c;\line
\}\line
\line
.chat-list-panel \{\line
  min-width: 0;\line
  display: flex;\line
  flex-direction: column;\line
  overflow: hidden;\line
  background: #151a22;\line
  border-right: 1px solid var(--border-subtle);\line
\}\line
\line
.chat-list-panel-header \{\line
  min-height: 72px;\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  padding: 0 18px;\line
  border-bottom: 1px solid var(--border-subtle);\line
\}\line
\line
.chat-list-panel-header h1 \{\line
  margin: 0;\line
  color: var(--ink);\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 20px;\line
\}\line
\line
.chat-list-panel-header button \{\line
  width: 36px;\line
  height: 36px;\line
  color: #fff;\line
  background: var(--blue-primary);\line
  border: 0;\line
  border-radius: 50%;\line
  font-size: 22px;\line
  line-height: 1;\line
  cursor: pointer;\line
\}\line
\line
.chat-add-menu \{\line
  position: relative;\line
\}\line
\line
.chat-add-menu-options \{\line
  position: absolute;\line
  top: calc(100% + 8px);\line
  right: 0;\line
  z-index: 10;\line
  min-width: 150px;\line
  padding: 5px;\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface, #202630);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 10px;\line
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);\line
\}\line
\line
.chat-add-menu-options a \{\line
  display: block;\line
  padding: 10px 12px;\line
  color: var(--theme-text, var(--ink));\line
  border-radius: 6px;\line
  font-size: 13px;\line
  line-height: 1.25;\line
  text-decoration: none;\line
  transition: background 140ms ease, color 140ms ease;\line
\}\line
\line
.chat-add-menu-options a:hover,\line
.chat-add-menu-options a:focus-visible \{\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.12));\line
  outline: none;\line
\}\line
\line
.chat-list-tabs \{\line
  display: flex;\line
  gap: 6px;\line
  padding: 12px 14px 0;\line
  border-bottom: 1px solid var(--border-subtle);\line
\}\line
\line
.chat-list-tabs button \{\line
  display: inline-flex;\line
  align-items: center;\line
  gap: 7px;\line
  padding: 9px 10px 11px;\line
  color: var(--gray-neutral);\line
  background: transparent;\line
  border: 0;\line
  border-bottom: 2px solid transparent;\line
  font: inherit;\line
  font-size: 13px;\line
  font-weight: 600;\line
  cursor: pointer;\line
\}\line
\line
.chat-list-tabs button.active \{\line
  color: var(--ink);\line
  border-bottom-color: var(--blue-primary);\line
\}\line
\line
.chat-list-tabs button span \{\line
  min-width: 18px;\line
  padding: 2px 5px;\line
  color: #b9c4d4;\line
  background: rgba(255, 255, 255, 0.08);\line
  border-radius: 999px;\line
  font-size: 10px;\line
  text-align: center;\line
\}\line
\line
.chat-list-tabs button.active span \{\line
  color: #fff;\line
  background: rgba(37, 99, 235, 0.65);\line
\}\line
\line
.chat-search \{\line
  height: 40px;\line
  display: flex;\line
  align-items: center;\line
  gap: 10px;\line
  margin: 14px 14px 10px;\line
  padding: 0 12px;\line
  color: var(--gray-neutral);\line
  background: #202630;\line
  border: 1px solid transparent;\line
  border-radius: 8px;\line
\}\line
\line
.chat-search:focus-within \{\line
  border-color: var(--blue-primary);\line
\}\line
\line
.chat-search > span \{\line
  font-size: 19px;\line
  line-height: 1;\line
\}\line
\line
.chat-search input \{\line
  min-width: 0;\line
  flex: 1;\line
  color: var(--ink);\line
  background: transparent;\line
  border: 0;\line
  outline: 0;\line
  font: inherit;\line
  font-size: 12px;\line
\}\line
\line
.chat-search input::placeholder \{\line
  color: var(--gray-neutral);\line
\}\line
\line
.chat-conversation-list \{\line
  min-height: 0;\line
  flex: 1;\line
  overflow-y: auto;\line
\}\line
\line
.chat-conversation-row.chat-group-row \{\line
  min-height: 62px;\line
\}\line
\line
.chat-group-avatar \{\line
  background: #34445e;\line
  border-radius: 14px;\line
  color: #bfdbfe;\line
\}\line
\line
.chat-conversation-row \{\line
  width: 100%;\line
  min-height: 76px;\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  padding: 11px 14px;\line
  color: var(--ink);\line
  background: transparent;\line
  border: 0;\line
  border-bottom: 1px solid rgba(255, 255, 255, 0.045);\line
  text-align: left;\line
  cursor: pointer;\line
\}\line
\line
.chat-conversation-main \{\line
  min-width: 0;\line
  flex: 1;\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  padding: 0;\line
  color: inherit;\line
  background: transparent;\line
  border: 0;\line
  text-align: left;\line
  cursor: pointer;\line
\}\line
\line
.chat-conversation-row:hover,\line
.chat-conversation-row.active \{\line
  background: rgba(255, 255, 255, 0.065);\line
\}\line
\line
.chat-list-avatar \{\line
  width: 46px;\line
  height: 46px;\line
  flex: 0 0 46px;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  overflow: hidden;\line
  color: #fff;\line
  background: var(--blue-primary);\line
  border-radius: 50%;\line
  font-size: 13px;\line
  font-weight: 700;\line
\}\line
\line
.chat-conversation-copy \{\line
  min-width: 0;\line
  flex: 1;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 5px;\line
\}\line
\line
.chat-conversation-topline \{\line
  min-width: 0;\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  gap: 8px;\line
\}\line
\line
.chat-conversation-topline strong \{\line
  overflow: hidden;\line
  color: #f4f4f5;\line
  font-size: 13px;\line
  font-weight: 600;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.chat-conversation-topline time \{\line
  flex: 0 0 auto;\line
  color: var(--gray-neutral);\line
  font-size: 10px;\line
\}\line
\line
.chat-conversation-preview \{\line
  overflow: hidden;\line
  color: var(--gray-neutral);\line
  font-size: 11.5px;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.chat-conversation-preview.unread \{\line
  color: #60a5fa;\line
  font-weight: 700;\line
\}\line
\line
.chat-conversation-badge \{\line
  min-width: 19px;\line
  height: 19px;\line
  flex: 0 0 auto;\line
  display: inline-flex;\line
  align-items: center;\line
  justify-content: center;\line
  padding: 0 5px;\line
  color: #fff;\line
  background: #168b70;\line
  border-radius: 999px;\line
  font-size: 10px;\line
  font-weight: 700;\line
\}\line
\line
.chat-list-empty \{\line
  padding: 20px 16px;\line
  color: var(--gray-neutral);\line
  font-size: 12px;\line
  text-align: center;\line
\}\line
\line
.chat-empty-state \{\line
  min-height: 0;\line
  flex: 1;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  justify-content: center;\line
  padding: 24px;\line
  text-align: center;\line
\}\line
\line
.chat-empty-icon \{\line
  width: 82px;\line
  height: 82px;\line
  display: grid;\line
  place-items: center;\line
  margin-bottom: 20px;\line
  color: #70b8ff;\line
  background: rgba(37, 99, 235, 0.12);\line
  border: 1px solid rgba(96, 165, 250, 0.22);\line
  border-radius: 22px;\line
\}\line
\line
.chat-header-brand-mark \{\line
  width: 38px;\line
  height: 38px;\line
  flex: 0 0 38px;\line
  display: grid;\line
  place-items: center;\line
  color: #fff;\line
  background: var(--blue-primary);\line
  border-radius: 12px;\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 18px;\line
  font-weight: 700;\line
\}\line
\line
.chat-empty-state h2 \{\line
  margin: 0;\line
  color: var(--ink);\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 26px;\line
\}\line
\line
.chat-empty-state p \{\line
  max-width: 320px;\line
  margin: 8px 0 18px;\line
  color: var(--gray-neutral);\line
  font-size: 13px;\line
  line-height: 1.5;\line
\}\line
\line
.chat-empty-state > span \{\line
  margin-bottom: 18px;\line
  color: #7f8b9c;\line
  font-size: 12px;\line
\}\line
\line
.chat-empty-state button \{\line
  padding: 10px 15px;\line
  color: #fff;\line
  background: var(--blue-primary);\line
  border: 0;\line
  border-radius: 8px;\line
  font: inherit;\line
  font-size: 13px;\line
  font-weight: 600;\line
  cursor: pointer;\line
\}\line
\line
.chat-empty-state button:hover \{\line
  background: var(--blue-deep);\line
\}\line
\line
.chat-page \{\line
  min-width: 0;\line
  min-height: 0;\line
  height: 100%;\line
  max-width: none;\line
  margin: 0;\line
  overflow: hidden;\line
  background:\line
    radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.035) 1px, transparent 1.5px) 0 0 / 28px 28px,\line
    #101722;\line
\}\line
\line
.chat-header \{\line
  position: sticky;\line
  top: 0;\line
  z-index: 5;\line
  flex: 0 0 auto;\line
  min-height: 72px;\line
  justify-content: flex-start;\line
  padding: 12px 22px;\line
  background: #181d26;\line
\}\line
\line
.chat-header-details \{\line
  min-width: 0;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 3px;\line
\}\line
\line
.chat-header-details > span \{\line
  color: var(--gray-neutral);\line
  font-size: 11px;\line
\}\line
\line
.chat-back-button \{\line
  display: none;\line
  width: 34px;\line
  height: 34px;\line
  align-items: center;\line
  justify-content: center;\line
  color: var(--ink);\line
  background: transparent;\line
  border: 0;\line
  border-radius: 50%;\line
  font-size: 23px;\line
  cursor: pointer;\line
\}\line
\line
.message-list \{\line
  min-height: 0;\line
  flex: 1 1 auto;\line
  width: 100%;\line
  max-width: 900px;\line
  margin: 0 auto;\line
\}\line
\line
.message-form \{\line
  min-width: 0;\line
  flex: 0 0 auto;\line
  width: 100%;\line
  max-width: 900px;\line
  margin: 0 auto;\line
\}\line
\line
@media (max-width: 1000px) \{\line
  .chat-workspace \{\line
    grid-template-columns: 280px minmax(0, 1fr);\line
  \}\line
\}\line
\line
@media (max-width: 768px) \{\line
  .chat-workspace \{\line
    height: calc(100dvh - 64px);\line
    grid-template-columns: minmax(0, 1fr);\line
  \}\line
\line
  .app-content.has-mobile-page-header .chat-workspace \{\line
    height: calc(100dvh - var(--mobile-header-height) - 64px);\line
  \}\line
\line
  .chat-list-panel \{\line
    display: none;\line
  \}\line
\line
  .chat-workspace:not(.has-conversation) .chat-list-panel \{\line
    display: flex;\line
  \}\line
\line
  .chat-workspace:not(.has-conversation) .chat-page \{\line
    display: none;\line
  \}\line
\line
  .chat-back-button \{\line
    display: inline-flex;\line
  \}\line
\line
  .chat-header \{\line
    gap: 8px;\line
    padding: 10px 12px;\line
  \}\line
\line
  .reply-preview \{\line
    padding: 9px 14px;\line
  \}\line
\}\line
\line
.message-form > .attachment-picker \{\line
  position: relative;\line
  flex: 0 0 auto;\line
  display: flex;\line
  align-items: center;\line
\}\line
\line
.attachment-picker-trigger \{\line
  width: 42px;\line
  height: 42px;\line
  display: grid;\line
  place-items: center;\line
  padding: 0;\line
  color: #60a5fa;\line
  background: transparent;\line
  border: 0;\line
  border-radius: 50%;\line
  cursor: pointer;\line
\}\line
\line
.attachment-picker-trigger:hover,\line
.attachment-picker-trigger[aria-expanded="true"] \{\line
  background: rgba(96, 165, 250, 0.12);\line
\}\line
\line
.attachment-picker-trigger:disabled \{\line
  opacity: 0.5;\line
  cursor: wait;\line
\}\line
\line
.attachment-picker-menu \{\line
  position: absolute;\line
  bottom: calc(100% + 10px);\line
  left: 0;\line
  z-index: 20;\line
  width: min(290px, calc(100vw - 32px));\line
  padding: 6px 0;\line
  color: #e8e8eb;\line
  background: #202125;\line
  border: 1px solid #303137;\line
  border-radius: 12px;\line
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);\line
\}\line
\line
.attachment-picker-menu button,\line
.attachment-picker-sheet > button:not(.attachment-picker-close) \{\line
  width: 100%;\line
  min-height: 52px;\line
  display: flex;\line
  align-items: center;\line
  gap: 15px;\line
  padding: 10px 17px;\line
  color: inherit;\line
  background: transparent;\line
  border: 0;\line
  font: inherit;\line
  font-size: 14px;\line
  text-align: left;\line
  cursor: pointer;\line
\}\line
\line
.attachment-picker-menu button:hover,\line
.attachment-picker-sheet > button:not(.attachment-picker-close):hover \{\line
  background: #2b2c31;\line
\}\line
\line
.attachment-picker-menu svg,\line
.attachment-picker-sheet > button svg \{\line
  width: 22px;\line
  height: 22px;\line
  flex: 0 0 auto;\line
  fill: none;\line
  stroke: #60a5fa;\line
  stroke-linecap: round;\line
  stroke-linejoin: round;\line
  stroke-width: 1.8;\line
\}\line
\line
.attachment-picker-input \{\line
  display: none;\line
\}\line
\line
.attachment-picker-backdrop \{\line
  position: fixed;\line
  inset: 0;\line
  z-index: 100;\line
  display: flex;\line
  align-items: flex-end;\line
  justify-content: center;\line
  padding: 16px;\line
  background: rgba(0, 0, 0, 0.58);\line
\}\line
\line
.attachment-picker-sheet \{\line
  position: relative;\line
  width: min(440px, 100%);\line
  padding: 24px 14px 12px;\line
  color: #e8e8eb;\line
  background: #202125;\line
  border: 1px solid #303137;\line
  border-radius: 18px;\line
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);\line
\}\line
\line
.attachment-picker-sheet h2 \{\line
  margin: 0 34px 5px;\line
  font-size: 17px;\line
  text-align: center;\line
\}\line
\line
.attachment-picker-sheet p \{\line
  margin: 0 20px 13px;\line
  color: #a0a1a8;\line
  font-size: 13px;\line
  text-align: center;\line
\}\line
\line
.attachment-picker-sheet > button:not(.attachment-picker-close) \{\line
  min-height: 56px;\line
  justify-content: space-between;\line
  border-radius: 9px;\line
\}\line
\line
.attachment-picker-close \{\line
  position: absolute;\line
  top: 12px;\line
  right: 12px;\line
  width: 30px;\line
  height: 30px;\line
  color: #c7c8ce;\line
  background: #303137;\line
  border: 0;\line
  border-radius: 50%;\line
  font-size: 23px;\line
  line-height: 1;\line
  cursor: pointer;\line
\}\line
\line
.message-attachment \{\line
  max-width: min(100%, 360px);\line
  margin-top: 8px;\line
\}\line
\line
.message-attachment-file \{\line
  display: flex;\line
  align-items: center;\line
  gap: 10px;\line
  max-width: 100%;\line
  padding: 9px 11px;\line
  color: inherit;\line
  background: rgba(0, 0, 0, 0.12);\line
  border: 1px solid rgba(255, 255, 255, 0.14);\line
  border-radius: 10px;\line
\}\line
\line
.message-attachment-status \{\line
  display: block;\line
  margin: 0 0 6px;\line
  color: rgba(255, 255, 255, 0.75);\line
  font-size: 11px;\line
\}\line
\line
.message-attachment-download-button \{\line
  width: 34px;\line
  height: 34px;\line
  display: grid;\line
  flex: 0 0 auto;\line
  place-items: center;\line
  padding: 0;\line
  color: inherit;\line
  background: rgba(255, 255, 255, 0.1);\line
  border: 1px solid rgba(255, 255, 255, 0.16);\line
  border-radius: 50%;\line
  cursor: pointer;\line
\}\line
\line
.message-attachment-download-button:hover \{\line
  background: rgba(255, 255, 255, 0.2);\line
\}\line
\line
.message-attachment-download-button:disabled \{\line
  opacity: 0.65;\line
  cursor: wait;\line
\}\line
\line
.message-attachment-icon \{\line
  font-size: 22px;\line
  line-height: 1;\line
\}\line
\line
.message-attachment-details \{\line
  min-width: 0;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 3px;\line
\}\line
\line
.message-attachment-details strong \{\line
  overflow: hidden;\line
  font-size: 12px;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.message-attachment-details small,\line
.message-attachment-error \{\line
  color: rgba(255, 255, 255, 0.75);\line
  font-size: 11px;\line
\}\line
\line
.message-attachment-preview \{\line
  display: block;\line
  max-width: min(100%, 360px);\line
  max-height: 360px;\line
  border-radius: 10px;\line
  object-fit: contain;\line
\}\line
\line
.message-document-preview \{\line
  display: block;\line
  width: min(100%, 360px);\line
  height: 420px;\line
  margin: 0 0 8px;\line
  background: #fff;\line
  border: 1px solid rgba(255, 255, 255, 0.14);\line
  border-radius: 10px;\line
\}\line
\line
.message-attachment-error \{\line
  display: block;\line
  margin-top: 5px;\line
  color: #fecaca;\line
\}\line
\line
.send-button:disabled \{\line
  opacity: 0.7;\line
  cursor: wait;\line
\}\line
\line
@media (max-width: 480px) \{\line
  .attachment-picker-backdrop \{\line
    padding: 8px;\line
  \}\line
\line
  .attachment-picker-sheet \{\line
    padding-bottom: max(12px, env(safe-area-inset-bottom));\line
  \}\line
\line
  .attachment-picker-trigger \{\line
    width: 36px;\line
    height: 42px;\line
  \}\line
\}\line
\line
.voice-note-control \{\line
  display: flex;\line
  flex: 0 0 auto;\line
  align-items: center;\line
  gap: 4px;\line
\}\line
\line
.voice-note-button \{\line
  width: 42px;\line
  height: 42px;\line
  display: grid;\line
  flex: 0 0 auto;\line
  place-items: center;\line
  padding: 0;\line
  color: #60a5fa;\line
  background: transparent;\line
  border: 0;\line
  border-radius: 50%;\line
  cursor: pointer;\line
\}\line
\line
.voice-note-button:hover \{\line
  background: rgba(96, 165, 250, 0.12);\line
\}\line
\line
.voice-note-button:disabled \{\line
  opacity: 0.5;\line
  cursor: wait;\line
\}\line
\line
.voice-note-control.is-recording .voice-note-button \{\line
  color: #fff;\line
  background: #e54862;\line
  animation: voice-note-pulse 1.3s ease-in-out infinite;\line
\}\line
\line
.voice-note-timer \{\line
  color: #fda4af;\line
  font-size: 12px;\line
  font-variant-numeric: tabular-nums;\line
\}\line
\line
.message-audio-player \{\line
  display: flex;\line
  align-items: center;\line
  gap: 8px;\line
  width: min(300px, 100%);\line
  margin-top: 6px;\line
\}\line
\line
.message-audio-player audio \{\line
  display: none;\line
\}\line
\line
.message-audio-toggle \{\line
  width: 34px;\line
  height: 34px;\line
  display: grid;\line
  flex: 0 0 auto;\line
  place-items: center;\line
  padding: 0;\line
  color: #fff;\line
  background: rgba(0, 0, 0, 0.2);\line
  border: 1px solid rgba(255, 255, 255, 0.2);\line
  border-radius: 50%;\line
  cursor: pointer;\line
\}\line
\line
.message-audio-toggle svg \{\line
  width: 18px;\line
  height: 18px;\line
  fill: currentColor;\line
\}\line
\line
.message-audio-toggle:disabled \{\line
  opacity: 0.6;\line
  cursor: wait;\line
\}\line
\line
.message-audio-progress \{\line
  min-width: 30px;\line
  flex: 1;\line
  accent-color: #93c5fd;\line
  cursor: pointer;\line
\}\line
\line
.message-audio-time \{\line
  flex: 0 0 auto;\line
  font-size: 10px;\line
  font-variant-numeric: tabular-nums;\line
  opacity: 0.8;\line
\}\line
\line
.send-button-icon \{\line
  display: none;\line
\}\line
\line
@keyframes voice-note-pulse \{\line
  50% \{\line
    box-shadow: 0 0 0 5px rgba(229, 72, 98, 0.2);\line
  \}\line
\}\line
\line
@media (max-width: 640px) \{\line
  .voice-note-button \{\line
    width: 38px;\line
  \}\line
\line
  .send-button \{\line
    min-width: 44px;\line
    width: 44px;\line
    height: 44px;\line
    display: grid;\line
    place-items: center;\line
    padding: 0;\line
  \}\line
\line
  .send-button-text \{\line
    position: absolute;\line
    width: 1px;\line
    height: 1px;\line
    overflow: hidden;\line
    clip: rect(0, 0, 0, 0);\line
    white-space: nowrap;\line
  \}\line
\line
  .send-button-icon \{\line
    display: block;\line
  \}\line
\}\line
\line
@media (prefers-reduced-motion: reduce) \{\line
  .voice-note-control.is-recording .voice-note-button \{\line
    animation: none;\line
  \}\line
\}\line
\line
/* Refined direct-message layout inspired by the mobile UI in public/ui. */\line
.chat-workspace \{\line
  background: #090a0c;\line
\}\line
\line
.chat-list-panel \{\line
  background: #101114;\line
  border-right-color: #25262a;\line
\}\line
\line
.chat-list-panel-header \{\line
  min-height: 78px;\line
  padding: 0 20px;\line
  background: #101114;\line
  border-bottom: 0;\line
\}\line
\line
.chat-list-heading \{\line
  display: flex;\line
  flex-direction: column;\line
  gap: 4px;\line
\}\line
\line
.chat-list-panel-header h1 \{\line
  font-size: 23px;\line
  letter-spacing: -0.04em;\line
\}\line
\line
.chat-list-heading > span \{\line
  color: #85878e;\line
  font-size: 11px;\line
\}\line
\line
.chat-list-panel-header .chat-add-menu > button \{\line
  width: 40px;\line
  height: 40px;\line
  border-radius: 50%;\line
  background: #2563eb;\line
  font-size: 25px;\line
  box-shadow: 0 5px 16px rgba(37, 99, 235, 0.25);\line
\}\line
\line
.chat-list-tabs \{\line
  gap: 18px;\line
  padding: 0 20px;\line
  border-bottom-color: #25262a;\line
\}\line
\line
.chat-list-tabs button \{\line
  gap: 7px;\line
  padding: 12px 0 13px;\line
  color: #92949b;\line
\}\line
\line
.chat-list-tabs button.active \{\line
  color: #f5f5f6;\line
  border-bottom-color: #fff;\line
\}\line
\line
.chat-list-tabs button span \{\line
  min-width: 19px;\line
  color: #fff;\line
  background: #e54862;\line
\}\line
\line
.chat-list-tabs button.active span \{\line
  color: #fff;\line
  background: #e54862;\line
\}\line
\line
.chat-search \{\line
  height: 40px;\line
  margin: 12px 14px 8px;\line
  background: #202125;\line
  border: 0;\line
  border-radius: 10px;\line
\}\line
\line
.chat-search:focus-within \{\line
  box-shadow: 0 0 0 1px #3d3e43;\line
\}\line
\line
.chat-search input \{\line
  font-size: 13px;\line
\}\line
\line
.chat-conversation-list \{\line
  scrollbar-color: #383a40 transparent;\line
  scrollbar-width: thin;\line
\}\line
\line
.chat-conversation-row,\line
.chat-conversation-row.chat-group-row \{\line
  min-height: 76px;\line
  gap: 12px;\line
  padding: 10px 14px;\line
  border-bottom-color: rgba(255, 255, 255, 0.055);\line
\}\line
\line
.chat-conversation-row:hover,\line
.chat-conversation-row.active \{\line
  background: rgba(255, 255, 255, 0.045);\line
\}\line
\line
.chat-list-avatar \{\line
  width: 52px;\line
  height: 52px;\line
  flex-basis: 52px;\line
  border: 1px solid rgba(255, 255, 255, 0.18);\line
\}\line
\line
.chat-conversation-topline \{\line
  align-items: baseline;\line
\}\line
\line
.chat-conversation-topline strong \{\line
  color: #f3f3f4;\line
  font-size: 13px;\line
  font-weight: 500;\line
\}\line
\line
.chat-conversation-topline time \{\line
  color: #898b91;\line
  font-size: 11px;\line
\}\line
\line
.chat-conversation-preview \{\line
  color: #9b9da3;\line
  font-size: 12px;\line
\}\line
\line
.chat-conversation-preview.unread \{\line
  color: #f2f2f3;\line
\}\line
\line
.chat-conversation-badge \{\line
  min-width: 19px;\line
  height: 19px;\line
  color: #fff;\line
  background: #e54862;\line
\}\line
\line
.chat-group-avatar \{\line
  background: #292d3a;\line
\}\line
\line
.chat-page \{\line
  background: #0c0d10;\line
\}\line
\line
.chat-header \{\line
  min-height: 76px;\line
  padding: 12px 24px;\line
  background: #101114;\line
  border-bottom-color: #25262a;\line
\}\line
\line
.chat-header-name \{\line
  font-size: 15px;\line
\}\line
\line
.chat-header-details > span \{\line
  font-size: 11px;\line
\}\line
\line
.message-list \{\line
  gap: 12px;\line
  padding: 24px clamp(18px, 5vw, 56px);\line
  scrollbar-color: #383a40 transparent;\line
  scrollbar-width: thin;\line
\}\line
\line
.message \{\line
  max-width: min(72%, 620px);\line
  border-radius: 18px;\line
\}\line
\line
.message-mine \{\line
  background: #2563eb;\line
  box-shadow: none;\line
\}\line
\line
.message-theirs \{\line
  background: #202125;\line
  border-color: #2d2e33;\line
\}\line
\line
.message-form \{\line
  gap: 12px;\line
  padding: 14px 20px max(14px, env(safe-area-inset-bottom));\line
  background: #101114;\line
  border-top-color: #25262a;\line
\}\line
\line
.message-input \{\line
  min-height: 46px;\line
  padding: 12px 18px;\line
  background: #202125;\line
  border: 1px solid #303137;\line
\}\line
\line
.message-input:focus \{\line
  background: #202125;\line
\}\line
\line
.send-button \{\line
  min-width: 82px;\line
\}\line
\line
.group-chat-page \{\line
  width: 100%;\line
  max-width: none;\line
  height: 100%;\line
  min-height: 0;\line
  margin: 0;\line
  overflow: hidden;\line
  background: #0c0d10;\line
\}\line
\line
.group-chat-page .chat-header \{\line
  justify-content: flex-start;\line
\}\line
\line
.group-chat-page .chat-back-button \{\line
  display: inline-flex;\line
\}\line
\line
@media (min-width: 769px) \{\line
  .chat-workspace \{\line
    height: 100dvh;\line
    grid-template-columns: minmax(300px, 360px) minmax(0, 1fr);\line
  \}\line
\line
  .chat-list-panel \{\line
    box-shadow: 6px 0 24px rgba(0, 0, 0, 0.12);\line
  \}\line
\line
  .chat-page:not(.group-chat-page) \{\line
    min-height: 0;\line
  \}\line
\line
  .chat-page:not(.group-chat-page) .chat-header \{\line
    padding-left: 34px;\line
  \}\line
\line
  .chat-page:not(.group-chat-page) .message-form \{\line
    padding-left: 34px;\line
    padding-right: 34px;\line
  \}\line
\}\line
\line
@media (max-width: 768px) \{\line
  .chat-workspace \{\line
    height: calc(100dvh - 64px);\line
  \}\line
\line
  .app-content.has-mobile-page-header .chat-workspace \{\line
    height: calc(100dvh - var(--mobile-header-height) - 64px);\line
  \}\line
\line
  .chat-list-panel-header \{\line
    min-height: 72px;\line
    padding: 0 16px;\line
  \}\line
\line
  .chat-list-tabs \{\line
    padding-right: 16px;\line
    padding-left: 16px;\line
  \}\line
\line
  .chat-list-row,\line
  .chat-conversation-row,\line
  .chat-conversation-row.chat-group-row \{\line
    min-height: 72px;\line
    padding-right: 14px;\line
    padding-left: 14px;\line
  \}\line
\line
  .chat-list-avatar \{\line
    width: 50px;\line
    height: 50px;\line
    flex-basis: 50px;\line
  \}\line
\line
  .chat-page:not(.group-chat-page) .chat-header \{\line
    min-height: 66px;\line
    padding: 9px 12px;\line
  \}\line
\line
  .group-chat-page \{\line
    height: calc(100dvh - 64px);\line
    min-height: 0;\line
  \}\line
\line
  .group-chat-page .chat-header \{\line
    min-height: 66px;\line
    padding: 9px 12px;\line
  \}\line
\line
  .message-list \{\line
    padding: 16px 14px;\line
  \}\line
\line
  .message \{\line
    max-width: 86%;\line
  \}\line
\line
  .message-form \{\line
    padding: 10px 12px max(10px, env(safe-area-inset-bottom));\line
  \}\line
\line
  .message-input \{\line
    min-height: 44px;\line
    padding: 10px 15px;\line
    font-size: 14px;\line
  \}\line
\line
  .send-button \{\line
    min-width: 70px;\line
    padding: 0 14px;\line
  \}\line
\}}\par\par
\b src/css/Profile.css\b0\par
{\f1\fs15\cf2 .profile-page \{\line
  min-height: 100vh;\line
  padding: 34px 28px 56px;\line
  color: var(--theme-text);\line
  background: var(--theme-page);\line
  font-family: "Inter", sans-serif;\line
\}\line
\line
.profile-shell \{\line
  width: min(100%, 900px);\line
  margin: 0 auto;\line
\}\line
\line
.profile-card,\line
.profile-content \{\line
  overflow: hidden;\line
  background: var(--theme-surface);\line
  border: 1px solid var(--theme-border);\line
  border-radius: 20px;\line
  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.1);\line
\}\line
\line
.profile-card \{\line
  padding: 30px 34px 24px;\line
\}\line
\line
.profile-identity \{\line
  display: grid;\line
  grid-template-columns: 142px minmax(0, 1fr) auto;\line
  align-items: center;\line
  gap: 25px;\line
\}\line
\line
.profile-avatar-wrap \{\line
  position: relative;\line
  width: 126px;\line
  height: 126px;\line
  margin: 0 auto;\line
  padding: 0;\line
  background: transparent;\line
  border-radius: 50%;\line
\}\line
\line
.profile-avatar-wrap.has-active-status \{\line
  padding: 4px;\line
  background: conic-gradient(from 215deg, #f0a53b, #d74674, #8058c8, #f0a53b);\line
  box-shadow: 0 0 18px rgba(215, 70, 116, 0.35);\line
\}\line
\line
.profile-avatar \{\line
  width: 100%;\line
  height: 100%;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  overflow: hidden;\line
  color: #fff;\line
  background: var(--theme-surface-raised);\line
  border: 4px solid var(--theme-surface);\line
  border-radius: 50%;\line
  font-size: 34px;\line
  font-weight: 700;\line
  object-fit: cover;\line
\}\line
\line
.profile-avatar-edit \{\line
  position: absolute;\line
  right: -2px;\line
  bottom: 3px;\line
  width: 31px;\line
  height: 31px;\line
  display: grid;\line
  place-items: center;\line
  padding: 0;\line
  color: #fff;\line
  background: #3b82f6;\line
  border: 3px solid var(--theme-surface);\line
  border-radius: 50%;\line
  line-height: 1;\line
  cursor: pointer;\line
\}\line
\line
.profile-avatar-edit svg \{\line
  width: 15px;\line
  height: 15px;\line
\}\line
\line
.profile-avatar-edit:disabled \{\line
  cursor: wait;\line
\}\line
\line
.profile-photo-input \{\line
  display: none;\line
\}\line
\line
.profile-identity-copy \{\line
  min-width: 0;\line
\}\line
\line
.profile-identity-copy h1 \{\line
  margin: 0;\line
  color: var(--theme-text);\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: clamp(23px, 3vw, 30px);\line
  line-height: 1.2;\line
  overflow-wrap: anywhere;\line
\}\line
\line
.profile-identity-copy p \{\line
  margin: 6px 0 12px;\line
  color: var(--theme-muted);\line
  font-size: 13px;\line
  overflow-wrap: anywhere;\line
\}\line
\line
.profile-identity-copy > span \{\line
  color: var(--theme-text);\line
  font-size: 13px;\line
  line-height: 1.5;\line
\}\line
\line
.profile-edit-button \{\line
  min-width: 104px;\line
  padding: 10px 15px;\line
  color: var(--theme-text);\line
  background: var(--theme-surface-raised);\line
  border: 1px solid var(--theme-border);\line
  border-radius: 9px;\line
  font: inherit;\line
  font-size: 12px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.profile-edit-button:hover \{\line
  border-color: #528cf5;\line
\}\line
\line
.profile-remove-friend-button \{\line
  min-width: 118px;\line
  padding: 10px 12px;\line
  color: #bd354e;\line
  background: rgba(224, 82, 107, 0.09);\line
  border: 1px solid rgba(224, 82, 107, 0.3);\line
  border-radius: 9px;\line
  font: inherit;\line
  font-size: 12px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.profile-visitor-actions \{\line
  display: flex;\line
  flex-wrap: wrap;\line
  justify-content: flex-end;\line
  gap: 8px;\line
\}\line
\line
.profile-message-friend-button \{\line
  min-width: 92px;\line
  padding: 10px 12px;\line
  color: #fff;\line
  background: #3b82f6;\line
  border: 1px solid #3b82f6;\line
  border-radius: 9px;\line
  font: inherit;\line
  font-size: 12px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.profile-message-friend-button:hover \{\line
  background: #2563eb;\line
\}\line
\line
.profile-remove-friend-button:disabled \{\line
  opacity: 0.6;\line
  cursor: wait;\line
\}\line
\line
.profile-stats \{\line
  display: flex;\line
  justify-content: center;\line
  gap: clamp(28px, 9vw, 108px);\line
  margin: 26px 0 24px;\line
  padding: 18px 12px;\line
  background: var(--theme-surface-raised);\line
  border: 1px solid var(--theme-border);\line
  border-radius: 14px;\line
\}\line
\line
.profile-stats > div \{\line
  min-width: 72px;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  gap: 4px;\line
\}\line
\line
.profile-friends-stat \{\line
  min-width: 72px;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  gap: 4px;\line
  padding: 0;\line
  background: transparent;\line
  border: 0;\line
  font: inherit;\line
  cursor: pointer;\line
\}\line
\line
.profile-friends-stat:disabled \{\line
  cursor: default;\line
\}\line
\line
.profile-friends-stat:focus-visible \{\line
  outline: 2px solid #528cf5;\line
  outline-offset: 5px;\line
  border-radius: 4px;\line
\}\line
\line
.profile-stats strong \{\line
  color: var(--theme-text);\line
  font-size: 17px;\line
\}\line
\line
.profile-stats span \{\line
  color: var(--theme-muted);\line
  font-size: 11px;\line
\}\line
\line
.profile-highlights-heading \{\line
  display: flex;\line
  align-items: baseline;\line
  justify-content: space-between;\line
  gap: 12px;\line
  margin-bottom: 13px;\line
\}\line
\line
.profile-highlights-heading h2 \{\line
  margin: 0;\line
  color: var(--theme-text);\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 14px;\line
\}\line
\line
.profile-highlights-heading > span \{\line
  color: var(--theme-muted);\line
  font-size: 11px;\line
\}\line
\line
.profile-highlight-list \{\line
  display: flex;\line
  gap: 20px;\line
  overflow-x: auto;\line
  padding: 3px 2px 5px;\line
  scrollbar-width: thin;\line
\}\line
\line
.profile-highlight,\line
.profile-highlight-empty \{\line
  width: 70px;\line
  flex: 0 0 70px;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  gap: 7px;\line
\}\line
\line
.profile-highlight-ring \{\line
  width: 62px;\line
  height: 62px;\line
  padding: 3px;\line
  background: conic-gradient(from 215deg, #f0a53b, #d74674, #8058c8, #f0a53b);\line
  border-radius: 50%;\line
\}\line
\line
.profile-highlight-content \{\line
  width: 100%;\line
  height: 100%;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  overflow: hidden;\line
  padding: 5px;\line
  color: #fff;\line
  border: 2px solid var(--theme-surface);\line
  border-radius: 50%;\line
  font-size: 9px;\line
  line-height: 1.2;\line
  text-align: center;\line
  overflow-wrap: anywhere;\line
\}\line
\line
.profile-highlight > span,\line
.profile-highlight-empty > span:last-child \{\line
  max-width: 100%;\line
  overflow: hidden;\line
  color: var(--theme-muted);\line
  font-size: 10px;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.profile-highlight-add \{\line
  width: 62px;\line
  height: 62px;\line
  display: grid;\line
  place-items: center;\line
  color: #528cf5;\line
  background: var(--theme-surface-raised);\line
  border: 1px dashed var(--theme-border);\line
  border-radius: 50%;\line
  font-size: 25px;\line
\}\line
\line
.profile-error \{\line
  margin: 16px 0;\line
  padding: 12px 14px;\line
  color: #e0526b;\line
  background: rgba(224, 82, 107, 0.1);\line
  border: 1px solid rgba(224, 82, 107, 0.25);\line
  border-radius: 10px;\line
  font-size: 13px;\line
\}\line
\line
.profile-content \{\line
  margin-top: 20px;\line
\}\line
\line
.profile-mobile-actions \{\line
  display: none;\line
\}\line
\line
.profile-tabs \{\line
  min-height: 54px;\line
  display: flex;\line
  justify-content: center;\line
  gap: 40px;\line
  border-bottom: 1px solid var(--theme-border);\line
\}\line
\line
.profile-tabs button \{\line
  position: relative;\line
  display: inline-flex;\line
  align-items: center;\line
  gap: 8px;\line
  padding: 0 5px;\line
  color: var(--theme-muted);\line
  background: transparent;\line
  border: 0;\line
  font: inherit;\line
  font-size: 11px;\line
  font-weight: 700;\line
  letter-spacing: 0.04em;\line
  text-transform: uppercase;\line
  cursor: pointer;\line
\}\line
\line
.profile-tabs button.active \{\line
  color: var(--theme-text);\line
\}\line
\line
.profile-tabs button.active::after \{\line
  position: absolute;\line
  right: 0;\line
  bottom: -1px;\line
  left: 0;\line
  height: 2px;\line
  background: #528cf5;\line
  content: "";\line
\}\line
\line
.profile-tab-count \{\line
  color: var(--theme-muted);\line
  font-size: 10px;\line
\}\line
\line
.profile-post-grid,\line
.profile-status-grid \{\line
  display: grid;\line
  grid-template-columns: repeat(3, minmax(0, 1fr));\line
  gap: 3px;\line
  padding: 3px;\line
\}\line
\line
.profile-post-tile \{\line
  position: relative;\line
  min-width: 0;\line
  overflow: hidden;\line
  aspect-ratio: 1;\line
  background: var(--theme-surface-raised);\line
\}\line
\line
.profile-post-tile > img \{\line
  width: 100%;\line
  height: 100%;\line
  display: block;\line
  object-fit: cover;\line
\}\line
\line
.profile-post-text-tile \{\line
  width: 100%;\line
  height: 100%;\line
  display: grid;\line
  place-items: center;\line
  overflow: hidden;\line
  padding: 14px;\line
  color: var(--theme-text);\line
  background: linear-gradient(145deg, #273953, #6449a9);\line
  font-size: 13px;\line
  line-height: 1.45;\line
  text-align: center;\line
  overflow-wrap: anywhere;\line
\}\line
\line
.profile-post-overlay \{\line
  position: absolute;\line
  inset: 0;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  justify-content: center;\line
  gap: 10px;\line
  padding: 12px;\line
  color: #fff;\line
  background: rgba(9, 10, 14, 0.75);\line
  opacity: 0;\line
  transition: opacity 140ms ease;\line
\}\line
\line
.profile-post-tile:hover .profile-post-overlay,\line
.profile-post-tile:focus-within .profile-post-overlay \{\line
  opacity: 1;\line
\}\line
\line
.profile-post-overlay > span \{\line
  max-width: 100%;\line
  display: -webkit-box;\line
  overflow: hidden;\line
  font-size: 11px;\line
  line-height: 1.4;\line
  text-align: center;\line
  -webkit-box-orient: vertical;\line
  -webkit-line-clamp: 3;\line
\}\line
\line
.profile-post-overlay button,\line
.profile-status-tile button \{\line
  padding: 7px 11px;\line
  color: #fff;\line
  background: rgba(15, 17, 22, 0.75);\line
  border: 1px solid rgba(255, 255, 255, 0.35);\line
  border-radius: 7px;\line
  font: inherit;\line
  font-size: 11px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.profile-status-grid \{\line
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\line
  gap: 10px;\line
  padding: 14px;\line
\}\line
\line
.profile-status-tile \{\line
  min-height: 200px;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  justify-content: center;\line
  gap: 10px;\line
  overflow: hidden;\line
  padding: 18px 13px 12px;\line
  color: #fff;\line
  border-radius: 11px;\line
  text-align: center;\line
\}\line
\line
.profile-status-tile p \{\line
  width: 100%;\line
  flex: 1;\line
  display: grid;\line
  place-items: center;\line
  margin: 0;\line
  font-size: 14px;\line
  font-weight: 700;\line
  line-height: 1.5;\line
  overflow-wrap: anywhere;\line
\}\line
\line
.profile-status-tile time \{\line
  font-size: 10px;\line
  opacity: 0.8;\line
\}\line
\line
.profile-empty \{\line
  margin: 0;\line
  padding: 42px 20px;\line
  color: var(--theme-muted);\line
  font-size: 13px;\line
  text-align: center;\line
\}\line
\line
.profile-friends-backdrop \{\line
  position: fixed;\line
  inset: 0;\line
  z-index: 250;\line
  display: grid;\line
  place-items: center;\line
  padding: 18px;\line
  background: rgba(8, 10, 16, 0.68);\line
\}\line
\line
.profile-friends-dialog \{\line
  width: min(100%, 480px);\line
  max-height: min(80vh, 640px);\line
  display: flex;\line
  flex-direction: column;\line
  overflow: hidden;\line
  color: var(--theme-text);\line
  background: var(--theme-surface);\line
  border: 1px solid var(--theme-border);\line
  border-radius: 18px;\line
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);\line
\}\line
\line
.profile-friends-dialog > header \{\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  padding: 18px 20px;\line
  border-bottom: 1px solid var(--theme-border);\line
\}\line
\line
.profile-friends-dialog > header h2 \{\line
  margin: 0;\line
  font: 600 18px "Space Grotesk", sans-serif;\line
\}\line
\line
.profile-friends-dialog > header span \{\line
  display: block;\line
  margin-top: 4px;\line
  color: var(--theme-muted);\line
  font-size: 12px;\line
\}\line
\line
.profile-friends-dialog > header button \{\line
  width: 34px;\line
  height: 34px;\line
  color: var(--theme-muted);\line
  background: var(--theme-surface-raised);\line
  border: 1px solid var(--theme-border);\line
  border-radius: 50%;\line
  font-size: 22px;\line
  cursor: pointer;\line
\}\line
\line
.profile-friends-list \{\line
  overflow-y: auto;\line
  margin: 0;\line
  padding: 7px 14px;\line
  list-style: none;\line
\}\line
\line
.profile-friends-list li \{\line
  min-height: 66px;\line
  display: flex;\line
  align-items: center;\line
  gap: 11px;\line
  padding: 9px 3px;\line
  border-bottom: 1px solid var(--theme-border);\line
\}\line
\line
.profile-friend-avatar \{\line
  width: 42px;\line
  height: 42px;\line
  flex: 0 0 42px;\line
  display: grid;\line
  place-items: center;\line
  overflow: hidden;\line
  color: #fff;\line
  background: var(--theme-surface-raised);\line
  border-radius: 50%;\line
  font-size: 12px;\line
  font-weight: 700;\line
  object-fit: cover;\line
\}\line
\line
.profile-friends-list li > strong \{\line
  min-width: 0;\line
  flex: 1;\line
  overflow: hidden;\line
  font-size: 13px;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.profile-friend-actions \{\line
  display: flex;\line
  gap: 7px;\line
\}\line
\line
.profile-friend-actions button \{\line
  padding: 8px 10px;\line
  color: #fff;\line
  background: #3b82f6;\line
  border: 0;\line
  border-radius: 8px;\line
  font: inherit;\line
  font-size: 11px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.profile-friend-actions button.remove \{\line
  color: var(--theme-text);\line
  background: var(--theme-surface-raised);\line
  border: 1px solid var(--theme-border);\line
\}\line
\line
.profile-friend-actions button:disabled \{\line
  opacity: 0.6;\line
  cursor: wait;\line
\}\line
\line
.profile-friends-empty \{\line
  margin: 0;\line
  padding: 34px 18px;\line
  color: var(--theme-muted);\line
  font-size: 13px;\line
  text-align: center;\line
\}\line
\line
@media (max-width: 700px) \{\line
  .profile-page \{\line
    min-height: calc(100vh - 122px);\line
    padding: 16px 12px 28px;\line
  \}\line
\line
  .profile-card \{\line
    padding: 22px 16px 18px;\line
    border-radius: 16px;\line
  \}\line
\line
  .profile-identity \{\line
    grid-template-columns: 96px minmax(0, 1fr);\line
    gap: 14px;\line
  \}\line
\line
  .profile-avatar-wrap \{\line
    width: 90px;\line
    height: 90px;\line
  \}\line
\line
  .profile-avatar-edit \{\line
    width: 28px;\line
    height: 28px;\line
  \}\line
\line
  .profile-identity-copy h1 \{\line
    font-size: 21px;\line
  \}\line
\line
  .profile-identity-copy p \{\line
    margin: 4px 0 7px;\line
    font-size: 11px;\line
  \}\line
\line
  .profile-identity-copy > span \{\line
    font-size: 11px;\line
  \}\line
\line
  .profile-edit-button,\line
  .profile-visitor-actions \{\line
    grid-column: 1 / -1;\line
    width: 100%;\line
  \}\line
\line
  .profile-visitor-actions > button \{\line
    flex: 1;\line
    padding: 9px;\line
  \}\line
\line
  .profile-stats \{\line
    gap: 0;\line
    justify-content: space-around;\line
    margin: 18px 0;\line
    padding: 13px 6px;\line
  \}\line
\line
  .profile-stats > div,\line
  .profile-stats > button \{\line
    min-width: 0;\line
    flex: 1;\line
  \}\line
\line
  .profile-stats strong \{\line
    font-size: 15px;\line
  \}\line
\line
  .profile-stats span \{\line
    font-size: 10px;\line
    text-align: center;\line
  \}\line
\line
  .profile-highlight-list \{\line
    gap: 13px;\line
  \}\line
\line
  .profile-content \{\line
    margin-top: 14px;\line
    border-radius: 13px;\line
  \}\line
\line
  .profile-tabs \{\line
    min-height: 48px;\line
    gap: 30px;\line
  \}\line
\line
  .profile-tabs button \{\line
    font-size: 10px;\line
  \}\line
\line
  .profile-post-grid \{\line
    gap: 2px;\line
    padding: 2px;\line
  \}\line
\line
  .profile-post-overlay \{\line
    opacity: 1;\line
    align-items: flex-end;\line
    justify-content: flex-end;\line
    padding: 7px;\line
    background: linear-gradient(transparent 45%, rgba(0, 0, 0, 0.64));\line
  \}\line
\line
  .profile-post-overlay > span \{\line
    display: none;\line
  \}\line
\line
  .profile-post-overlay button \{\line
    padding: 5px 7px;\line
    font-size: 9px;\line
  \}\line
\}\line
\line
@media (max-width: 768px) \{\line
  .profile-mobile-actions \{\line
    display: flex;\line
    flex-direction: column;\line
    overflow: hidden;\line
    margin-top: 14px;\line
    background: var(--theme-surface);\line
    border: 1px solid var(--theme-border);\line
    border-radius: 13px;\line
  \}\line
\line
  .profile-mobile-actions > a,\line
  .profile-mobile-actions > button \{\line
    min-height: 62px;\line
    display: flex;\line
    align-items: center;\line
    gap: 12px;\line
    padding: 10px 14px;\line
    color: var(--theme-text);\line
    background: transparent;\line
    border: 0;\line
    font: inherit;\line
    text-align: left;\line
    text-decoration: none;\line
    cursor: pointer;\line
  \}\line
\line
  .profile-mobile-actions > * + * \{\line
    border-top: 1px solid var(--theme-border);\line
  \}\line
\line
  .profile-mobile-actions > *:hover,\line
  .profile-mobile-actions > *:focus-visible \{\line
    background: var(--theme-surface-raised);\line
    outline: none;\line
  \}\line
\line
  .profile-mobile-action-icon \{\line
    width: 36px;\line
    height: 36px;\line
    flex: 0 0 36px;\line
    display: grid;\line
    place-items: center;\line
    color: #528cf5;\line
    background: rgba(82, 140, 245, 0.12);\line
    border-radius: 11px;\line
    font-size: 18px;\line
  \}\line
\line
  .profile-mobile-action-icon.logout \{\line
    color: #e0526b;\line
    background: rgba(224, 82, 107, 0.12);\line
  \}\line
\line
  .profile-mobile-actions > * > span:nth-child(2) \{\line
    min-width: 0;\line
    flex: 1;\line
    display: flex;\line
    flex-direction: column;\line
    gap: 3px;\line
  \}\line
\line
  .profile-mobile-actions strong \{\line
    font-size: 12px;\line
  \}\line
\line
  .profile-mobile-actions small \{\line
    color: var(--theme-muted);\line
    font-size: 10px;\line
  \}\line
\line
  .profile-mobile-action-arrow \{\line
    color: var(--theme-muted);\line
    font-size: 21px;\line
  \}\line
\}\line
\line
@media (prefers-reduced-motion: reduce) \{\line
  .profile-post-overlay,\line
  .profile-edit-button,\line
  .profile-avatar-edit \{\line
    transition: none;\line
  \}\line
\}}\par\par
\b src/css/NewChat.css\b0\par
{\f1\fs15\cf2 .newchat-page \{\line
  width: min(100%, 860px);\line
  margin: 0 auto;\line
  padding: 32px clamp(16px, 4vw, 36px) 48px;\line
  color: var(--theme-text, var(--ink));\line
  box-sizing: border-box;\line
\}\line
\line
.newchat-heading \{\line
  display: flex;\line
  align-items: flex-end;\line
  justify-content: space-between;\line
  gap: 18px;\line
  margin-bottom: 24px;\line
\}\line
\line
.newchat-heading-copy \{\line
  min-width: 0;\line
\}\line
\line
.newchat-eyebrow \{\line
  display: block;\line
  margin-bottom: 8px;\line
  color: var(--theme-primary, #528cf5);\line
  font-size: 10px;\line
  font-weight: 800;\line
  letter-spacing: 0.14em;\line
\}\line
\line
.newchat-title \{\line
  margin: 0;\line
  color: var(--theme-text, var(--ink));\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: clamp(25px, 4vw, 34px);\line
  font-weight: 700;\line
  line-height: 1.15;\line
\}\line
\line
.newchat-subtitle \{\line
  max-width: 520px;\line
  margin: 9px 0 0;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 13px;\line
  line-height: 1.6;\line
\}\line
\line
.newchat-back-link \{\line
  flex: 0 0 auto;\line
  padding: 9px 12px;\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface, #18181b);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 10px;\line
  font-size: 11px;\line
  font-weight: 700;\line
  text-decoration: none;\line
  transition: border-color 140ms ease, transform 140ms ease;\line
\}\line
\line
.newchat-back-link:hover \{\line
  transform: translateY(-1px);\line
  border-color: var(--theme-primary, #528cf5);\line
\}\line
\line
.newchat-discovery \{\line
  overflow: hidden;\line
  background: var(--theme-surface, #18181b);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 18px;\line
  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.08);\line
\}\line
\line
.newchat-search \{\line
  min-height: 48px;\line
  display: flex;\line
  align-items: center;\line
  gap: 11px;\line
  margin: 18px 18px 0;\line
  padding: 0 14px;\line
  background: var(--theme-surface-raised, #222328);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 12px;\line
\}\line
\line
.newchat-search > svg \{\line
  width: 18px;\line
  height: 18px;\line
  flex: 0 0 18px;\line
  fill: none;\line
  stroke: var(--theme-muted, var(--gray-neutral));\line
  stroke-width: 1.8;\line
  stroke-linecap: round;\line
\}\line
\line
.newchat-search input \{\line
  min-width: 0;\line
  flex: 1;\line
  padding: 12px 0;\line
  color: var(--theme-text, var(--ink));\line
  background: transparent;\line
  border: 0;\line
  outline: 0;\line
  font: inherit;\line
  font-size: 13px;\line
\}\line
\line
.newchat-search input::placeholder \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
\}\line
\line
.newchat-search input::-webkit-search-cancel-button \{\line
  display: none;\line
\}\line
\line
.newchat-search > button \{\line
  width: 27px;\line
  height: 27px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  background: transparent;\line
  border: 0;\line
  border-radius: 50%;\line
  font-size: 20px;\line
  cursor: pointer;\line
\}\line
\line
.newchat-tabs \{\line
  display: flex;\line
  gap: 8px;\line
  margin: 14px 18px 0;\line
  padding-bottom: 12px;\line
  border-bottom: 1px solid var(--theme-border, var(--border-subtle));\line
\}\line
\line
.newchat-tabs button \{\line
  display: inline-flex;\line
  align-items: center;\line
  gap: 7px;\line
  padding: 8px 11px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  background: transparent;\line
  border: 1px solid transparent;\line
  border-radius: 9px;\line
  font: inherit;\line
  font-size: 11px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.newchat-tabs button.active \{\line
  color: var(--theme-primary, #528cf5);\line
  background: rgba(82, 140, 245, 0.1);\line
  border-color: rgba(82, 140, 245, 0.2);\line
\}\line
\line
.newchat-tabs button > span \{\line
  min-width: 19px;\line
  padding: 3px 5px;\line
  color: inherit;\line
  background: rgba(128, 128, 128, 0.12);\line
  border-radius: 99px;\line
  font-size: 9px;\line
  text-align: center;\line
\}\line
\line
.newchat-results-heading \{\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  gap: 12px;\line
  padding: 17px 20px 10px;\line
\}\line
\line
.newchat-results-heading h2 \{\line
  margin: 0;\line
  color: var(--theme-text, var(--ink));\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 14px;\line
\}\line
\line
.newchat-results-heading p \{\line
  margin: 5px 0 0;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 11px;\line
  line-height: 1.5;\line
\}\line
\line
.newchat-results-heading > span \{\line
  flex: 0 0 auto;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 10px;\line
\}\line
\line
.newchat-list \{\line
  display: flex;\line
  flex-direction: column;\line
  margin: 0;\line
  padding: 0 12px 12px;\line
  list-style: none;\line
\}\line
\line
.newchat-person \{\line
  min-height: 68px;\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  padding: 10px 8px;\line
  border-top: 1px solid var(--theme-border, var(--border-subtle));\line
  transition: background 140ms ease;\line
\}\line
\line
.newchat-person:hover \{\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.06));\line
\}\line
\line
.newchat-avatar \{\line
  width: 44px;\line
  height: 44px;\line
  flex: 0 0 44px;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  overflow: hidden;\line
  color: #fff;\line
  background: linear-gradient(145deg, #5c8ff3, #6749c7);\line
  border: 1px solid var(--theme-border, transparent);\line
  border-radius: 50%;\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 13px;\line
  font-weight: 700;\line
  object-fit: cover;\line
\}\line
\line
.newchat-person-copy \{\line
  min-width: 0;\line
  flex: 1;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 5px;\line
\}\line
\line
.newchat-person-copy strong \{\line
  overflow: hidden;\line
  color: var(--theme-text, var(--ink));\line
  font-size: 12px;\line
  font-weight: 700;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.newchat-person-copy > span \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 10px;\line
\}\line
\line
.newchat-action \{\line
  flex: 0 0 auto;\line
  min-width: 94px;\line
  padding: 9px 12px;\line
  border: 1px solid transparent;\line
  border-radius: 9px;\line
  font: inherit;\line
  font-size: 10px;\line
  font-weight: 700;\line
  cursor: pointer;\line
  transition: background 140ms ease, transform 140ms ease;\line
\}\line
\line
.newchat-action:hover:not(:disabled) \{\line
  transform: translateY(-1px);\line
\}\line
\line
.newchat-action.message \{\line
  color: #fff;\line
  background: #2563eb;\line
\}\line
\line
.newchat-action.add \{\line
  color: #fff;\line
  background: linear-gradient(135deg, #528cf5, #6345c7);\line
\}\line
\line
.newchat-action.sent \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.12));\line
  border-color: var(--theme-border, var(--border-subtle));\line
  cursor: default;\line
\}\line
\line
.newchat-action:disabled \{\line
  opacity: 0.65;\line
  cursor: wait;\line
\}\line
\line
.newchat-status.pending \{\line
  flex: 0 0 auto;\line
  padding: 7px 10px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.12));\line
  border-radius: 99px;\line
  font-size: 10px;\line
  font-weight: 700;\line
\}\line
\line
.newchat-error \{\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  gap: 12px;\line
  margin: 14px 18px 0;\line
  padding: 11px 12px;\line
  color: #bd354e;\line
  background: rgba(224, 82, 107, 0.09);\line
  border: 1px solid rgba(224, 82, 107, 0.24);\line
  border-radius: 10px;\line
  font-size: 11px;\line
\}\line
\line
.newchat-error button,\line
.newchat-empty button \{\line
  flex: 0 0 auto;\line
  padding: 6px 9px;\line
  color: inherit;\line
  background: transparent;\line
  border: 1px solid currentColor;\line
  border-radius: 7px;\line
  font: inherit;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.newchat-empty,\line
.newchat-loading \{\line
  min-height: 210px;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  justify-content: center;\line
  gap: 9px;\line
  padding: 30px 20px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  text-align: center;\line
\}\line
\line
.newchat-empty-icon \{\line
  width: 44px;\line
  height: 44px;\line
  display: grid;\line
  place-items: center;\line
  margin-bottom: 3px;\line
  color: var(--theme-primary, #528cf5);\line
  background: rgba(82, 140, 245, 0.1);\line
  border-radius: 14px;\line
  font-size: 22px;\line
\}\line
\line
.newchat-empty strong \{\line
  color: var(--theme-text, var(--ink));\line
  font-size: 13px;\line
\}\line
\line
.newchat-empty > span:not(.newchat-empty-icon) \{\line
  max-width: 290px;\line
  font-size: 11px;\line
  line-height: 1.5;\line
\}\line
\line
.newchat-empty button \{\line
  margin-top: 5px;\line
  color: var(--theme-primary, #528cf5);\line
\}\line
\line
.newchat-loading \{\line
  flex-direction: row;\line
  min-height: 130px;\line
  font-size: 12px;\line
\}\line
\line
.newchat-spinner \{\line
  width: 17px;\line
  height: 17px;\line
  border: 2px solid var(--theme-border, #444);\line
  border-top-color: var(--theme-primary, #528cf5);\line
  border-radius: 50%;\line
  animation: newchat-spin 700ms linear infinite;\line
\}\line
\line
@keyframes newchat-spin \{\line
  to \{ transform: rotate(360deg); \}\line
\}\line
\line
.newchat-group-shortcuts \{\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  gap: 16px;\line
  margin-top: 16px;\line
  padding: 16px;\line
  background: var(--theme-surface, #18181b);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 16px;\line
\}\line
\line
.newchat-group-copy \{\line
  min-width: 0;\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
\}\line
\line
.newchat-group-copy > span:last-child \{\line
  display: flex;\line
  flex-direction: column;\line
  gap: 4px;\line
\}\line
\line
.newchat-group-copy strong \{\line
  color: var(--theme-text, var(--ink));\line
  font-size: 11px;\line
\}\line
\line
.newchat-group-copy small \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 10px;\line
  line-height: 1.4;\line
\}\line
\line
.newchat-shortcut-icon \{\line
  width: 42px;\line
  height: 42px;\line
  flex: 0 0 42px;\line
  display: grid;\line
  place-items: center;\line
  color: #fff;\line
  background: linear-gradient(145deg, #7c3aed, #5b43c8);\line
  border-radius: 13px;\line
  font-size: 18px;\line
\}\line
\line
.newchat-group-actions \{\line
  flex: 0 0 auto;\line
  display: flex;\line
  gap: 8px;\line
\}\line
\line
.newchat-group-actions a \{\line
  padding: 9px 11px;\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.1));\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 9px;\line
  font-size: 10px;\line
  font-weight: 700;\line
  text-decoration: none;\line
  white-space: nowrap;\line
\}\line
\line
.newchat-group-actions a:first-child \{\line
  color: #fff;\line
  background: #6345c7;\line
  border-color: #6345c7;\line
\}\line
\line
@media (max-width: 640px) \{\line
  .newchat-page \{\line
    padding: 20px 12px 30px;\line
  \}\line
\line
  .newchat-heading \{\line
    align-items: flex-start;\line
  \}\line
\line
  .newchat-heading-copy \{\line
    padding-top: 2px;\line
  \}\line
\line
  .newchat-title \{\line
    font-size: 25px;\line
  \}\line
\line
  .newchat-subtitle \{\line
    max-width: 320px;\line
    font-size: 12px;\line
  \}\line
\line
  .newchat-back-link \{\line
    padding: 8px 9px;\line
    font-size: 0;\line
  \}\line
\line
  .newchat-back-link::first-letter \{\line
    font-size: 17px;\line
  \}\line
\line
  .newchat-discovery \{\line
    border-radius: 15px;\line
  \}\line
\line
  .newchat-search \{\line
    margin: 12px 12px 0;\line
  \}\line
\line
  .newchat-tabs \{\line
    gap: 3px;\line
    margin: 12px 12px 0;\line
  \}\line
\line
  .newchat-tabs button \{\line
    flex: 1;\line
    justify-content: center;\line
    gap: 5px;\line
    padding: 8px 5px;\line
    font-size: 10px;\line
  \}\line
\line
  .newchat-results-heading \{\line
    padding: 15px 14px 9px;\line
  \}\line
\line
  .newchat-list \{\line
    padding: 0 8px 8px;\line
  \}\line
\line
  .newchat-person \{\line
    min-height: 64px;\line
    gap: 9px;\line
    padding: 9px 5px;\line
  \}\line
\line
  .newchat-avatar \{\line
    width: 40px;\line
    height: 40px;\line
    flex-basis: 40px;\line
  \}\line
\line
  .newchat-action \{\line
    min-width: 78px;\line
    padding: 8px 9px;\line
    font-size: 9px;\line
  \}\line
\line
  .newchat-group-shortcuts \{\line
    align-items: flex-start;\line
    flex-direction: column;\line
    padding: 13px;\line
  \}\line
\line
  .newchat-group-actions \{\line
    width: 100%;\line
  \}\line
\line
  .newchat-group-actions a \{\line
    flex: 1;\line
    text-align: center;\line
  \}\line
\}\line
\line
@media (prefers-reduced-motion: reduce) \{\line
  .newchat-spinner \{\line
    animation: none;\line
  \}\line
\}}\par\par
\b src/css/CreateGroup.css\b0\par
{\f1\fs15\cf2 .create-group-page \{\line
  width: min(100%, 1040px);\line
  margin: 0 auto;\line
  padding: 32px clamp(16px, 4vw, 38px) 48px;\line
  color: var(--theme-text, var(--ink));\line
\}\line
\line
.create-group-heading \{\line
  display: flex;\line
  align-items: flex-end;\line
  justify-content: space-between;\line
  gap: 18px;\line
  margin-bottom: 24px;\line
\}\line
\line
.create-group-eyebrow \{\line
  display: block;\line
  margin-bottom: 8px;\line
  color: var(--theme-primary, #528cf5);\line
  font-size: 10px;\line
  font-weight: 800;\line
  letter-spacing: 0.14em;\line
\}\line
\line
.create-group-heading h1 \{\line
  margin: 0;\line
  color: var(--theme-text, var(--ink));\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: clamp(26px, 4vw, 34px);\line
  line-height: 1.15;\line
\}\line
\line
.create-group-heading p \{\line
  max-width: 540px;\line
  margin: 9px 0 0;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 13px;\line
  line-height: 1.6;\line
\}\line
\line
.create-group-back \{\line
  flex: 0 0 auto;\line
  padding: 9px 12px;\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface, #18181b);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 10px;\line
  font-size: 11px;\line
  font-weight: 700;\line
  text-decoration: none;\line
\}\line
\line
.create-group-back:hover \{\line
  border-color: var(--theme-primary, #528cf5);\line
\}\line
\line
.create-group-layout \{\line
  display: grid;\line
  grid-template-columns: minmax(0, 1.55fr) minmax(240px, 0.8fr);\line
  align-items: start;\line
  gap: 18px;\line
\}\line
\line
.create-group-form-card,\line
.create-group-preview \{\line
  min-width: 0;\line
  background: var(--theme-surface, #18181b);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 18px;\line
  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.08);\line
\}\line
\line
.create-group-form-card \{\line
  padding: 20px;\line
\}\line
\line
.create-group-card-heading,\line
.create-group-selection-heading \{\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
\}\line
\line
.create-group-card-heading \{\line
  margin-bottom: 22px;\line
\}\line
\line
.create-group-icon \{\line
  width: 42px;\line
  height: 42px;\line
  flex: 0 0 42px;\line
  display: grid;\line
  place-items: center;\line
  color: #fff;\line
  background: linear-gradient(145deg, #7c3aed, #5b43c8);\line
  border-radius: 13px;\line
  font-size: 18px;\line
\}\line
\line
.create-group-card-heading h2,\line
.create-group-selection-heading h2 \{\line
  margin: 0;\line
  color: var(--theme-text, var(--ink));\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 15px;\line
\}\line
\line
.create-group-card-heading p,\line
.create-group-selection-heading p \{\line
  margin: 4px 0 0;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 11px;\line
\}\line
\line
.create-group-name-label \{\line
  display: block;\line
  margin-bottom: 7px;\line
  color: var(--theme-text, var(--ink));\line
  font-size: 11px;\line
  font-weight: 700;\line
\}\line
\line
.create-group-name-input \{\line
  width: 100%;\line
  min-height: 44px;\line
  padding: 0 12px;\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface-raised, #222328);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 10px;\line
  outline: none;\line
  font: inherit;\line
  font-size: 12px;\line
\}\line
\line
.create-group-name-input:focus \{\line
  border-color: var(--theme-primary, #528cf5);\line
  box-shadow: 0 0 0 3px rgba(82, 140, 245, 0.12);\line
\}\line
\line
.create-group-name-input::placeholder \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
\}\line
\line
.create-group-character-count \{\line
  display: block;\line
  margin-top: 5px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 9px;\line
  text-align: right;\line
\}\line
\line
.create-group-selection-heading \{\line
  justify-content: space-between;\line
  margin: 23px 0 12px;\line
\}\line
\line
.create-group-selection-heading h2 \{\line
  font-size: 13px;\line
\}\line
\line
.create-group-selected-count \{\line
  flex: 0 0 auto;\line
  padding: 6px 9px;\line
  color: var(--theme-primary, #528cf5);\line
  background: rgba(82, 140, 245, 0.1);\line
  border-radius: 99px;\line
  font-size: 10px;\line
  font-weight: 700;\line
\}\line
\line
.create-group-selected-list \{\line
  display: flex;\line
  flex-wrap: wrap;\line
  gap: 7px;\line
  margin: 0 0 12px;\line
\}\line
\line
.create-group-selected-chip \{\line
  max-width: 100%;\line
  display: inline-flex;\line
  align-items: center;\line
  gap: 6px;\line
  padding: 4px 8px 4px 4px;\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.12));\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 99px;\line
  font: inherit;\line
  font-size: 10px;\line
  cursor: pointer;\line
\}\line
\line
.create-group-selected-chip > span:nth-child(2) \{\line
  max-width: 110px;\line
  overflow: hidden;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.create-group-selected-chip > span:last-child \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 15px;\line
  line-height: 1;\line
\}\line
\line
.create-group-chip-avatar \{\line
  width: 23px;\line
  height: 23px;\line
  flex: 0 0 23px;\line
  display: grid;\line
  place-items: center;\line
  overflow: hidden;\line
  color: #fff;\line
  background: linear-gradient(145deg, #5c8ff3, #6749c7);\line
  border-radius: 50%;\line
  font-size: 8px;\line
  font-weight: 700;\line
  object-fit: cover;\line
\}\line
\line
.create-group-search \{\line
  min-height: 42px;\line
  display: flex;\line
  align-items: center;\line
  gap: 9px;\line
  padding: 0 11px;\line
  background: var(--theme-surface-raised, #222328);\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 10px;\line
\}\line
\line
.create-group-search:focus-within \{\line
  border-color: var(--theme-primary, #528cf5);\line
\}\line
\line
.create-group-search > svg \{\line
  width: 17px;\line
  height: 17px;\line
  flex: 0 0 17px;\line
  fill: none;\line
  stroke: var(--theme-muted, var(--gray-neutral));\line
  stroke-width: 1.8;\line
  stroke-linecap: round;\line
\}\line
\line
.create-group-search input \{\line
  min-width: 0;\line
  flex: 1;\line
  padding: 10px 0;\line
  color: var(--theme-text, var(--ink));\line
  background: transparent;\line
  border: 0;\line
  outline: none;\line
  font: inherit;\line
  font-size: 11px;\line
\}\line
\line
.create-group-search input::placeholder \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
\}\line
\line
.create-group-search input::-webkit-search-cancel-button \{\line
  display: none;\line
\}\line
\line
.create-group-search > button \{\line
  width: 26px;\line
  height: 26px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  background: transparent;\line
  border: 0;\line
  border-radius: 50%;\line
  font-size: 18px;\line
  cursor: pointer;\line
\}\line
\line
.create-group-friend-list \{\line
  max-height: 310px;\line
  overflow-y: auto;\line
  margin: 10px 0 0;\line
  padding: 0;\line
  list-style: none;\line
\}\line
\line
.create-group-friend-list li + li \{\line
  border-top: 1px solid var(--theme-border, var(--border-subtle));\line
\}\line
\line
.create-group-friend \{\line
  width: 100%;\line
  min-height: 62px;\line
  display: flex;\line
  align-items: center;\line
  gap: 11px;\line
  padding: 8px 6px;\line
  color: var(--theme-text, var(--ink));\line
  background: transparent;\line
  border: 0;\line
  border-radius: 9px;\line
  text-align: left;\line
  cursor: pointer;\line
\}\line
\line
.create-group-friend:hover \{\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.08));\line
\}\line
\line
.create-group-friend.selected \{\line
  background: rgba(82, 140, 245, 0.08);\line
\}\line
\line
.create-group-friend-avatar \{\line
  width: 40px;\line
  height: 40px;\line
  flex: 0 0 40px;\line
  display: grid;\line
  place-items: center;\line
  overflow: hidden;\line
  color: #fff;\line
  background: linear-gradient(145deg, #5c8ff3, #6749c7);\line
  border-radius: 50%;\line
  font-size: 11px;\line
  font-weight: 700;\line
  object-fit: cover;\line
\}\line
\line
.create-group-friend-copy \{\line
  min-width: 0;\line
  flex: 1;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 4px;\line
\}\line
\line
.create-group-friend-copy strong \{\line
  overflow: hidden;\line
  color: var(--theme-text, var(--ink));\line
  font-size: 11px;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.create-group-friend-copy small \{\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 9px;\line
\}\line
\line
.create-group-check \{\line
  width: 26px;\line
  height: 26px;\line
  flex: 0 0 26px;\line
  display: grid;\line
  place-items: center;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.1));\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 50%;\line
  font-size: 15px;\line
  font-weight: 700;\line
\}\line
\line
.create-group-friend.selected .create-group-check \{\line
  color: #fff;\line
  background: var(--theme-primary, #528cf5);\line
  border-color: var(--theme-primary, #528cf5);\line
\}\line
\line
.create-group-error \{\line
  margin: 12px 0 0;\line
  padding: 10px 12px;\line
  color: #bd354e;\line
  background: rgba(224, 82, 107, 0.09);\line
  border: 1px solid rgba(224, 82, 107, 0.24);\line
  border-radius: 9px;\line
  font-size: 11px;\line
\}\line
\line
.create-group-state \{\line
  min-height: 135px;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  justify-content: center;\line
  gap: 8px;\line
  padding: 18px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  text-align: center;\line
\}\line
\line
.create-group-state strong \{\line
  color: var(--theme-text, var(--ink));\line
  font-size: 12px;\line
\}\line
\line
.create-group-state > span \{\line
  max-width: 260px;\line
  font-size: 10px;\line
  line-height: 1.5;\line
\}\line
\line
.create-group-state a,\line
.create-group-state button \{\line
  margin-top: 3px;\line
  padding: 7px 10px;\line
  color: var(--theme-primary, #528cf5);\line
  background: transparent;\line
  border: 1px solid currentColor;\line
  border-radius: 8px;\line
  font: inherit;\line
  font-size: 10px;\line
  font-weight: 700;\line
  text-decoration: none;\line
  cursor: pointer;\line
\}\line
\line
.create-group-spinner \{\line
  width: 18px;\line
  height: 18px;\line
  border: 2px solid var(--theme-border, #444);\line
  border-top-color: var(--theme-primary, #528cf5);\line
  border-radius: 50%;\line
  animation: create-group-spin 700ms linear infinite;\line
\}\line
\line
@keyframes create-group-spin \{\line
  to \{ transform: rotate(360deg); \}\line
\}\line
\line
.create-group-submit \{\line
  width: 100%;\line
  min-height: 44px;\line
  margin-top: 14px;\line
  color: #fff;\line
  background: linear-gradient(135deg, #528cf5, #6345c7);\line
  border: 0;\line
  border-radius: 10px;\line
  font: inherit;\line
  font-size: 12px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.create-group-submit:hover:not(:disabled) \{\line
  filter: brightness(1.06);\line
\}\line
\line
.create-group-submit:disabled \{\line
  opacity: 0.48;\line
  cursor: not-allowed;\line
\}\line
\line
.create-group-preview \{\line
  position: sticky;\line
  top: 20px;\line
  overflow: hidden;\line
  padding: 20px;\line
  text-align: center;\line
\}\line
\line
.create-group-preview-art \{\line
  height: 150px;\line
  position: relative;\line
  display: grid;\line
  place-items: center;\line
  overflow: hidden;\line
  margin: -20px -20px 19px;\line
  background:\line
    radial-gradient(circle at 50% 52%, rgba(122, 91, 225, 0.55), transparent 34%),\line
    linear-gradient(145deg, #17233b, #2c1d4c);\line
\}\line
\line
.create-group-preview-art > span \{\line
  position: absolute;\line
  color: rgba(255, 255, 255, 0.7);\line
\}\line
\line
.create-group-preview-art > span:nth-child(1) \{\line
  top: 25px;\line
  left: 25%;\line
  font-size: 18px;\line
\}\line
\line
.create-group-preview-art > span:nth-child(2) \{\line
  top: 42px;\line
  right: 22%;\line
  font-size: 25px;\line
\}\line
\line
.create-group-preview-art > span:nth-child(3) \{\line
  bottom: 25px;\line
  left: 21%;\line
  font-size: 12px;\line
\}\line
\line
.create-group-preview-avatar \{\line
  width: 76px;\line
  height: 76px;\line
  display: grid;\line
  place-items: center;\line
  color: #fff;\line
  background: rgba(255, 255, 255, 0.14);\line
  border: 1px solid rgba(255, 255, 255, 0.28);\line
  border-radius: 24px;\line
  box-shadow: 0 14px 35px rgba(0, 0, 0, 0.2);\line
  font-size: 33px;\line
  backdrop-filter: blur(10px);\line
\}\line
\line
.create-group-preview-label \{\line
  color: var(--theme-primary, #528cf5);\line
  font-size: 9px;\line
  font-weight: 800;\line
  letter-spacing: 0.13em;\line
\}\line
\line
.create-group-preview h2 \{\line
  margin: 8px 0 4px;\line
  overflow-wrap: anywhere;\line
  color: var(--theme-text, var(--ink));\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 18px;\line
\}\line
\line
.create-group-preview > p \{\line
  margin: 0;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  font-size: 10px;\line
\}\line
\line
.create-group-preview-members \{\line
  display: flex;\line
  justify-content: center;\line
  margin: 18px 0 20px;\line
  padding-left: 8px;\line
\}\line
\line
.create-group-preview-avatar-member,\line
.create-group-preview-members > span \{\line
  width: 34px;\line
  height: 34px;\line
  display: grid;\line
  place-items: center;\line
  overflow: hidden;\line
  margin-left: -8px;\line
  color: #fff;\line
  background: linear-gradient(145deg, #5c8ff3, #6749c7);\line
  border: 2px solid var(--theme-surface, #18181b);\line
  border-radius: 50%;\line
  font-size: 9px;\line
  font-weight: 700;\line
  object-fit: cover;\line
\}\line
\line
.create-group-preview-members > span \{\line
  background: var(--theme-surface-raised, #333);\line
\}\line
\line
.create-group-preview-note \{\line
  display: flex;\line
  align-items: flex-start;\line
  gap: 8px;\line
  padding: 11px;\line
  color: var(--theme-muted, var(--gray-neutral));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.08));\line
  border: 1px solid var(--theme-border, var(--border-subtle));\line
  border-radius: 10px;\line
  font-size: 9px;\line
  line-height: 1.5;\line
  text-align: left;\line
\}\line
\line
@media (max-width: 760px) \{\line
  .create-group-page \{\line
    padding: 20px 12px 30px;\line
  \}\line
\line
  .create-group-heading \{\line
    align-items: flex-start;\line
  \}\line
\line
  .create-group-heading h1 \{\line
    font-size: 26px;\line
  \}\line
\line
  .create-group-heading p \{\line
    max-width: 360px;\line
    font-size: 12px;\line
  \}\line
\line
  .create-group-back \{\line
    padding: 8px 9px;\line
    font-size: 0;\line
  \}\line
\line
  .create-group-back::first-letter \{\line
    font-size: 17px;\line
  \}\line
\line
  .create-group-layout \{\line
    grid-template-columns: minmax(0, 1fr);\line
    gap: 12px;\line
  \}\line
\line
  .create-group-form-card \{\line
    padding: 15px;\line
  \}\line
\line
  .create-group-preview \{\line
    position: static;\line
    display: grid;\line
    grid-template-columns: 64px minmax(0, 1fr);\line
    align-items: center;\line
    column-gap: 13px;\line
    padding: 12px;\line
    text-align: left;\line
  \}\line
\line
  .create-group-preview-art \{\line
    width: 64px;\line
    height: 64px;\line
    grid-row: span 3;\line
    margin: 0;\line
    border-radius: 13px;\line
  \}\line
\line
  .create-group-preview-art > span \{\line
    display: none;\line
  \}\line
\line
  .create-group-preview-avatar \{\line
    width: 42px;\line
    height: 42px;\line
    border-radius: 14px;\line
    font-size: 21px;\line
  \}\line
\line
  .create-group-preview-label \{\line
    align-self: end;\line
  \}\line
\line
  .create-group-preview h2 \{\line
    margin: 2px 0;\line
    font-size: 14px;\line
  \}\line
\line
  .create-group-preview > p \{\line
    align-self: start;\line
  \}\line
\line
  .create-group-preview-members,\line
  .create-group-preview-note \{\line
    display: none;\line
  \}\line
\}\line
\line
@media (prefers-reduced-motion: reduce) \{\line
  .create-group-spinner \{\line
    animation: none;\line
  \}\line
\}}\par\par
\b src/css/Feed.css\b0\par
{\f1\fs15\cf2 .feed-page \{\line
\tab --feed-ink: #f4f4f5;\line
\tab --feed-muted: #a1a1aa;\line
\tab --feed-line: #303036;\line
\tab --feed-blue: #53b7e8;\line
\tab min-height: 100vh;\line
\tab padding: 24px 34px 48px;\line
\tab background:\line
\tab \tab radial-gradient(ellipse at 76% 4%, rgba(42, 57, 66, 0.42), transparent 32%),\line
\tab \tab #111113;\line
\tab color: var(--feed-ink);\line
\tab font-family: "Inter", sans-serif;\line
\}\line
\line
.feed-layout \{\line
\tab width: min(100%, 1050px);\line
\tab margin: 0 auto;\line
\tab display: grid;\line
\tab grid-template-columns: minmax(0, 590px) 292px;\line
\tab align-items: start;\line
\tab justify-content: center;\line
\tab gap: 52px;\line
\}\line
\line
.feed-main \{\line
\tab min-width: 0;\line
\tab display: flex;\line
\tab flex-direction: column;\line
\tab gap: 20px;\line
\}\line
\line
.stories-panel,\line
.feed-post,\line
.current-account,\line
.suggestions-panel \{\line
\tab background: #1a1a1e;\line
\tab border: 1px solid var(--feed-line);\line
\tab border-radius: 13px;\line
\tab box-shadow: 0 5px 22px rgba(0, 0, 0, 0.16);\line
\}\line
\line
.stories-panel \{\line
\tab padding: 16px 16px 14px;\line
\tab overflow: hidden;\line
\}\line
\line
.stories-heading,\line
.suggestions-heading \{\line
\tab display: flex;\line
\tab align-items: center;\line
\tab justify-content: space-between;\line
\}\line
\line
.stories-heading h1,\line
.suggestions-heading h2 \{\line
\tab margin: 0;\line
\tab font-size: 15px;\line
\tab line-height: 1.3;\line
\tab font-weight: 700;\line
\}\line
\line
.stories-heading \{\line
\tab margin-bottom: 14px;\line
\}\line
\line
.stories-heading > span \{\line
\tab color: var(--feed-muted);\line
\tab font-size: 12px;\line
\}\line
\line
.stories-list \{\line
\tab display: flex;\line
\tab gap: 17px;\line
\tab overflow-x: auto;\line
\tab padding: 1px 1px 3px;\line
\tab scrollbar-width: none;\line
\}\line
\line
.stories-list::-webkit-scrollbar \{\line
\tab display: none;\line
\}\line
\line
.story-item \{\line
\tab flex: 0 0 61px;\line
\tab width: 61px;\line
\tab display: flex;\line
\tab flex-direction: column;\line
\tab align-items: center;\line
\tab gap: 6px;\line
\}\line
\line
.story-ring \{\line
\tab position: relative;\line
\tab width: 58px;\line
\tab height: 58px;\line
\tab padding: 3px;\line
\tab border-radius: 50%;\line
\tab background: conic-gradient(from 215deg, #e7a13c, #cf486c, #7c55b5, #e7a13c);\line
\}\line
\line
.story-ring:not(.story-ring-fresh) \{\line
\tab background: #45454c;\line
\}\line
\line
.story-ring img \{\line
\tab width: 100%;\line
\tab height: 100%;\line
\tab display: block;\line
\tab object-fit: cover;\line
\tab border: 2px solid #1a1a1e;\line
\tab border-radius: 50%;\line
\}\line
\line
.story-add \{\line
\tab position: absolute;\line
\tab right: -1px;\line
\tab bottom: -1px;\line
\tab width: 20px;\line
\tab height: 20px;\line
\tab display: grid;\line
\tab place-items: center;\line
\tab color: #fff;\line
\tab background: #1687bd;\line
\tab border: 2px solid #1a1a1e;\line
\tab border-radius: 50%;\line
\}\line
\line
.story-name \{\line
\tab width: 100%;\line
\tab overflow: hidden;\line
\tab color: #e4e4e7;\line
\tab font-size: 11px;\line
\tab line-height: 1.2;\line
\tab text-align: center;\line
\tab text-overflow: ellipsis;\line
\tab white-space: nowrap;\line
\}\line
\line
.post-list \{\line
\tab display: flex;\line
\tab flex-direction: column;\line
\tab gap: 17px;\line
\tab width: min(100%, 480px);\line
\tab margin: 0 auto;\line
\}\line
\line
.feed-post \{\line
\tab overflow: hidden;\line
\tab scroll-margin-top: 24px;\line
\}\line
\line
.feed-post-highlighted \{\line
\tab outline: 2px solid var(--feed-blue);\line
\tab box-shadow: 0 0 0 5px rgba(83, 183, 232, 0.2);\line
\}\line
\line
.post-header \{\line
\tab min-height: 54px;\line
\tab display: flex;\line
\tab justify-content: space-between;\line
\tab align-items: center;\line
\tab padding: 8px 13px;\line
\}\line
\line
.post-author \{\line
\tab min-width: 0;\line
\tab display: flex;\line
\tab align-items: center;\line
\tab gap: 9px;\line
\}\line
\line
.post-avatar \{\line
\tab width: 35px;\line
\tab height: 35px;\line
\tab flex: 0 0 35px;\line
\tab object-fit: cover;\line
\tab border: 2px solid #dfb64b;\line
\tab border-radius: 50%;\line
\}\line
\line
.post-author-copy,\line
.suggestion-copy,\line
.account-copy \{\line
\tab min-width: 0;\line
\tab display: flex;\line
\tab flex-direction: column;\line
\}\line
\line
.post-author-copy strong,\line
.post-author-copy > span \{\line
\tab overflow: hidden;\line
\tab text-overflow: ellipsis;\line
\tab white-space: nowrap;\line
\}\line
\line
.post-author-copy strong \{\line
\tab font-size: 13px;\line
\tab line-height: 1.4;\line
\}\line
\line
.post-author-copy > span \{\line
\tab color: var(--feed-muted);\line
\tab font-size: 11px;\line
\tab line-height: 1.3;\line
\}\line
\line
.post-dot \{\line
\tab padding: 0 3px;\line
\}\line
\line
.icon-button \{\line
\tab width: 34px;\line
\tab height: 34px;\line
\tab flex: 0 0 34px;\line
\tab display: inline-grid;\line
\tab place-items: center;\line
\tab padding: 0;\line
\tab color: var(--feed-ink);\line
\tab background: transparent;\line
\tab border: 0;\line
\tab border-radius: 50%;\line
\tab cursor: pointer;\line
\tab transition: color 120ms ease, background-color 120ms ease;\line
\}\line
\line
.icon-button:hover \{\line
\tab background: rgba(255, 255, 255, 0.08);\line
\}\line
\line
.icon-button:focus-visible,\line
.follow-label:focus-visible,\line
.comment-submit:focus-visible,\line
.comment-entry input:focus-visible \{\line
\tab outline: 2px solid var(--feed-blue);\line
\tab outline-offset: 2px;\line
\}\line
\line
.post-image \{\line
\tab width: 100%;\line
\tab aspect-ratio: 1.52 / 1;\line
\tab display: block;\line
\tab object-fit: cover;\line
\tab background: #29292e;\line
\}\line
\line
.post-details \{\line
\tab padding: 5px 13px 0;\line
\}\line
\line
.post-actions,\line
.post-actions-left \{\line
\tab display: flex;\line
\tab align-items: center;\line
\}\line
\line
.post-actions \{\line
\tab justify-content: space-between;\line
\tab margin: 0 -5px 5px;\line
\}\line
\line
.post-actions-left \{\line
\tab gap: 1px;\line
\}\line
\line
.like-button \{\line
\tab color: var(--feed-ink);\line
\}\line
\line
.like-button.liked \{\line
\tab color: #ff5b74;\line
\}\line
\line
.save-button.saved \{\line
\tab color: var(--feed-blue);\line
\}\line
\line
.post-likes,\line
.post-caption \{\line
\tab font-size: 13px;\line
\tab line-height: 1.45;\line
\}\line
\line
.post-likes \{\line
\tab display: block;\line
\tab margin-bottom: 2px;\line
\}\line
\line
.post-caption \{\line
\tab margin: 0;\line
\}\line
\line
.post-caption strong \{\line
\tab margin-right: 3px;\line
\}\line
\line
.post-comments \{\line
\tab margin: 3px 0 0;\line
\tab color: var(--feed-muted);\line
\tab font-size: 12px;\line
\}\line
\line
.posted-comment \{\line
\tab margin: 4px 0 0;\line
\tab font-size: 12px;\line
\tab line-height: 1.45;\line
\tab word-break: break-word;\line
\}\line
\line
.posted-comment strong \{\line
\tab margin-right: 4px;\line
\}\line
\line
.share-status \{\line
\tab display: block;\line
\tab margin-top: 5px;\line
\tab color: var(--feed-blue);\line
\tab font-size: 11px;\line
\}\line
\line
.post-time \{\line
\tab display: block;\line
\tab margin-top: 5px;\line
\tab color: #85858d;\line
\tab font-size: 9px;\line
\tab letter-spacing: 0.04em;\line
\tab text-transform: uppercase;\line
\}\line
\line
.comment-entry \{\line
\tab min-height: 41px;\line
\tab display: flex;\line
\tab align-items: center;\line
\tab gap: 8px;\line
\tab margin-top: 7px;\line
\tab border-top: 1px solid #303036;\line
\tab color: #a1a1aa;\line
\tab font-size: 12px;\line
\}\line
\line
.comment-entry > img \{\line
\tab width: 23px;\line
\tab height: 23px;\line
\tab object-fit: cover;\line
\tab border-radius: 50%;\line
\}\line
\line
.comment-entry input \{\line
\tab min-width: 0;\line
\tab flex: 1;\line
\tab padding: 7px 0;\line
\tab color: var(--feed-ink);\line
\tab background: transparent;\line
\tab border: 0;\line
\tab font: inherit;\line
\tab outline: none;\line
\}\line
\line
.comment-entry input::placeholder \{\line
\tab color: var(--feed-muted);\line
\}\line
\line
.comment-smile \{\line
\tab color: #a1a1aa;\line
\}\line
\line
.comment-submit \{\line
\tab padding: 5px 0 5px 4px;\line
\tab color: var(--feed-blue);\line
\tab background: transparent;\line
\tab border: 0;\line
\tab font: inherit;\line
\tab font-size: 12px;\line
\tab font-weight: 700;\line
\tab cursor: pointer;\line
\}\line
\line
.feed-rail \{\line
\tab position: sticky;\line
\tab top: 20px;\line
\tab padding-top: 1px;\line
\tab display: flex;\line
\tab flex-direction: column;\line
\tab gap: 20px;\line
\}\line
\line
.feed-stories \{\line
\tab margin-bottom: 0;\line
\}\line
\line
.current-account \{\line
\tab min-height: 76px;\line
\tab display: flex;\line
\tab align-items: center;\line
\tab gap: 11px;\line
\tab padding: 12px 14px;\line
\}\line
\line
.current-account > img \{\line
\tab width: 43px;\line
\tab height: 43px;\line
\tab flex: 0 0 43px;\line
\tab object-fit: cover;\line
\tab border-radius: 50%;\line
\}\line
\line
.account-copy \{\line
\tab flex: 1;\line
\tab gap: 2px;\line
\}\line
\line
.account-copy strong,\line
.suggestion-copy strong \{\line
\tab overflow: hidden;\line
\tab font-size: 12px;\line
\tab text-overflow: ellipsis;\line
\tab white-space: nowrap;\line
\}\line
\line
.account-copy span \{\line
\tab color: var(--feed-muted);\line
\tab font-size: 12px;\line
\}\line
\line
.account-switch,\line
.suggestions-heading > span \{\line
\tab color: var(--feed-blue);\line
\tab font-size: 12px;\line
\tab font-weight: 700;\line
\tab white-space: nowrap;\line
\}\line
\line
.suggestions-panel \{\line
\tab margin-top: 0;\line
\tab padding: 16px 14px 13px;\line
\}\line
\line
.suggestions-heading \{\line
\tab margin-bottom: 14px;\line
\}\line
\line
.suggestions-heading h2 \{\line
\tab font-size: 13px;\line
\}\line
\line
.suggestion-list \{\line
\tab display: flex;\line
\tab flex-direction: column;\line
\tab gap: 12px;\line
\}\line
\line
.suggestion-row \{\line
\tab min-width: 0;\line
\tab display: flex;\line
\tab align-items: center;\line
\tab gap: 9px;\line
\}\line
\line
.suggestion-row > img \{\line
\tab width: 36px;\line
\tab height: 36px;\line
\tab flex: 0 0 36px;\line
\tab object-fit: cover;\line
\tab border-radius: 50%;\line
\}\line
\line
.suggestion-copy \{\line
\tab flex: 1;\line
\tab gap: 2px;\line
\}\line
\line
.suggestion-copy span \{\line
\tab overflow: hidden;\line
\tab color: var(--feed-muted);\line
\tab font-size: 10px;\line
\tab text-overflow: ellipsis;\line
\tab white-space: nowrap;\line
\}\line
\line
.follow-label \{\line
\tab padding: 5px 0 5px 5px;\line
\tab color: var(--feed-blue);\line
\tab background: transparent;\line
\tab border: 0;\line
\tab font: inherit;\line
\tab font-size: 11px;\line
\tab font-weight: 700;\line
\tab white-space: nowrap;\line
\tab cursor: pointer;\line
\}\line
\line
.follow-label.following \{\line
\tab color: var(--feed-muted);\line
\}\line
\line
.feed-footer \{\line
\tab padding: 19px 10px 0;\line
\tab color: #85858d;\line
\tab font-size: 10px;\line
\tab line-height: 1.8;\line
\}\line
\line
.feed-footer span \{\line
\tab margin-left: 7px;\line
\}\line
\line
.feed-footer p \{\line
\tab margin: 9px 0 0;\line
\tab font-size: 9px;\line
\tab letter-spacing: 0.04em;\line
\}\line
\line
@media (max-width: 1242px) \{\line
\tab .feed-layout \{\line
\tab \tab grid-template-columns: minmax(0, 590px);\line
\tab \tab width: min(100%, 650px);\line
\tab \}\line
\line
\tab .feed-rail \{\line
\tab \tab position: static;\line
\tab \tab order: -1;\line
\tab \}\line
\line
\tab .current-account,\line
\tab .suggestions-panel \{\line
\tab \tab display: none;\line
\tab \}\line
\}\line
\line
@media (max-width: 768px) \{\line
\tab .feed-page \{\line
\tab \tab min-height: calc(100vh - 64px);\line
\tab \tab padding: 16px 18px 28px;\line
\tab \}\line
\}\line
\line
@media (max-width: 520px) \{\line
\tab .feed-page \{\line
\tab \tab padding: 10px 0 20px;\line
\tab \tab background: #111113;\line
\tab \}\line
\line
\tab .feed-layout \{\line
\tab \tab width: 100%;\line
\tab \}\line
\line
\tab .stories-panel \{\line
\tab \tab padding: 13px 12px 11px;\line
\tab \tab border-right: 0;\line
\tab \tab border-left: 0;\line
\tab \tab border-radius: 0;\line
\tab \}\line
\line
\tab .stories-list \{\line
\tab \tab gap: 13px;\line
\tab \}\line
\line
\tab .post-list \{\line
\tab \tab width: 100%;\line
\tab \tab margin-top: 0;\line
\tab \tab gap: 15px;\line
\tab \}\line
\line
\tab .feed-post \{\line
\tab \tab border-right: 0;\line
\tab \tab border-left: 0;\line
\tab \tab border-radius: 0;\line
\tab \}\line
\line
\tab .post-image \{\line
\tab \tab aspect-ratio: 1.12 / 1;\line
\tab \}\line
\}}\par\par
\b src/css/StatusBar.css\b0\par
{\f1\fs15\cf2 .status-bar \{\line
  display: flex;\line
  gap: 17px;\line
  overflow-x: auto;\line
  padding: 4px 2px 10px;\line
  scrollbar-width: none;\line
\}\line
\line
.status-bar::-webkit-scrollbar \{\line
  display: none;\line
\}\line
\line
.status-item \{\line
  flex: 0 0 61px;\line
  width: 61px;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
  gap: 6px;\line
  cursor: pointer;\line
\}\line
\line
.status-ring \{\line
  position: relative;\line
  width: 58px;\line
  height: 58px;\line
  padding: 3px;\line
  border-radius: 50%;\line
  background: #45454c;\line
\}\line
\line
.status-ring-fresh \{\line
  background: conic-gradient(from 215deg, #e7a13c, #cf486c, #7c55b5, #e7a13c);\line
\}\line
\line
.status-ring-has-status \{\line
  background: conic-gradient(from 215deg, #e7a13c, #cf486c, #7c55b5, #e7a13c);\line
  box-shadow: 0 0 12px rgba(207, 72, 108, 0.28);\line
\}\line
\line
.status-ring img,\line
.status-avatar-fallback \{\line
  width: 100%;\line
  height: 100%;\line
  display: block;\line
  object-fit: cover;\line
  border: 2px solid #1a1a1e;\line
  border-radius: 50%;\line
\}\line
\line
.status-avatar-fallback \{\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  background: #2563EB;\line
  color: #fff;\line
  font-size: 15px;\line
  font-weight: 700;\line
\}\line
\line
.status-add \{\line
  position: absolute;\line
  right: -1px;\line
  bottom: -1px;\line
  width: 20px;\line
  height: 20px;\line
  display: grid;\line
  place-items: center;\line
  color: #fff;\line
  background: #2563EB;\line
  border: 2px solid #1a1a1e;\line
  border-radius: 50%;\line
  font-size: 13px;\line
  font-weight: 700;\line
\}\line
\line
.status-name \{\line
  width: 100%;\line
  overflow: hidden;\line
  color: #e4e4e7;\line
  font-size: 11px;\line
  text-align: center;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
/* --- Full-screen viewer / composer --- */\line
.status-viewer \{\line
  position: fixed;\line
  inset: 0;\line
  background: rgba(0, 0, 0, 0.85);\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  z-index: 200;\line
\}\line
\line
.status-viewer-content \{\line
  position: relative;\line
  width: min(92vw, 380px);\line
  height: min(85vh, 680px);\line
  border-radius: 16px;\line
  overflow: hidden;\line
  background: #111;\line
\}\line
\line
.status-viewer-bars \{\line
  position: absolute;\line
  top: 10px;\line
  left: 10px;\line
  right: 10px;\line
  display: flex;\line
  gap: 4px;\line
  z-index: 5;\line
\}\line
\line
.status-bar-segment \{\line
  flex: 1;\line
  height: 3px;\line
  border-radius: 999px;\line
  background: rgba(255, 255, 255, 0.3);\line
\}\line
\line
.status-bar-segment.filled \{\line
  background: #fff;\line
\}\line
\line
.status-viewer-slide \{\line
  width: 100%;\line
  height: 100%;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  position: relative;\line
  padding: 24px;\line
\}\line
\line
.status-viewer-image \{\line
  max-width: 100%;\line
  max-height: 100%;\line
  object-fit: contain;\line
\}\line
\line
.status-viewer-text \{\line
  color: #fff;\line
  font-size: 22px;\line
  font-weight: 700;\line
  text-align: center;\line
  line-height: 1.4;\line
\}\line
\line
.status-composer-input \{\line
  width: 100%;\line
  background: transparent;\line
  border: none;\line
  outline: none;\line
  color: #fff;\line
  font-size: 20px;\line
  font-weight: 600;\line
  text-align: center;\line
  resize: none;\line
  font-family: inherit;\line
\}\line
\line
.status-composer-input::placeholder \{\line
  color: rgba(255, 255, 255, 0.7);\line
\}\line
\line
.status-nav \{\line
  position: absolute;\line
  top: 50%;\line
  transform: translateY(-50%);\line
  background: rgba(0, 0, 0, 0.3);\line
  color: #fff;\line
  border: none;\line
  width: 32px;\line
  height: 32px;\line
  border-radius: 50%;\line
  font-size: 18px;\line
  cursor: pointer;\line
  z-index: 5;\line
\}\line
\line
.status-nav.left \{ left: 8px; \}\line
.status-nav.right \{ right: 8px; \}\line
\line
.status-close \{\line
  position: absolute;\line
  top: 12px;\line
  right: 12px;\line
  background: rgba(0, 0, 0, 0.4);\line
  color: #fff;\line
  border: none;\line
  width: 28px;\line
  height: 28px;\line
  border-radius: 50%;\line
  cursor: pointer;\line
  z-index: 6;\line
\}\line
\line
.status-composer-controls \{\line
  position: absolute;\line
  bottom: 16px;\line
  left: 16px;\line
  display: flex;\line
  gap: 8px;\line
  z-index: 5;\line
\}\line
\line
.status-color-dot \{\line
  width: 24px;\line
  height: 24px;\line
  border-radius: 50%;\line
  border: 2px solid transparent;\line
  cursor: pointer;\line
\}\line
\line
.status-color-dot.selected \{\line
  border-color: #fff;\line
\}\line
\line
.status-color-dot.image-pick \{\line
  background: #27272A;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  font-size: 12px;\line
\}\line
\line
.status-send \{\line
  position: absolute;\line
  bottom: 16px;\line
  right: 16px;\line
  background: #2563EB;\line
  color: #fff;\line
  border: none;\line
  width: 40px;\line
  height: 40px;\line
  border-radius: 50%;\line
  font-size: 16px;\line
  cursor: pointer;\line
  z-index: 5;\line
\}\line
\line
.status-item:focus-visible \{\line
  outline: 2px solid #528cf5;\line
  outline-offset: 3px;\line
  border-radius: 8px;\line
\}\line
\line
.status-add \{\line
  padding: 0;\line
  cursor: pointer;\line
\}\line
\line
.status-viewer-header \{\line
  position: absolute;\line
  top: 22px;\line
  left: 16px;\line
  right: 50px;\line
  z-index: 6;\line
  display: flex;\line
  align-items: center;\line
  gap: 10px;\line
  color: #fff;\line
  text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);\line
  pointer-events: none;\line
\}\line
\line
.status-viewer-header > img,\line
.status-viewer-avatar-fallback \{\line
  width: 38px;\line
  height: 38px;\line
  flex: 0 0 38px;\line
  display: grid;\line
  place-items: center;\line
  object-fit: cover;\line
  border: 2px solid rgba(255, 255, 255, 0.9);\line
  border-radius: 50%;\line
\}\line
\line
.status-viewer-avatar-fallback \{\line
  background: #2563eb;\line
  font-size: 12px;\line
  font-weight: 700;\line
\}\line
\line
.status-viewer-header > div \{\line
  min-width: 0;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 3px;\line
\}\line
\line
.status-viewer-header strong \{\line
  overflow: hidden;\line
  font-size: 13px;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.status-viewer-header > div > span \{\line
  font-size: 10px;\line
  opacity: 0.82;\line
\}\line
\line
.status-reply-form \{\line
  position: absolute;\line
  right: 14px;\line
  bottom: max(14px, env(safe-area-inset-bottom));\line
  left: 14px;\line
  z-index: 7;\line
  display: flex;\line
  align-items: center;\line
  gap: 8px;\line
  padding: 5px;\line
  background: rgba(15, 17, 22, 0.72);\line
  border: 1px solid rgba(255, 255, 255, 0.52);\line
  border-radius: 999px;\line
  backdrop-filter: blur(10px);\line
\}\line
\line
.status-reply-form input \{\line
  min-width: 0;\line
  flex: 1;\line
  padding: 8px 10px;\line
  color: #fff;\line
  background: transparent;\line
  border: 0;\line
  outline: 0;\line
  font: inherit;\line
  font-size: 13px;\line
\}\line
\line
.status-reply-form input::placeholder \{\line
  color: rgba(255, 255, 255, 0.72);\line
\}\line
\line
.status-reply-form button \{\line
  min-width: 54px;\line
  padding: 9px 13px;\line
  color: #fff;\line
  background: #2563eb;\line
  border: 0;\line
  border-radius: 999px;\line
  font: inherit;\line
  font-size: 12px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.status-reply-form button:disabled \{\line
  opacity: 0.6;\line
  cursor: not-allowed;\line
\}\line
\line
.status-delete \{\line
  position: absolute;\line
  bottom: max(18px, env(safe-area-inset-bottom));\line
  left: 16px;\line
  z-index: 7;\line
  padding: 10px 14px;\line
  color: #fff;\line
  background: rgba(180, 35, 58, 0.92);\line
  border: 0;\line
  border-radius: 999px;\line
  font: inherit;\line
  font-size: 12px;\line
  font-weight: 700;\line
  cursor: pointer;\line
\}\line
\line
.status-feedback \{\line
  position: absolute;\line
  right: 16px;\line
  bottom: 70px;\line
  left: 16px;\line
  z-index: 7;\line
  margin: 0;\line
  padding: 9px 12px;\line
  color: #fff;\line
  background: rgba(15, 17, 22, 0.78);\line
  border-radius: 8px;\line
  font-size: 12px;\line
  text-align: center;\line
\}\line
\line
.status-feedback-error \{\line
  color: #ffd8de;\line
  background: rgba(145, 25, 47, 0.92);\line
\}\line
\line
@media (max-width: 520px) \{\line
  .status-viewer-content \{\line
    width: 100vw;\line
    height: 100dvh;\line
    max-height: none;\line
    border-radius: 0;\line
  \}\line
\}}\par\par
\b src/css/Inboxpage.css\b0\par
{\f1\fs15\cf2 .inbox-page \{\line
  max-width: 640px;\line
  width: 100%;\line
  margin: 0 auto;\line
  padding: 24px;\line
  box-sizing: border-box;\line
\}\line
\line
.inbox-title \{\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 24px;\line
  font-weight: 700;\line
  color: var(--ink);\line
  margin: 0 0 20px;\line
\}\line
\line
.inbox-search \{\line
  display: flex;\line
  align-items: center;\line
  gap: 10px;\line
  background: #18181B;\line
  border: 1px solid var(--border-subtle);\line
  border-radius: 999px;\line
  padding: 10px 16px;\line
  margin-bottom: 18px;\line
\}\line
\line
.inbox-search input \{\line
  border: none;\line
  outline: none;\line
  background: transparent;\line
  font-size: 14px;\line
  color: var(--ink);\line
  font-family: "Inter", sans-serif;\line
  flex: 1;\line
\}\line
\line
.inbox-search input::placeholder \{\line
  color: #9AA6BD;\line
\}\line
\line
.inbox-error \{\line
  color: #E0526B;\line
  font-size: 13px;\line
  margin-bottom: 12px;\line
\}\line
\line
.inbox-empty \{\line
  color: var(--gray-neutral);\line
  font-size: 14px;\line
  text-align: center;\line
  padding: 40px 0;\line
\}\line
\line
.inbox-list \{\line
  list-style: none;\line
  padding: 0;\line
  margin: 0;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 8px;\line
\}\line
\line
.inbox-row \{\line
  width: 100%;\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  background: #18181B;\line
  border: 1px solid var(--border-subtle);\line
  border-radius: 14px;\line
  padding: 12px 14px;\line
  cursor: pointer;\line
  text-align: left;\line
  transition: border-color 0.15s ease, transform 0.1s ease;\line
\}\line
\line
.inbox-row-main \{\line
  min-width: 0;\line
  flex: 1;\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  padding: 0;\line
  color: inherit;\line
  background: transparent;\line
  border: 0;\line
  text-align: left;\line
  cursor: pointer;\line
\}\line
\line
.inbox-row:hover \{\line
  border-color: var(--blue-primary);\line
  transform: translateY(-1px);\line
\}\line
\line
.inbox-row-unread \{\line
  border-color: rgba(59, 130, 246, 0.55);\line
\}\line
\line
.inbox-row-preview.inbox-row-preview-unread \{\line
  color: #60a5fa;\line
  font-weight: 700;\line
\}\line
\line
.inbox-unread-count \{\line
  min-width: 21px;\line
  height: 21px;\line
  display: inline-flex;\line
  align-items: center;\line
  justify-content: center;\line
  padding: 0 5px;\line
  color: #fff;\line
  background: var(--blue-primary);\line
  border-radius: 999px;\line
  font-size: 10px;\line
  font-weight: 700;\line
\}\line
\line
.inbox-avatar \{\line
  width: 42px;\line
  height: 42px;\line
  min-width: 42px;\line
  border-radius: 50%;\line
  background: var(--blue-light);\line
  color: var(--blue-deep);\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  font-size: 14px;\line
  font-weight: 700;\line
  font-family: "Space Grotesk", sans-serif;\line
\}\line
\line
.inbox-row-content \{\line
  flex: 1;\line
  min-width: 0;\line
\}\line
\line
.inbox-row-name \{\line
  font-size: 14px;\line
  font-weight: 600;\line
  color: var(--ink);\line
\}\line
\line
.inbox-row-preview \{\line
  font-size: 12.5px;\line
  color: var(--gray-neutral);\line
  white-space: nowrap;\line
  overflow: hidden;\line
  text-overflow: ellipsis;\line
\}\line
\line
.inbox-row-time \{\line
  font-size: 11px;\line
  color: #9AA6BD;\line
  white-space: nowrap;\line
\}\line
\line
/* --- Responsive --- */\line
@media (max-width: 640px) \{\line
  .inbox-page \{\line
    padding: 16px;\line
  \}\line
\line
  .inbox-title \{\line
    font-size: 20px;\line
  \}\line
\line
  .inbox-row \{\line
    padding: 10px 12px;\line
  \}\line
\line
  .inbox-avatar \{\line
    width: 38px;\line
    height: 38px;\line
    min-width: 38px;\line
  \}\line
\}\line
\line
.avatar-img \{\line
  object-fit: cover;\line
\}}\par\par
\b src/css/Layout.css\b0\par
{\f1\fs15\cf2 @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap");\line
\line
:root \{\line
  --blue-primary: #2563EB;\line
  --blue-deep: #1D4ED8;\line
  --blue-light: #DBEAFE;\line
  --blue-pale: #EFF6FF;\line
  --ink: #F3F4F6;\line
  --gray-neutral: #9CA3AF;\line
  --border-subtle: #27272A;\line
  --bg-page: #0A0A0A;\line
\}\line
\line
* \{\line
  box-sizing: border-box;\line
\}\line
\line
html, body \{\line
  margin: 0;\line
  padding: 0;\line
\}\line
\line
.app-layout \{\line
  min-height: 100vh;\line
  background: #0A0A0A;\line
  font-family: "Inter", sans-serif;\line
  color: var(--ink);\line
\}\line
\line
/* --- Sidebar (desktop) --- */\line
.app-sidebar \{\line
  width: 240px;\line
  background: #18181B;\line
  border-right: 1px solid var(--border-subtle);\line
  display: flex;\line
  flex-direction: column;\line
  padding: 20px 16px;\line
  position: fixed;\line
  top: 0;\line
  left: 0;\line
  bottom: 0;\line
\}\line
\line
.sidebar-brand \{\line
  display: flex;\line
  align-items: center;\line
  gap: 10px;\line
  padding: 0 8px;\line
  margin-bottom: 28px;\line
\}\line
\line
.sidebar-brand-icon \{\line
  width: 32px;\line
  height: 32px;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  background: var(--blue-primary);\line
  border-radius: 9px;\line
  font-size: 16px;\line
\}\line
\line
.sidebar-brand-name \{\line
  font-family: "Space Grotesk", sans-serif;\line
  font-weight: 700;\line
  font-size: 17px;\line
  color: var(--ink);\line
\}\line
\line
.sidebar-nav \{\line
  display: flex;\line
  flex-direction: column;\line
  gap: 4px;\line
  flex: 1;\line
\}\line
\line
.sidebar-nav-item \{\line
  display: flex;\line
  flex-direction: column;\line
  gap: 3px;\line
\}\line
\line
.sidebar-link \{\line
\tab position: relative;\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  padding: 11px 12px;\line
  border-radius: 10px;\line
  color: var(--gray-neutral);\line
  text-decoration: none;\line
  font-size: 14px;\line
  font-weight: 500;\line
  transition: background 0.15s ease, color 0.15s ease;\line
\}\line
\line
.nav-badge,\line
.tabbar-badge \{\line
  display: inline-flex;\line
  align-items: center;\line
  justify-content: center;\line
  color: #fff;\line
  background: #e54862;\line
  border-radius: 999px;\line
  font-size: 10px;\line
  font-weight: 700;\line
  line-height: 1;\line
\}\line
\line
.nav-badge \{\line
  min-width: 19px;\line
  height: 19px;\line
  margin-left: auto;\line
  padding: 0 5px;\line
\}\line
\line
.sidebar-link:hover \{\line
  background: rgba(37, 99, 235, 0.15);\line
  color: var(--ink);\line
\}\line
\line
.sidebar-link.active \{\line
  background: var(--blue-primary);\line
  color: #ffffff;\line
\}\line
\line
.sidebar-sub-link \{\line
  width: 38px;\line
  height: 38px;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  margin-left: 21px;\line
  padding: 8px;\line
  color: var(--gray-neutral);\line
  border-radius: 10px;\line
  text-decoration: none;\line
  transition: color 0.15s ease, background 0.15s ease;\line
\}\line
\line
.sidebar-sub-link:hover,\line
.sidebar-sub-link.active \{\line
  color: var(--theme-text, var(--ink));\line
  background: var(--theme-surface-raised, rgba(128, 128, 128, 0.1));\line
\}\line
\line
.sidebar-sub-link-icon \{\line
  width: 20px;\line
  height: 20px;\line
  stroke: currentColor;\line
  stroke-width: 1.8;\line
  stroke-linecap: round;\line
  stroke-linejoin: round;\line
\}\line
\line
.sidebar-sub-link:hover .sidebar-sub-link-icon,\line
.sidebar-sub-link.active .sidebar-sub-link-icon \{\line
  color: var(--theme-primary, #528cf5);\line
\}\line
\line
.sidebar-footer \{\line
  border-top: 1px solid var(--border-subtle);\line
  padding-top: 14px;\line
  margin-top: 14px;\line
\}\line
\line
.sidebar-user \{\line
  display: flex;\line
  align-items: center;\line
  gap: 10px;\line
  font-size: 13px;\line
  font-weight: 600;\line
  color: var(--ink);\line
  padding: 8px 12px;\line
  margin-bottom: 4px;\line
  border-radius: 9px;\line
  text-decoration: none;\line
  transition: background 0.15s ease;\line
\}\line
\line
.sidebar-user:hover \{\line
  background: rgba(255, 255, 255, 0.07);\line
\}\line
\line
.sidebar-user-avatar \{\line
  width: 32px;\line
  height: 32px;\line
  flex: 0 0 32px;\line
  overflow: hidden;\line
  border-radius: 50%;\line
  background: var(--blue-primary);\line
  color: #fff;\line
  font-size: 12px;\line
\}\line
\line
.sidebar-logout \{\line
  display: flex;\line
  align-items: center;\line
  gap: 12px;\line
  width: 100%;\line
  background: transparent;\line
  border: none;\line
  color: var(--gray-neutral);\line
  font-size: 14px;\line
  font-weight: 500;\line
  padding: 11px 12px;\line
  border-radius: 10px;\line
  cursor: pointer;\line
\}\line
\line
.sidebar-logout:hover \{\line
  background: rgba(220, 38, 38, 0.15);\line
  color: #DC2626;\line
\}\line
\line
.app-content \{\line
  margin-left: 240px;\line
  min-height: 100vh;\line
  display: flex;\line
  flex-direction: column;\line
\}\line
\line
/* --- Mobile bottom tab bar (hidden on desktop) --- */\line
.mobile-tabbar \{\line
  display: none;\line
\}\line
\line
.mobile-app-header \{\line
  display: none;\line
\}\line
\line
/* --- Responsive --- */\line
@media (max-width: 768px) \{\line
  :root \{\line
    --mobile-header-height: 58px;\line
  \}\line
\line
  .app-sidebar \{\line
    display: none;\line
  \}\line
\line
  .app-content \{\line
    margin-left: 0;\line
    padding-bottom: 64px; /* room for the fixed tab bar */\line
  \}\line
\line
  .app-content.chat-layout-content \{\line
    height: 100dvh;\line
    min-height: 0;\line
    overflow: hidden;\line
  \}\line
\line
  .mobile-app-header \{\line
    position: sticky;\line
    top: 0;\line
    z-index: 45;\line
    min-height: var(--mobile-header-height);\line
    display: flex;\line
    align-items: center;\line
    gap: 11px;\line
    padding: 0 16px;\line
    background: var(--theme-surface);\line
    border-bottom: 1px solid var(--theme-border);\line
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\line
  \}\line
\line
  .mobile-app-header-brand \{\line
    width: 34px;\line
    height: 34px;\line
    flex: 0 0 34px;\line
    display: grid;\line
    place-items: center;\line
    color: #fff;\line
    background: linear-gradient(145deg, #3985f6, #6048df);\line
    border-radius: 11px;\line
    font-family: "Space Grotesk", sans-serif;\line
    font-size: 16px;\line
    font-weight: 700;\line
  \}\line
\line
  .mobile-app-header h1 \{\line
    min-width: 0;\line
    flex: 1;\line
    overflow: hidden;\line
    margin: 0;\line
    color: var(--theme-text);\line
    font-family: "Space Grotesk", sans-serif;\line
    font-size: 17px;\line
    font-weight: 700;\line
    text-overflow: ellipsis;\line
    white-space: nowrap;\line
  \}\line
\line
  .mobile-app-header-profile \{\line
    width: 36px;\line
    height: 36px;\line
    flex: 0 0 36px;\line
    display: grid;\line
    place-items: center;\line
    overflow: hidden;\line
    border: 2px solid var(--theme-border);\line
    border-radius: 50%;\line
  \}\line
\line
  .mobile-app-header-notifications \{\line
    position: relative;\line
    width: 36px;\line
    height: 36px;\line
    flex: 0 0 36px;\line
    display: grid;\line
    place-items: center;\line
    color: var(--theme-muted);\line
    background: var(--theme-surface-raised);\line
    border: 1px solid var(--theme-border);\line
    border-radius: 50%;\line
    text-decoration: none;\line
  \}\line
\line
  .mobile-app-header-notifications:hover,\line
  .mobile-app-header-notifications:focus-visible \{\line
    color: #528cf5;\line
  \}\line
\line
  .mobile-header-badge \{\line
    position: absolute;\line
    top: -3px;\line
    right: -4px;\line
    min-width: 16px;\line
    height: 16px;\line
    display: inline-flex;\line
    align-items: center;\line
    justify-content: center;\line
    padding: 0 4px;\line
    border: 2px solid var(--theme-surface);\line
    font-size: 9px;\line
  \}\line
\line
  .mobile-app-header-avatar \{\line
    width: 100%;\line
    height: 100%;\line
    font-size: 12px;\line
  \}\line
\line
  .tabbar-profile-avatar \{\line
    width: 26px;\line
    height: 26px;\line
    overflow: hidden;\line
    border: 2px solid currentColor;\line
    border-radius: 50%;\line
    font-size: 9px;\line
  \}\line
\line
  .newchat-page > .newchat-title,\line
  .notifications-header h1,\line
  .notifications-eyebrow,\line
  .inbox-title,\line
  .chat-list-panel-header h1 \{\line
    display: none;\line
  \}\line
\line
  .mobile-tabbar \{\line
    display: flex;\line
    align-items: center;\line
    justify-content: space-around;\line
    position: fixed;\line
    bottom: 0;\line
    left: 0;\line
    right: 0;\line
    height: 60px;\line
    background: #18181B;\line
    border-top: 1px solid var(--border-subtle);\line
    z-index: 50;\line
  \}\line
\line
  .tabbar-link \{\line
    position: relative;\line
    flex: 1;\line
    min-width: 0;\line
    display: flex;\line
    align-items: center;\line
    justify-content: center;\line
    width: 44px;\line
    height: 44px;\line
    border-radius: 12px;\line
    color: var(--gray-neutral);\line
    background: transparent;\line
    border: none;\line
    cursor: pointer;\line
  \}\line
\line
  .tabbar-badge \{\line
    position: absolute;\line
    top: 0;\line
    right: calc(50% - 21px);\line
    min-width: 17px;\line
    height: 17px;\line
    padding: 0 4px;\line
    border: 2px solid #18181b;\line
  \}\line
\line
  .tabbar-link.active \{\line
    background: var(--blue-primary);\line
    color: #ffffff;\line
  \}\line
\line
  .tabbar-link.active .tabbar-profile-avatar \{\line
    border-color: #528cf5;\line
    box-shadow: 0 0 0 2px rgba(82, 140, 245, 0.25);\line
  \}\line
\}\line
\line
.app-layout \{\line
  overflow-x: hidden;\line
\}\line
\line
.app-sidebar \{\line
  width: 72px;\line
  align-items: center;\line
  padding: 16px 8px;\line
  z-index: 60;\line
\}\line
\line
.sidebar-brand \{\line
  width: 100%;\line
  justify-content: center;\line
  padding: 0;\line
  margin-bottom: 22px;\line
\}\line
\line
.sidebar-brand-name \{\line
  width: 40px;\line
  height: 40px;\line
  display: grid;\line
  place-items: center;\line
  color: #fff;\line
  background: var(--blue-primary);\line
  border-radius: 13px;\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 20px;\line
\}\line
\line
.sidebar-nav \{\line
  width: 100%;\line
  align-items: center;\line
  gap: 8px;\line
\}\line
\line
.sidebar-link \{\line
  position: relative;\line
  width: 48px;\line
  height: 48px;\line
  justify-content: center;\line
  gap: 0;\line
  padding: 0;\line
  margin: 0 auto;\line
  border-radius: 14px;\line
\}\line
\line
.sidebar-link > span:not(.nav-badge) \{\line
  display: none;\line
\}\line
\line
.sidebar-link.active \{\line
  color: #60a5fa;\line
  background: rgba(37, 99, 235, 0.18);\line
\}\line
\line
.nav-badge \{\line
  position: absolute;\line
  top: 1px;\line
  right: 1px;\line
  margin-left: 0;\line
  border: 2px solid #18181b;\line
\}\line
\line
.sidebar-footer \{\line
  width: 100%;\line
  display: flex;\line
  flex-direction: column;\line
  align-items: center;\line
\}\line
\line
.sidebar-user \{\line
  width: 48px;\line
  height: 48px;\line
  justify-content: center;\line
  gap: 0;\line
  padding: 0;\line
\}\line
\line
.sidebar-user span,\line
.sidebar-logout span \{\line
  display: none;\line
\}\line
\line
.sidebar-user-avatar \{\line
  width: 34px;\line
  height: 34px;\line
  flex-basis: 34px;\line
\}\line
\line
.sidebar-logout \{\line
  width: 48px;\line
  height: 48px;\line
  justify-content: center;\line
  gap: 0;\line
  padding: 0;\line
\}\line
\line
.app-content \{\line
  width: calc(100% - 72px);\line
  min-width: 0;\line
  margin-left: 72px;\line
\}\line
\line
@media (max-width: 768px) \{\line
  .app-content \{\line
    width: 100%;\line
    margin-left: 0;\line
  \}\line
\}}\par\par
\b src/css/Theme.css\b0\par
{\f1\fs15\cf2 :root \{\line
  color-scheme: dark;\line
  --ink: #f3f4f6;\line
  --gray-neutral: #9ca3af;\line
  --border-subtle: #303137;\line
  --bg-page: #0a0a0a;\line
  --theme-page: #0a0a0a;\line
  --theme-surface: #18181b;\line
  --theme-surface-raised: #202125;\line
  --theme-border: #303137;\line
  --theme-text: #f3f4f6;\line
  --theme-muted: #9ca3af;\line
  --theme-input: #202125;\line
\}\line
\line
html[data-theme="light"] \{\line
  color-scheme: light;\line
  --ink: #202127;\line
  --gray-neutral: #6b7280;\line
  --border-subtle: #e1e4e8;\line
  --bg-page: #f4f5f7;\line
  --theme-page: #f4f5f7;\line
  --theme-surface: #ffffff;\line
  --theme-surface-raised: #f0f1f3;\line
  --theme-border: #e1e4e8;\line
  --theme-text: #202127;\line
  --theme-muted: #6b7280;\line
  --theme-input: #f1f2f4;\line
\}\line
\line
html[data-theme="light"],\line
html[data-theme="light"] body \{\line
  background: var(--theme-page);\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .app-layout,\line
html[data-theme="light"] .app-content \{\line
  background: var(--theme-page);\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .app-sidebar,\line
html[data-theme="light"] .mobile-tabbar,\line
html[data-theme="light"] .mobile-app-header \{\line
  background: var(--theme-surface);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .sidebar-brand-name,\line
html[data-theme="light"] .sidebar-user,\line
html[data-theme="light"] .chat-header-name,\line
html[data-theme="light"] .chat-list-panel-header h1,\line
html[data-theme="light"] .chat-conversation-topline strong,\line
html[data-theme="light"] .newchat-title,\line
html[data-theme="light"] .newchat-row-name,\line
html[data-theme="light"] .inbox-title,\line
html[data-theme="light"] .inbox-row-name \{\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .sidebar-link,\line
html[data-theme="light"] .sidebar-logout,\line
html[data-theme="light"] .tabbar-link \{\line
  color: var(--theme-muted);\line
\}\line
\line
html[data-theme="light"] .sidebar-link.active,\line
html[data-theme="light"] .tabbar-link.active \{\line
  color: #2563eb;\line
  background: rgba(37, 99, 235, 0.1);\line
\}\line
\line
html[data-theme="light"] .chat-workspace,\line
html[data-theme="light"] .chat-page,\line
html[data-theme="light"] .group-chat-page,\line
html[data-theme="light"] .chat-list-panel \{\line
  color: var(--theme-text);\line
  background: var(--theme-page);\line
\}\line
\line
html[data-theme="light"] .chat-list-panel,\line
html[data-theme="light"] .chat-list-panel-header,\line
html[data-theme="light"] .chat-header,\line
html[data-theme="light"] .message-form \{\line
  background: var(--theme-surface);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .chat-list-heading > span,\line
html[data-theme="light"] .chat-header-details > span,\line
html[data-theme="light"] .chat-conversation-topline time,\line
html[data-theme="light"] .chat-conversation-preview,\line
html[data-theme="light"] .newchat-subtitle,\line
html[data-theme="light"] .inbox-row-preview,\line
html[data-theme="light"] .inbox-row-time \{\line
  color: var(--theme-muted);\line
\}\line
\line
html[data-theme="light"] .chat-list-tabs \{\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .chat-list-tabs button,\line
html[data-theme="light"] .chat-list-tabs button.active \{\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .chat-list-tabs button span \{\line
  color: #fff;\line
  background: #e54862;\line
\}\line
\line
html[data-theme="light"] .chat-search,\line
html[data-theme="light"] .message-input,\line
html[data-theme="light"] .newchat-search,\line
html[data-theme="light"] .inbox-search \{\line
  color: var(--theme-text);\line
  background: var(--theme-input);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .chat-search input,\line
html[data-theme="light"] .message-input,\line
html[data-theme="light"] .newchat-search input,\line
html[data-theme="light"] .inbox-search input \{\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .chat-search input::placeholder,\line
html[data-theme="light"] .message-input::placeholder,\line
html[data-theme="light"] .newchat-search input::placeholder,\line
html[data-theme="light"] .inbox-search input::placeholder \{\line
  color: #8a8d95;\line
\}\line
\line
html[data-theme="light"] .chat-conversation-row:hover,\line
html[data-theme="light"] .chat-conversation-row.active \{\line
  background: #e9edf5;\line
\}\line
\line
html[data-theme="light"] .chat-conversation-row \{\line
  border-color: #e9eaed;\line
\}\line
\line
html[data-theme="light"] .chat-group-avatar \{\line
  color: #1d4ed8;\line
  background: #dbeafe;\line
\}\line
\line
html[data-theme="light"] .message-theirs,\line
html[data-theme="light"] .chat-empty-icon \{\line
  color: var(--theme-text);\line
  background: var(--theme-surface);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .message-content,\line
html[data-theme="light"] .message-theirs .message-content \{\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .message-time,\line
html[data-theme="light"] .typing-indicator,\line
html[data-theme="light"] .chat-list-empty,\line
html[data-theme="light"] .chat-empty-state > span,\line
html[data-theme="light"] .chat-empty-state p \{\line
  color: var(--theme-muted);\line
\}\line
\line
html[data-theme="light"] .reply-preview \{\line
  background: #f1f4f8;\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .newchat-row,\line
html[data-theme="light"] .inbox-row \{\line
  color: var(--theme-text);\line
  background: var(--theme-surface);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .feed-page \{\line
  --feed-ink: #202127;\line
  --feed-muted: #6b7280;\line
  --feed-line: #e1e4e8;\line
  background: #f4f5f7;\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .stories-panel,\line
html[data-theme="light"] .feed-post,\line
html[data-theme="light"] .current-account,\line
html[data-theme="light"] .suggestions-panel \{\line
  background: #fff;\line
  border-color: var(--theme-border);\line
  box-shadow: 0 5px 22px rgba(25, 30, 40, 0.06);\line
\}\line
\line
html[data-theme="light"] .story-ring img \{\line
  border-color: #fff;\line
\}\line
\line
html[data-theme="light"] .story-name \{\line
  color: #3f4147;\line
\}\line
\line
html[data-theme="light"] .comment-entry \{\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .login-page \{\line
  background: var(--theme-page);\line
\}\line
\line
html[data-theme="light"] .login-card \{\line
  background: var(--theme-surface);\line
  border-color: var(--theme-border);\line
  box-shadow: 0 20px 60px -20px rgba(25, 45, 80, 0.15);\line
\}\line
\line
html[data-theme="light"] .login-title,\line
html[data-theme="light"] .login-brand-name \{\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .login-input \{\line
  color: var(--theme-text);\line
  background: var(--theme-input);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .notifications-page \{\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .notifications-list \{\line
  background: var(--theme-surface);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .notification-row \{\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .notification-row:hover \{\line
  background: var(--theme-surface-raised);\line
\}\line
\line
html[data-theme="light"] .notification-message,\line
html[data-theme="light"] .notification-message strong \{\line
  color: var(--theme-text);\line
\}\line
\line
html[data-theme="light"] .notifications-read-button \{\line
  color: var(--theme-text);\line
  background: var(--theme-surface);\line
  border-color: var(--theme-border);\line
\}\line
\line
html[data-theme="light"] .inbox-page,\line
html[data-theme="light"] .newchat-page \{\line
  color: var(--theme-text);\line
\}\line
\line
.appearance-settings \{\line
  display: flex;\line
  align-items: center;\line
  justify-content: space-between;\line
  gap: 24px;\line
  margin: 20px 0 28px;\line
  padding: 20px;\line
  color: var(--theme-text);\line
  background: var(--theme-surface);\line
  border: 1px solid var(--theme-border);\line
  border-radius: 18px;\line
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);\line
\}\line
\line
.appearance-settings h2 \{\line
  margin: 0 0 6px;\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 16px;\line
\}\line
\line
.appearance-settings p \{\line
  margin: 0;\line
  color: var(--theme-muted);\line
  font-size: 13px;\line
  line-height: 1.5;\line
\}\line
\line
.appearance-options \{\line
  display: grid;\line
  flex: 0 0 min(100%, 320px);\line
  grid-template-columns: repeat(2, minmax(0, 1fr));\line
  gap: 10px;\line
\}\line
\line
.appearance-choice \{\line
  position: relative;\line
  min-width: 0;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 10px;\line
  padding: 8px;\line
  color: var(--theme-muted);\line
  background: var(--theme-input);\line
  border: 1px solid var(--theme-border);\line
  border-radius: 13px;\line
  font: inherit;\line
  text-align: left;\line
  cursor: pointer;\line
  transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;\line
\}\line
\line
.appearance-choice:hover \{\line
  transform: translateY(-1px);\line
\}\line
\line
.appearance-choice.selected \{\line
  color: var(--theme-text);\line
  border-color: #528cf5;\line
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);\line
\}\line
\line
.appearance-preview \{\line
  height: 66px;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 5px;\line
  padding: 8px;\line
  overflow: hidden;\line
  border: 1px solid rgba(127, 137, 155, 0.22);\line
  border-radius: 8px;\line
\}\line
\line
.appearance-preview::before \{\line
  width: 31%;\line
  height: 7px;\line
  display: block;\line
  content: "";\line
  border-radius: 99px;\line
\}\line
\line
.appearance-preview i \{\line
  width: 72%;\line
  height: 5px;\line
  display: block;\line
  border-radius: 99px;\line
\}\line
\line
.appearance-preview i:nth-child(2) \{\line
  width: 49%;\line
\}\line
\line
.appearance-preview i:nth-child(3) \{\line
  width: 61%;\line
  margin-left: auto;\line
\}\line
\line
.appearance-preview-light \{\line
  background: linear-gradient(90deg, #e9edf4 0 28%, #fff 28%);\line
\}\line
\line
.appearance-preview-light::before,\line
.appearance-preview-light i \{\line
  background: #b9c5d6;\line
\}\line
\line
.appearance-preview-light i:nth-child(3) \{\line
  background: #75a7fa;\line
\}\line
\line
.appearance-preview-dark \{\line
  background: linear-gradient(90deg, #252a35 0 28%, #11151c 28%);\line
\}\line
\line
.appearance-preview-dark::before,\line
.appearance-preview-dark i \{\line
  background: #535d70;\line
\}\line
\line
.appearance-preview-dark i:nth-child(3) \{\line
  background: #528cf5;\line
\}\line
\line
.appearance-choice-label \{\line
  display: flex;\line
  align-items: center;\line
  gap: 7px;\line
  padding: 0 3px 2px;\line
  font-size: 12px;\line
  font-weight: 700;\line
\}\line
\line
.appearance-choice-icon \{\line
  color: #528cf5;\line
  font-size: 15px;\line
  line-height: 1;\line
\}\line
\line
.appearance-choice-indicator \{\line
  position: absolute;\line
  top: 13px;\line
  right: 13px;\line
  width: 16px;\line
  height: 16px;\line
  border: 1px solid rgba(127, 137, 155, 0.55);\line
  border-radius: 50%;\line
\}\line
\line
.appearance-choice.selected .appearance-choice-indicator \{\line
  border: 5px solid #528cf5;\line
  background: var(--theme-surface);\line
\}\line
\line
.appearance-choice:focus-visible \{\line
  outline: 2px solid var(--blue-primary);\line
  outline-offset: 2px;\line
\}\line
\line
@media (max-width: 520px) \{\line
  .appearance-settings \{\line
    align-items: stretch;\line
    flex-direction: column;\line
    gap: 16px;\line
    padding: 16px;\line
  \}\line
\line
  .appearance-options \{\line
    flex-basis: auto;\line
  \}\line
\}}\par\par
\b src/css/LoginPage.css\b0\par
{\f1\fs15\cf2 @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap");\line
\line
:root \{\line
  --blue-primary: #2563EB;\line
  --blue-deep: #1D4ED8;\line
  --blue-light: #DBEAFE;\line
  --blue-pale: #EFF6FF;\line
  --ink: #F3F4F6;\line
  --slate-accent: #2D608B;\line
  --gray-neutral: #9CA3AF;\line
  --border-subtle: #27272A;\line
\}\line
\line
.login-page \{\line
  min-height: 100vh;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  background: #0A0A0A;\line
  font-family: "Inter", sans-serif;\line
  padding: 24px;\line
  box-sizing: border-box;\line
\}\line
\line
.login-card \{\line
  width: 100%;\line
  max-width: 400px;\line
  background: #18181B;\line
  border: 1px solid var(--border-subtle);\line
  border-radius: 24px;\line
  padding: 40px 36px;\line
  box-sizing: border-box;\line
  box-shadow: 0 20px 60px -20px rgba(73, 170, 255, 0.25);\line
\}\line
\line
.login-brand \{\line
  display: flex;\line
  align-items: center;\line
  gap: 10px;\line
  margin-bottom: 32px;\line
\}\line
\line
.login-brand-icon \{\line
  width: 36px;\line
  height: 36px;\line
  display: flex;\line
  align-items: center;\line
  justify-content: center;\line
  background: linear-gradient(135deg, var(--blue-primary), var(--blue-deep));\line
  border-radius: 10px;\line
  font-size: 18px;\line
  box-shadow: 0 6px 16px -4px rgba(73, 170, 255, 0.5);\line
\}\line
\line
.login-brand-name \{\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 18px;\line
  font-weight: 600;\line
  color: var(--ink);\line
\}\line
\line
.login-title \{\line
  font-family: "Space Grotesk", sans-serif;\line
  font-size: 28px;\line
  font-weight: 700;\line
  color: var(--ink);\line
  margin: 0 0 6px;\line
\}\line
\line
.login-subtitle \{\line
  font-size: 14px;\line
  color: var(--gray-neutral);\line
  margin: 0 0 28px;\line
  line-height: 1.5;\line
\}\line
\line
.login-form \{\line
  display: flex;\line
  flex-direction: column;\line
\}\line
\line
.login-label \{\line
  font-size: 13px;\line
  font-weight: 500;\line
  color: #4B5568;\line
  margin-bottom: 6px;\line
  margin-top: 16px;\line
\}\line
\line
.login-label:first-of-type \{\line
  margin-top: 0;\line
\}\line
\line
.login-input \{\line
  background: var(--blue-pale);\line
  border: 1.5px solid var(--border-subtle);\line
  border-radius: 999px;\line
  padding: 13px 18px;\line
  font-size: 15px;\line
  color: var(--ink);\line
  font-family: "Inter", sans-serif;\line
  outline: none;\line
  transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;\line
\}\line
\line
.password-input-wrap \{\line
  position: relative;\line
  width: 100%;\line
\}\line
\line
.password-input-wrap .login-input \{\line
  width: 100%;\line
  padding-right: 52px;\line
\}\line
\line
.password-visibility-toggle \{\line
  position: absolute;\line
  top: 50%;\line
  right: 8px;\line
  width: 36px;\line
  height: 36px;\line
  display: grid;\line
  place-items: center;\line
  padding: 0;\line
  color: var(--gray-neutral);\line
  background: transparent;\line
  border: 0;\line
  border-radius: 50%;\line
  cursor: pointer;\line
  transform: translateY(-50%);\line
  transition: color 0.15s ease, background-color 0.15s ease;\line
\}\line
\line
.password-visibility-toggle:hover \{\line
  color: var(--blue-primary);\line
  background: rgba(37, 99, 235, 0.1);\line
\}\line
\line
.password-visibility-toggle svg \{\line
  width: 19px;\line
  height: 19px;\line
\}\line
\line
.password-visibility-toggle:focus-visible \{\line
  outline: 2px solid var(--blue-primary);\line
  outline-offset: 1px;\line
\}\line
\line
.login-input::placeholder \{\line
  color: #9AA6BD;\line
\}\line
\line
.login-input:focus \{\line
  background: #18181B;\line
  border-color: var(--blue-primary);\line
  box-shadow: 0 0 0 4px rgba(73, 170, 255, 0.15);\line
\}\line
\line
.login-error \{\line
  color: #E0526B;\line
  font-size: 13px;\line
  margin: 14px 0 0;\line
  padding-left: 4px;\line
\}\line
\line
.login-button \{\line
  margin-top: 26px;\line
  background: linear-gradient(135deg, var(--blue-primary), var(--blue-deep));\line
  color: #ffffff;\line
  font-weight: 700;\line
  font-size: 15px;\line
  border: none;\line
  border-radius: 999px;\line
  padding: 14px;\line
  cursor: pointer;\line
  box-shadow: 0 10px 24px -8px rgba(73, 170, 255, 0.55);\line
  transition: box-shadow 0.15s ease, opacity 0.15s ease, transform 0.1s ease;\line
\}\line
\line
.login-button:hover:not(:disabled) \{\line
  box-shadow: 0 12px 28px -6px rgba(73, 170, 255, 0.7);\line
  transform: translateY(-1px);\line
\}\line
\line
.login-button:active:not(:disabled) \{\line
  transform: translateY(0);\line
\}\line
\line
.login-button:disabled \{\line
  opacity: 0.6;\line
  cursor: not-allowed;\line
  box-shadow: none;\line
\}\line
\line
.login-button:focus-visible,\line
.login-input:focus-visible \{\line
  outline: 2px solid var(--blue-primary);\line
  outline-offset: 2px;\line
\}\line
\line
.login-footer \{\line
  text-align: center;\line
  font-size: 13px;\line
  color: var(--gray-neutral);\line
  margin: 24px 0 0;\line
\}\line
\line
.login-footer a \{\line
  color: var(--blue-deep);\line
  text-decoration: none;\line
  font-weight: 600;\line
\}\line
\line
.login-footer a:hover \{\line
  text-decoration: underline;\line
\}\line
\line
/* --- Responsive --- */\line
@media (max-width: 420px) \{\line
  .login-card \{\line
    padding: 32px 24px;\line
    border-radius: 18px;\line
  \}\line
\line
  .login-title \{\line
    font-size: 24px;\line
  \}\line
\}}\par\par
\b src/css/UserAvatarMenu.css\b0\par
{\f1\fs15\cf2 .user-avatar-action \{\line
  position: relative;\line
  display: inline-flex;\line
  flex: 0 0 auto;\line
  vertical-align: middle;\line
\}\line
\line
.user-avatar-action-trigger \{\line
  display: inline-flex;\line
  align-items: center;\line
  justify-content: center;\line
  padding: 0;\line
  color: inherit;\line
  background: transparent;\line
  border: 0;\line
  border-radius: 50%;\line
  cursor: pointer;\line
\}\line
\line
.user-avatar-action-trigger:focus-visible \{\line
  outline: 2px solid #528cf5;\line
  outline-offset: 3px;\line
\}\line
\line
.user-avatar-action-menu \{\line
  position: fixed;\line
  z-index: 120;\line
  width: 180px;\line
  display: flex;\line
  flex-direction: column;\line
  gap: 3px;\line
  padding: 8px;\line
  color: var(--theme-text, #f3f4f6);\line
  background: var(--theme-surface, #18181b);\line
  border: 1px solid var(--theme-border, #303137);\line
  border-radius: 12px;\line
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.3);\line
\}\line
\line
.user-avatar-action-menu > strong \{\line
  overflow: hidden;\line
  padding: 7px 9px 8px;\line
  color: var(--theme-muted, #9ca3af);\line
  font-size: 11px;\line
  font-weight: 600;\line
  text-overflow: ellipsis;\line
  white-space: nowrap;\line
\}\line
\line
.user-avatar-action-menu > button \{\line
  width: 100%;\line
  padding: 9px;\line
  color: var(--theme-text, #f3f4f6);\line
  background: transparent;\line
  border: 0;\line
  border-radius: 7px;\line
  font: inherit;\line
  font-size: 12px;\line
  text-align: left;\line
  cursor: pointer;\line
\}\line
\line
.user-avatar-action-menu > button:hover,\line
.user-avatar-action-menu > button:focus-visible \{\line
  background: var(--theme-surface-raised, #25272d);\line
  outline: none;\line
\}\line
\line
.chat-conversation-row .user-avatar-action-trigger \{\line
  align-self: center;\line
\}}\par\par
}
