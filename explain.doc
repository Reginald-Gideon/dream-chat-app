reportWebVitals();}\par\par
\b src/theme.js\b0\par
{\f1\fs15\cf2 const THEME_STORAGE_KEY = "dream-theme";\line
\line
export function getSavedTheme() \{\line
  return localStorage.getItem(THEME_STORAGE_KEY) === "light" ? "light" : "dark";\line
\}\line
\line
export function applyTheme(theme) \{\line
  const nextTheme = theme === "light" ? "light" : "dark";\line
  localStorage.setItem(THEME_STORAGE_KEY, nextTheme);\line
  document.documentElement.dataset.theme = nextTheme;\line
  window.dispatchEvent(new Event("app-theme-change"));\line
\}}\par\par
\b src/resizeImage.jsx\b0\par
{\f1\fs15\cf2 // Resizes an image file down to a small square and returns a base64 data URL.\line
// Keeping it small (e.g. 128x128) means it stores cheaply in Postgres as text.\line
export function resizeImage(file, maxSize = 128) \{\line
  return new Promise((resolve, reject) => \{\line
    const reader = new FileReader();\line
    reader.onload = (event) => \{\line
      const img = new Image();\line
      img.onload = () => \{\line
        const canvas = document.createElement("canvas");\line
        canvas.width = maxSize;\line
        canvas.height = maxSize;\line
        const ctx = canvas.getContext("2d");\line
\line
        // crop to a centered square, then scale down to maxSize x maxSize\line
        const side = Math.min(img.width, img.height);\line
        const sx = (img.width - side) / 2;\line
        const sy = (img.height - side) / 2;\line
        ctx.drawImage(img, sx, sy, side, side, 0, 0, maxSize, maxSize);\line
\line
        resolve(canvas.toDataURL("image/jpeg", 0.8)); // 0.8 = compression quality\line
      \};\line
      img.onerror = reject;\line
      img.src = event.target.result;\line
    \};\line
    reader.onerror = reject;\line
    reader.readAsDataURL(file);\line
  \});\line
\}}\par\par
\b src/attachmentUtils.js\b0\par
{\f1\fs15\cf2 export const MAX_ATTACHMENT_SIZE = 10 * 1024 * 1024;\line
\line
export function readFileAsDataUrl(file) \{\line
  return new Promise((resolve, reject) => \{\line
    const reader = new FileReader();\line
    reader.onload = () => resolve(reader.result);\line
    reader.onerror = () => reject(new Error("Could not read this file."));\line
    reader.readAsDataURL(file);\line
  \});\line
\}}\par\par
\b src/components/Avatar.jsx\b0\par
{\f1\fs15\cf2 function getInitials(name) \{\line
  return name ? name.slice(0, 2).toUpperCase() : "?";\line
\}\line
\line
// A reusable avatar: shows the user's photo if they have one, otherwise colored initials.\line
// Usage: <Avatar src=\{user.avatar\} name=\{user.username\} className="inbox-avatar" />\line
export default function Avatar(\{ src, name, className = "", style \}) \{\line
  if (src) \{\line
    return <img src=\{src\} alt=\{name\} className=\{`$\{className\} avatar-img`\} style=\{style\} />;\line
  \}\line
  return <div className=\{className\} style=\{style\}>\{getInitials(name)\}</div>;\line
\}}\par\par
\b src/components/UserAvatarMenu.jsx\b0\par
{\f1\fs15\cf2 import \{ useEffect, useRef, useState \} from "react";\line
import \{ useNavigate \} from "react-router-dom";\line
import \{ createPortal \} from "react-dom";\line
import Avatar from "./Avatar";\line
import "../css/UserAvatarMenu.css";\line
\line
export default function UserAvatarMenu(\{ userId, name, src, avatarClassName = "", children \}) \{\line
  const [open, setOpen] = useState(false);\line
  const [menuPosition, setMenuPosition] = useState(null);\line
  const wrapperRef = useRef(null);\line
  const triggerRef = useRef(null);\line
  const menuRef = useRef(null);\line
  const navigate = useNavigate();\line
\line
  useEffect(() => \{\line
    if (!open) return undefined;\line
\line
    function positionMenu() \{\line
      const trigger = triggerRef.current;\line
      if (!trigger) return;\line
      const rect = trigger.getBoundingClientRect();\line
      const menuHeight = 135;\line
      const showAbove = rect.bottom + 8 + menuHeight > window.innerHeight;\line
      setMenuPosition(\{\line
        left: Math.max(8, Math.min(rect.left, window.innerWidth - 188)),\line
        top: showAbove ? rect.top - 8 : rect.bottom + 8,\line
        transform: showAbove ? "translateY(-100%)" : "none",\line
      \});\line
    \}\line
\line
    function handlePointerDown(event) \{\line
      if (!wrapperRef.current?.contains(event.target) && !menuRef.current?.contains(event.target)) \{\line
        setOpen(false);\line
      \}\line
    \}\line
\line
    function handleKeyDown(event) \{\line
      if (event.key === "Escape") setOpen(false);\line
    \}\line
\line
    positionMenu();\line
    window.addEventListener("resize", positionMenu);\line
    document.addEventListener("scroll", positionMenu, true);\line
    document.addEventListener("pointerdown", handlePointerDown);\line
    document.addEventListener("keydown", handleKeyDown);\line
    return () => \{\line
      window.removeEventListener("resize", positionMenu);\line
      document.removeEventListener("scroll", positionMenu, true);\line
      document.removeEventListener("pointerdown", handlePointerDown);\line
      document.removeEventListener("keydown", handleKeyDown);\line
    \};\line
  \}, [open]);\line
\line
  if (userId == null) return children || <Avatar src=\{src\} name=\{name\} className=\{avatarClassName\} />;\line
\line
  function goTo(path) \{\line
    setOpen(false);\line
    navigate(path);\line
  \}\line
\line
  return (\line
    <span className="user-avatar-action" ref=\{wrapperRef\}>\line
      <button\line
        ref=\{triggerRef\}\line
        type="button"\line
        className="user-avatar-action-trigger"\line
        aria-label=\{`Options for $\{name || "user"\}`\}\line
        aria-haspopup="menu"\line
        aria-expanded=\{open\}\line
        onClick=\{(event) => \{\line
          event.stopPropagation();\line
          if (!open) \{\line
            const rect = triggerRef.current.getBoundingClientRect();\line
            const showAbove = rect.bottom + 8 + 135 > window.innerHeight;\line
            setMenuPosition(\{\line
              left: Math.max(8, Math.min(rect.left, window.innerWidth - 188)),\line
              top: showAbove ? rect.top - 8 : rect.bottom + 8,\line
              transform: showAbove ? "translateY(-100%)" : "none",\line
            \});\line
          \}\line
          setOpen((current) => !current);\line
        \}\}\line
      >\line
        \{children || <Avatar src=\{src\} name=\{name\} className=\{avatarClassName\} />\}\line
      </button>\line
      \{open && menuPosition && createPortal(\line
        <span\line
          ref=\{menuRef\}\line
          className="user-avatar-action-menu"\line
          role="menu"\line
          aria-label=\{`$\{name || "User"\} options`\}\line
          style=\{menuPosition\}\line
          onClick=\{(event) => event.stopPropagation()\}\line
        >\line
          <strong>\{name || "User"\}</strong>\line
          <button type="button" role="menuitem" onClick=\{() => goTo(`/profile/$\{userId\}`)\}>\line
            View profile\line
          </button>\line
          <button type="button" role="menuitem" onClick=\{() => goTo(`/feed?statusUser=$\{userId\}`)\}>\line
            View status\line
          </button>\line
        </span>,\line
        document.body\line
      )\}\line
    </span>\line
  );\line
\}}\par\par
\b src/components/AttachmentPicker.jsx\b0\par
{\f1\fs15\cf2 import \{ useEffect, useRef, useState \} from "react";\line
\line
export default function AttachmentPicker(\{ disabled, onSelect \}) \{\line
  const [menuOpen, setMenuOpen] = useState(false);\line
  const [documentPickerOpen, setDocumentPickerOpen] = useState(false);\line
  const containerRef = useRef(null);\line
  const cameraInputRef = useRef(null);\line
  const mediaInputRef = useRef(null);\line
  const documentInputRef = useRef(null);\line
  const audioInputRef = useRef(null);\line
\line
  useEffect(() => \{\line
    if (!menuOpen && !documentPickerOpen) return undefined;\line
\line
    function handlePointerDown(event) \{\line
      if (!containerRef.current?.contains(event.target)) \{\line
        setMenuOpen(false);\line
        setDocumentPickerOpen(false);\line
      \}\line
    \}\line
\line
    function handleKeyDown(event) \{\line
      if (event.key === "Escape") \{\line
        setMenuOpen(false);\line
        setDocumentPickerOpen(false);\line
      \}\line
    \}\line
\line
    document.addEventListener("mousedown", handlePointerDown);\line
    document.addEventListener("keydown", handleKeyDown);\line
    return () => \{\line
      document.removeEventListener("mousedown", handlePointerDown);\line
      document.removeEventListener("keydown", handleKeyDown);\line
    \};\line
  \}, [documentPickerOpen, menuOpen]);\line
\line
  function selectFile(event) \{\line
    const file = event.target.files?.[0];\line
    if (file) onSelect(file);\line
    event.target.value = "";\line
    setMenuOpen(false);\line
    setDocumentPickerOpen(false);\line
  \}\line
\line
  return (\line
    <div className="attachment-picker" ref=\{containerRef\}>\line
      <button\line
        type="button"\line
        className="attachment-picker-trigger"\line
        aria-label="Add an attachment"\line
        aria-haspopup="menu"\line
        aria-expanded=\{menuOpen\}\line
        disabled=\{disabled\}\line
        onClick=\{() => setMenuOpen((open) => !open)\}\line
      >\line
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">\line
          <path d="M12 5v14M5 12h14" />\line
        </svg>\line
      </button>\line
\line
      \{menuOpen && (\line
        <div className="attachment-picker-menu" role="menu" aria-label="Add to message">\line
          <button type="button" role="menuitem" onClick=\{() => cameraInputRef.current?.click()\}>\line
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h-4L8 7H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z" /><circle cx="12" cy="13" r="3" /></svg>\line
            Camera\line
          </button>\line
          <button type="button" role="menuitem" onClick=\{() => mediaInputRef.current?.click()\}>\line
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9" r="1.5" /><path d="m21 15-5-5L5 20" /></svg>\line
            Photo &amp; video library\line
          </button>\line
          <button type="button" role="menuitem" onClick=\{() => audioInputRef.current?.click()\}>\line
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>\line
            Audio\line
          </button>\line
          <button\line
            type="button"\line
            role="menuitem"\line
            onClick=\{() => \{\line
              setMenuOpen(false);\line
              setDocumentPickerOpen(true);\line
            \}\}\line
          >\line
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10z" /><path d="M13 3v7h7" /></svg>\line
            Document\line
          </button>\line
        </div>\line
      )\}\line
\line
      \{documentPickerOpen && (\line
        <div className="attachment-picker-backdrop" onMouseDown=\{() => setDocumentPickerOpen(false)\}>\line
          <section\line
            className="attachment-picker-sheet"\line
            role="dialog"\line
            aria-modal="true"\line
            aria-labelledby="attachment-picker-title"\line
            onMouseDown=\{(event) => event.stopPropagation()\}\line
          >\line
            <button\line
              type="button"\line
              className="attachment-picker-close"\line
              aria-label="Close document picker"\line
              onClick=\{() => setDocumentPickerOpen(false)\}\line
            >\line
              \u215?\line
            </button>\line
            <h2 id="attachment-picker-title">Choose document</h2>\line
            <p>Photos, videos, and documents are supported up to 10 MB.</p>\line
            <button type="button" onClick=\{() => documentInputRef.current?.click()\}>\line
              <span>Choose from files</span>\line
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10z" /><path d="M13 3v7h7" /></svg>\line
            </button>\line
            <button type="button" onClick=\{() => mediaInputRef.current?.click()\}>\line
              <span>Choose photo or video</span>\line
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9" r="1.5" /><path d="m21 15-5-5L5 20" /></svg>\line
            </button>\line
          </section>\line
        </div>\line
      )\}\line
\line
      <input ref=\{cameraInputRef\} className="attachment-picker-input" type="file" accept="image/*" capture="environment" onChange=\{selectFile\} />\line
      <input ref=\{mediaInputRef\} className="attachment-picker-input" type="file" accept="image/*,video/*" onChange=\{selectFile\} />\line
      <input ref=\{audioInputRef\} className="attachment-picker-input" type="file" accept="audio/*" onChange=\{selectFile\} />\line
      <input ref=\{documentInputRef\} className="attachment-picker-input" type="file" onChange=\{selectFile\} />\line
    </div>\line
  );\line
\}}\par\par
