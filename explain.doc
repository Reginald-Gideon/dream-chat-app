// Get active statuses from me + my friends, grouped by user\line
app.get('/api/statuses', authMiddleware, async (req, res) => \{\line
  try \{\line
    const result = await pool.query(\line
      `SELECT s.id, s.content, s.image_url, s.background_color, s.created_at,\line
              u.id AS user_id, u.username, u.avatar,\line
              EXISTS (\line
                SELECT 1 FROM status_views sv WHERE sv.status_id = s.id AND sv.viewer_id = $1\line
              ) AS viewed_by_me\line
       FROM statuses s\line
       JOIN users u ON s.user_id = u.id\line
       WHERE s.created_at > NOW() - INTERVAL '24 hours'\line
         AND (\line
           s.user_id = $1\line
           OR s.user_id IN (\line
             SELECT CASE WHEN requester_id = $1 THEN addressee_id ELSE requester_id END\line
             FROM friendships\line
             WHERE (requester_id = $1 OR addressee_id = $1) AND status = 'accepted'\line
           )\line
         )\line
       ORDER BY s.created_at DESC`,\line
      [req.userId]\line
    );\line
    res.json(result.rows);\line
  \} catch (err) \{\line
    console.error('Get statuses error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
