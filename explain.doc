    \}\line
\line
    await client.query('DELETE FROM status_views WHERE status_id = $1', [req.params.statusId]);\line
    await client.query('DELETE FROM statuses WHERE id = $1 AND user_id = $2', [req.params.statusId, req.userId]);\line
    await client.query('COMMIT');\line
