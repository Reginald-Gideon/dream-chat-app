{\f1\fs15\cf2 import React from 'react';\line
import ReactDOM from 'react-dom/client';\line
import './index.css';\line
import './css/Theme.css';\line
import App from './App';\line
import reportWebVitals from './reportWebVitals';\line
\line
const root = ReactDOM.createRoot(document.getElementById('root'));\line
root.render(\line
  <React.StrictMode>\line
    <App />\line
  </React.StrictMode>\line
);\line
\line
// If you want to start measuring performance in your app, pass a function\line
// to log results (for example: reportWebVitals(console.log))\line
