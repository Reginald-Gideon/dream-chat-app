// Update password \u8212? requires current password for security\line
app.patch('/api/users/password', authMiddleware, async (req, res) => \{\line
  const \{ currentPassword, newPassword \} = req.body;\line
  if (!currentPassword || !newPassword) \{\line
    return res.status(400).json(\{ message: 'Current and new password are required.' \});\line
  \}\line
  if (newPassword.length < 6) \{\line
    return res.status(400).json(\{ message: 'New password must be at least 6 characters.' \});\line
  \}\line
  try \{\line
    const result = await pool.query('SELECT password_hash FROM users WHERE id = $1', [req.userId]);\line
    const match = await bcrypt.compare(currentPassword, result.rows[0].password_hash);\line
    if (!match) \{\line
      return res.status(401).json(\{ message: 'Current password is incorrect.' \});\line
    \}\line
    const newHash = await bcrypt.hash(newPassword, 10);\line
    await pool.query('UPDATE users SET password_hash = $1 WHERE id = $2', [newHash, req.userId]);\line
    res.json(\{ message: 'Password updated.' \});\line
  \} catch (err) \{\line
    console.error('Update password error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
// Create a post\line
app.post('/api/posts', authMiddleware, async (req, res) => \{\line
  const \{ caption, imageUrl \} = req.body;\line
  try \{\line
    const result = await pool.query(\line
      `INSERT INTO posts (user_id, caption, image_url) VALUES ($1, $2, $3) RETURNING *`,\line
      [req.userId, caption || null, imageUrl || null]\line
    );\line
    res.status(201).json(result.rows[0]);\line
  \} catch (err) \{\line
    console.error('Create post error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
