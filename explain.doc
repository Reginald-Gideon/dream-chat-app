// Feed: posts from your friends and yourself, newest first, with like/comment counts\line
app.get('/api/posts', authMiddleware, async (req, res) => \{\line
  try \{\line
    const result = await pool.query(\line
      `SELECT \line
         p.id, p.caption, p.image_url, p.created_at,\line
         u.id AS user_id, u.username, u.avatar,\line
         COUNT(DISTINCT pl.user_id) AS like_count,\line
         COUNT(DISTINCT pc.id) AS comment_count,\line
         BOOL_OR(pl.user_id = $1) AS liked_by_me\line
       FROM posts p\line
       JOIN users u ON p.user_id = u.id\line
       LEFT JOIN post_likes pl ON pl.post_id = p.id\line
       LEFT JOIN post_comments pc ON pc.post_id = p.id\line
       WHERE p.user_id = $1\line
          OR p.user_id IN (\line
            SELECT CASE WHEN requester_id = $1 THEN addressee_id ELSE requester_id END\line
            FROM friendships\line
            WHERE (requester_id = $1 OR addressee_id = $1) AND status = 'accepted'\line
          )\line
       GROUP BY p.id, u.id\line
       ORDER BY p.created_at DESC`,\line
      [req.userId]\line
    );\line
    res.json(result.rows);\line
  \} catch (err) \{\line
    console.error('Get feed error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
// Like / unlike (toggle)\line
app.post('/api/posts/:postId/like', authMiddleware, async (req, res) => \{\line
  const \{ postId \} = req.params;\line
  try \{\line
    const existing = await pool.query(\line
      `SELECT * FROM post_likes WHERE post_id = $1 AND user_id = $2`,\line
      [postId, req.userId]\line
    );\line
    if (existing.rows.length > 0) \{\line
      await pool.query(`DELETE FROM post_likes WHERE post_id = $1 AND user_id = $2`, [postId, req.userId]);\line
      return res.json(\{ liked: false \});\line
    \}\line
\line
    await pool.query(`INSERT INTO post_likes (post_id, user_id) VALUES ($1, $2)`, [postId, req.userId]);\line
\line
    // find out who owns this post, so we know who to notify\line
    const postResult = await pool.query('SELECT user_id FROM posts WHERE id = $1', [postId]);\line
    const postOwnerId = postResult.rows[0]?.user_id;\line
\line
    // don't notify yourself if you like your own post\line
    if (postOwnerId && postOwnerId !== req.userId) \{\line
      const notif = await pool.query(\line
        `INSERT INTO notifications (user_id, actor_id, type, post_id)\line
         VALUES ($1, $2, 'like', $3) RETURNING *`,\line
        [postOwnerId, req.userId, postId]\line
      );\line
      // push it live, the same way we push new messages\line
      io.to(`user:$\{postOwnerId\}`).emit('newNotification', notif.rows[0]);\line
    \}\line
\line
    return res.json(\{ liked: true \});\line
  \} catch (err) \{\line
    console.error('Toggle like error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
// Add a comment\line
app.post('/api/posts/:postId/comments', authMiddleware, async (req, res) => \{\line
  const \{ postId \} = req.params;\line
  const \{ content \} = req.body;\line
  if (!content || !content.trim()) \{\line
    return res.status(400).json(\{ message: 'Comment cannot be empty.' \});\line
  \}\line
  try \{\line
    const result = await pool.query(\line
      `INSERT INTO post_comments (post_id, user_id, content) VALUES ($1, $2, $3) RETURNING *`,\line
      [postId, req.userId, content]\line
    );\line
    const userResult = await pool.query('SELECT username FROM users WHERE id = $1', [req.userId]);\line
\line
    const postResult = await pool.query('SELECT user_id FROM posts WHERE id = $1', [postId]);\line
    const postOwnerId = postResult.rows[0]?.user_id;\line
\line
    if (postOwnerId && postOwnerId !== req.userId) \{\line
      const notif = await pool.query(\line
        `INSERT INTO notifications (user_id, actor_id, type, post_id)\line
         VALUES ($1, $2, 'comment', $3) RETURNING *`,\line
        [postOwnerId, req.userId, postId]\line
      );\line
      io.to(`user:$\{postOwnerId\}`).emit('newNotification', notif.rows[0]);\line
    \}\line
\line
    res.status(201).json(\{ ...result.rows[0], username: userResult.rows[0].username \});\line
  \} catch (err) \{\line
    console.error('Add comment error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
// Get comments for a post\line
app.get('/api/posts/:postId/comments', authMiddleware, async (req, res) => \{\line
  const \{ postId \} = req.params;\line
  try \{\line
    const result = await pool.query(\line
      `SELECT pc.id, pc.content, pc.created_at, u.username\line
       FROM post_comments pc\line
       JOIN users u ON pc.user_id = u.id\line
       WHERE pc.post_id = $1\line
       ORDER BY pc.created_at ASC`,\line
      [postId]\line
    );\line
    res.json(result.rows);\line
  \} catch (err) \{\line
    console.error('Get comments error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \}\line
\});\line
\line
app.delete('/api/posts/:postId', authMiddleware, async (req, res) => \{\line
  let client;\line
  try \{\line
    client = await pool.connect();\line
    await client.query('BEGIN');\line
    const ownedPost = await client.query(\line
      'SELECT id FROM posts WHERE id = $1 AND user_id = $2 FOR UPDATE',\line
      [req.params.postId, req.userId]\line
    );\line
    if (ownedPost.rows.length === 0) \{\line
      await client.query('ROLLBACK');\line
      return res.status(404).json(\{ message: 'Post not found.' \});\line
    \}\line
\line
    await client.query('DELETE FROM post_likes WHERE post_id = $1', [req.params.postId]);\line
    await client.query('DELETE FROM post_comments WHERE post_id = $1', [req.params.postId]);\line
    await client.query('DELETE FROM notifications WHERE post_id = $1', [req.params.postId]);\line
    await client.query('DELETE FROM posts WHERE id = $1 AND user_id = $2', [req.params.postId, req.userId]);\line
    await client.query('COMMIT');\line
    res.status(200).json(\{ message: 'Post deleted.' \});\line
  \} catch (err) \{\line
    try \{\line
      if (client) await client.query('ROLLBACK');\line
    \} catch (rollbackError) \{\line
      console.error('Delete post rollback error:', rollbackError);\line
    \}\line
    console.error('Delete post error:', err);\line
    res.status(500).json(\{ message: 'Internal server error.' \});\line
  \} finally \{\line
    if (client) client.release();\line
  \}\line
\});\line
\line
